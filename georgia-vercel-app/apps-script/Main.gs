  if(!S6_hasDescriptionNotes_(extra)||S6_normal_(current).includes(S6_normal_(extra)))return current;
  if(!S6_hasDescriptionNotes_(current)||S6_normal_(extra).includes(S6_normal_(current)))return extra;
  return current+'\n\n'+extra;
