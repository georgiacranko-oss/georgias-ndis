function INV_getQueueCounts_(ss) {
  const claims = ss.getSheetByName(INV_CLAIMS_SHEET);
  if (!claims || claims.getLastRow() < 2) return {toClaimCount: 0};
  const values = claims.getRange(2, 1, claims.getLastRow() - 1, 26).getValues();
  const zone = ss.getSpreadsheetTimeZone() || INV_TIME_ZONE;
  const toClaimCount = values.filter(function(row) {
    const date = INV_matchDate_(row[0]);
    if (!date || Utilities.formatDate(date, zone, 'yyyy-MM-dd') < INV_TO_CLAIM_START_DATE) return false;
    const status = String(row[25] || row[7] || '').trim();
    return (status === 'To Be Claimed' && Number(row[6]) > 0) ||
      (row[7] === 'Needs Review' && row[24] !== true && status !== 'Paid');
  }).length;
  return {toClaimCount: toClaimCount};
}

function INV_findSupportBreakdownRow_(sheet) {
  const match = sheet
    .createTextFinder('Support Breakdown')
    .matchEntireCell(true)
    .findNext();

  if (match) return match.getRow();
  const start = INV_TO_PAY_FIRST_DATA_ROW;
  const count = Math.max(0, sheet.getLastRow() - start + 1);
  const rows = count ? sheet.getRange(start, 4, count, 5).getDisplayValues() : [];
  for (let i = 0; i < rows.length; i++) {
    if (INV_normalise_(rows[i][0]) === 'support' &&
        INV_normalise_(rows[i][2]) === 'goal' &&
        INV_normalise_(rows[i][4]) === 'risks') return start + i;
  }
  return INV_SUPPORT_BREAKDOWN_BASE_ROW;
}

function INV_prepareQueueLayout_(ss, sheet, allowInsert) {
  const counts = INV_getQueueCounts_(ss);
  let supportBreakdownRow = INV_findSupportBreakdownRow_(sheet);
  let existingExtraRows = Math.max(
    0,
    supportBreakdownRow - INV_SUPPORT_BREAKDOWN_BASE_ROW
  );

  const extraForToClaim = Math.max(
    0,
    counts.toClaimCount -
      (INV_TO_CLAIM_BASE_LAST_ROW - INV_TO_PAY_FIRST_DATA_ROW + 1)
  );

  const requiredExtraRows = extraForToClaim;

  if (allowInsert && requiredExtraRows > existingExtraRows) {
    const rowsToInsert = requiredExtraRows - existingExtraRows;
    const insertBeforeRow = INV_QUEUE_INSERT_BEFORE_ROW + existingExtraRows;

    sheet.insertRowsBefore(insertBeforeRow, rowsToInsert);
    existingExtraRows += rowsToInsert;
    supportBreakdownRow += rowsToInsert;
  }

  return {
    extraRows: existingExtraRows,
    toPayLastRow: INV_TO_PAY_BASE_LAST_ROW,
    toClaimLastRow: INV_TO_CLAIM_BASE_LAST_ROW + existingExtraRows,
    supportBreakdownRow: supportBreakdownRow
  };
}

function INV_getMergedRangesFullSheet_(sheet) {
  return sheet
    .getRange(1, 1, sheet.getMaxRows(), sheet.getMaxColumns())
    .getMergedRanges();
}

function INV_assertQueueRowsAreUnmerged_(sheet, toClaimLastRow, toPayLastRow) {
  const merges = INV_getMergedRangesFullSheet_(sheet);
  const bad = merges.filter(function(r) {
    const row1 = r.getRow();
    const row2 = r.getLastRow();
    const col1 = r.getColumn();
    const col2 = r.getLastColumn();

    const hitsToClaim =
      row2 >= 45 && row1 <= toClaimLastRow &&
      col2 >= 2 && col1 <= 9; // B:I

    const hitsToPay =
      row2 >= 45 && row1 <= toPayLastRow &&
      col2 >= 11 && col1 <= 18; // K:R

    return hitsToClaim || hitsToPay;
  });

  bad.forEach(function(r) {
    r.breakApart();
  });
}

function INV_rebuildQueueTitleMerges_(sheet) {
  const titleArea=sheet.getRange('B43:R44');
  INV_getMergedRangesFullSheet_(sheet).filter(r=>r.getRow()<=44&&r.getLastRow()>=43&&r.getColumn()<=18&&r.getLastColumn()>=2).forEach(r=>r.breakApart());
  titleArea.clearContent();
  const titleRanges=[sheet.getRange('B43:I44').merge(),sheet.getRange('K43:R44').merge()];
  titleRanges.forEach(range=>range.setBackground('#146082').setFontColor('#FFFFFF').setFontFamily('Montserrat').setFontSize(11).setFontWeight('bold').setHorizontalAlignment('center').setVerticalAlignment('middle'));
  sheet.getRange('J41:J53').clearContent();
}

function INV_resetPaidCheckboxes_(sheet, firstRow, lastRow) {
  if (lastRow < firstRow) return;

  const range = sheet.getRange(
    firstRow,
    INV_TO_PAY_PAID_COL,
    lastRow - firstRow + 1,
    1
  );

  range.clearDataValidations();
  range.clearContent();
  range.insertCheckboxes();
  range.setValue(false);
}

function INV_clearOldCheckboxContamination_(sheet, startRow) {
  const endRow = sheet.getMaxRows();
  if (startRow > endRow) return;

  const range = sheet.getRange(
    startRow,
    INV_TO_PAY_PAID_COL,
    endRow - startRow + 1,
    1
  );

  const values = range.getValues();
  const validations = range.getDataValidations();
  const merged = INV_getMergedRangesFullSheet_(sheet);

  function rowIsMergedInPaidColumn_(row) {
    return merged.some(function(r) {
      return row >= r.getRow() &&
        row <= r.getLastRow() &&
        INV_TO_PAY_PAID_COL >= r.getColumn() &&
        INV_TO_PAY_PAID_COL <= r.getLastColumn();
    });
  }

  for (let i = 0; i < validations.length; i++) {
    const row = startRow + i;
    if (rowIsMergedInPaidColumn_(row)) continue;

    const rule = validations[i][0];
    if (!rule) continue;

    if (
      rule.getCriteriaType() ===
      SpreadsheetApp.DataValidationCriteria.CHECKBOX
    ) {
      const cell = sheet.getRange(row, INV_TO_PAY_PAID_COL);
      cell.clearDataValidations();

      if (values[i][0] === true || values[i][0] === false) {
        cell.clearContent();
      }
    }
  }
}

function INV_ensureFinancialClaimViews_(ss) {
  const claims = ss.getSheetByName(INV_CLAIMS_SHEET);
  if (!claims || claims.getLastRow() < 2) return false;

  const probeRows = Math.min(5, claims.getLastRow() - 1);
  const derived = claims.getRange(2, 16, probeRows, 4).getFormulas(); // P:S
  const workflow = claims.getRange(2, 26, probeRows, 1).getFormulas(); // Z
  const broken = derived.concat(workflow).some(function(row) {
    return row.some(function(formula) {
      return /#REF!|__INVOICE_AUDIT__/i.test(String(formula || ''));
    });
  });

  if (!broken) return false;
  INV_repairAllDerivedFormulaColumns_(claims);
  return true;
}

function INV_clearBrokenPlanExpenditureFormulas_(sheet) {
  if (!sheet || sheet.getLastRow() < 1 || sheet.getLastColumn() < 1) return 0;

  const formulas = sheet
    .getRange(1, 1, sheet.getLastRow(), sheet.getLastColumn())
    .getFormulas();
  const broken = [];

  formulas.forEach(function(row, rowIndex) {
    row.forEach(function(formula, columnIndex) {
      if (/#REF!/i.test(String(formula || ''))) {
        broken.push(sheet.getRange(rowIndex + 1, columnIndex + 1).getA1Notation());
      }
    });
  });

  if (!broken.length) return 0;
  sheet.getRangeList(broken).clearContent();
  return broken.length;
}

function INV_setupCurrentInvoiceQueues_(ss) {
  INV_syncSheetAliases_(ss);
  const sheet = PROJECT_getSheetByAliases_(ss, PROJECT_PLAN_SHEET_ALIASES);

  if (!sheet) {
    throw new Error('Could not find ' + INV_OVERVIEW_SHEET + '.');
  }

  const pendingPaid = INV_capturePaidCheckboxes_(ss, sheet, INV_TO_PAY_FIRST_DATA_ROW, INV_TO_PAY_BASE_LAST_ROW);
  if (pendingPaid.count) INV_schedulePaidRetry_();
  if (pendingPaid.issues.length) ss.toast(pendingPaid.issues.join('\n'), 'Payment not recorded', 10);

  INV_removeLegacyQueueFormulas_(sheet);

  INV_rebuildQueueTitleMerges_(sheet);

  const layout = INV_prepareQueueLayout_(ss, sheet, true);

  INV_assertQueueRowsAreUnmerged_(
    sheet,
    layout.toClaimLastRow,
    layout.toPayLastRow
  );

  sheet
    .getRange('B46:I' + layout.toClaimLastRow)
    .clearContent();

  sheet
    .getRange('K46:Q' + layout.toPayLastRow)
    .clearContent();

  sheet.getRange('B45:I45').setValues([[
    'Support dates',
    '',
    'Provider',
    'ABN',
    'Support',
    'Invoice',
    'Amount',
    'Days old'
  ]]);

  sheet.getRange('K45:R45').setValues([[
    'Date',
    'Provider',
    'Invoice',
    'Amount',
    'Days old',
    'Funding',
    'Request ID',
    'Paid'
  ]]);

  INV_resetPaidCheckboxes_(
    sheet,
    INV_TO_PAY_FIRST_DATA_ROW,
    layout.toPayLastRow
  );

  INV_clearOldCheckboxContamination_(sheet, INV_TO_PAY_BASE_LAST_ROW + 1);

  INV_setInvoiceQueueFormulas_(ss, layout);

  sheet
    .getRange('B46:B' + layout.toClaimLastRow)
    .setNumberFormat('d mmm yyyy');

  sheet
    .getRange('H46:H' + layout.toClaimLastRow)
    .setNumberFormat('$#,##0.00');

  sheet
    .getRange('K46:K' + layout.toPayLastRow)
    .setNumberFormat('d mmm yyyy');

  sheet
    .getRange('N46:N' + layout.toPayLastRow)
    .setNumberFormat('$#,##0.00');

  sheet
    .getRange('O46:O' + layout.toPayLastRow)
    .setNumberFormat('0');
}

function INV_setInvoiceQueueFormulas_(ss, queueLayout) {
  INV_syncSheetAliases_(ss);
  const sheet = PROJECT_getSheetByAliases_(ss, PROJECT_PLAN_SHEET_ALIASES);

  if (!sheet) {
    throw new Error('Could not find ' + INV_OVERVIEW_SHEET + '.');
  }

  const receivedColumn=INV_columnLetters_(INV_ensureReceivedDateColumn_(ss.getSheetByName(INV_CLAIMS_SHEET)));
  const receivedRange="'Financial Claims'!$"+receivedColumn+"$2:$"+receivedColumn;

  const layout = queueLayout || INV_prepareQueueLayout_(ss, sheet, true);
  const currentPlanDate = 'DATE(2026,8,12)';

  INV_ensureFinancialClaimViews_(ss);
  INV_clearBrokenPlanExpenditureFormulas_(sheet);
  INV_removeLegacyQueueFormulas_(sheet);
  sheet.getRangeList(['J41:J53','B46:I' + layout.toClaimLastRow,'K46:Q53']).clearContent();
  sheet.getRange(layout.supportBreakdownRow - 1, 4).setValue('Estimated weekly total of Core need');

  // Include unresolved imports visibly, without treating them as verified claims.
  const review="('Financial Claims'!$H$2:$H=\"Needs Review\")*('Financial Claims'!$Y$2:$Y<>TRUE)*('Financial Claims'!$Z$2:$Z<>\"Paid\")";
  const ready="('Financial Claims'!$Z$2:$Z=\"To Be Claimed\")*('Financial Claims'!$G$2:$G>0)";
  const startDateFormula = 'DATE(' + INV_TO_CLAIM_START_DATE.split('-').map(Number).join(',') + ')';
  const datedFromJuly = "('Financial Claims'!$A$2:$A>=" + startDateFormula + ')';
  const eligible = datedFromJuly + '*((' + ready + ')+(' + review + '))';
  sheet.getRange(INV_TO_CLAIM_SUMMARY_CELL).setFormula(
    '=\"TO CLAIM  \"&IFERROR(ROWS(FILTER(\'Financial Claims\'!$F$2:$F,'+eligible+')),0)'+
    '&\"  \"&TEXT(IFERROR(SUM(FILTER(\'Financial Claims\'!$G$2:$G,'+eligible+')),0),\"$#,##0\")'
  );
  const claimsId=ss.getSheetByName(INV_CLAIMS_SHEET).getSheetId();
  sheet.getRange(INV_TO_CLAIM_FORMULA_CELL).setFormula(
    '=IFNA(SORT(FILTER({'+
    "ARRAYFORMULA(IF('Financial Claims'!$A$2:$A=\"\",\"\",'Financial Claims'!$A$2:$A)),"+
    "ARRAYFORMULA(IF('Financial Claims'!$F$2:$F=\"\",\"\",\"\")),"+
    "MAP('Financial Claims'!$E$2:$E,ROW('Financial Claims'!$E$2:$E),"+
    'LAMBDA(n,r,IF(n=\"\",\"\",HYPERLINK(\"#gid='+claimsId+'&range=A\"&r,n)))),'+
    "'Financial Claims'!$S$2:$S,"+
    "ARRAYFORMULA(IF('Financial Claims'!$P$2:$P<>\"\",'Financial Claims'!$P$2:$P,'Financial Claims'!$C$2:$C)),"+
    "MAP('Financial Claims'!$F$2:$F,'Financial Claims'!$K$2:$K,"+
    'LAMBDA(inv,url,IF(inv=\"\",\"\",'+
    'IF(REGEXMATCH(url,\"^https://drive\\.google\\.com/\"),HYPERLINK(url,inv),inv)))),'+
    "'Financial Claims'!$G$2:$G},"+eligible+'),1,FALSE),\"\")'
  );

  sheet.getRange(INV_TO_CLAIM_DAYS_CELL).setFormula(
    '=ARRAYFORMULA(IF(B46:B' + layout.toClaimLastRow + '="","",' +
    'TEXT(TODAY()-INT(B46:B' + layout.toClaimLastRow + '),"0")&" "&' +
    'IF(TODAY()-INT(B46:B' + layout.toClaimLastRow + ')=1,"day","days")))'
  );

  sheet.getRange(INV_TO_PAY_SUMMARY_CELL).setFormula(
    '="TO PAY  ·  "&COUNTIFS(\'Financial Claims\'!$Z$2:$Z,"To Be Paid",' +
    receivedRange+',">="&' + currentPlanDate + ')' +
    '&"  ·  "&TEXT(SUMIFS(\'Financial Claims\'!$V$2:$V,' +
    '\'Financial Claims\'!$Z$2:$Z,"To Be Paid",' +
    receivedRange+',">="&' + currentPlanDate + '),"$#,##0")'
  );

  const toPayData =
    "{'Financial Claims'!$T$2:$T," +
    "'Financial Claims'!$R$2:$R," +
    "'Financial Claims'!$U$2:$U," +
    "'Financial Claims'!$V$2:$V," +
    "ARRAYFORMULA(IF('Financial Claims'!$T$2:$T=\"\",\"\",TODAY()-INT('Financial Claims'!$T$2:$T)))," +
    "ARRAYFORMULA(IF('Financial Claims'!$L$2:$L<>\"\",'Financial Claims'!$L$2:$L,'Financial Claims'!$B$2:$B))," +
    "'Financial Claims'!$W$2:$W}";

  const currentToPay =
    'SORT(FILTER(' + toPayData + ',' +
    "'Financial Claims'!$Z$2:$Z=\"To Be Paid\"," +
    receivedRange+'>=' + currentPlanDate + '),1,FALSE)';

  sheet.getRange(INV_TO_PAY_FORMULA_CELL).setFormula(
    '=IFERROR(ARRAY_CONSTRAIN(' + currentToPay + ',8,7),"")'
  );

}

function INV_removeLegacyQueueFormulas_(sheet) {
  ['L7','T10','Q7','R7','R10'].forEach(function(address) {
    const cell = sheet.getRange(address);
    const formula = cell.getFormula();
    if (!/Financial Claims/i.test(formula) || !/SORT\s*\(\s*FILTER/i.test(formula) || !/To Be (?:Paid|Claimed)/i.test(formula)) return;
    const restoreCore = address === 'Q7' &&
      sheet.getRange('O7').getDisplayValue().trim() === 'Core' &&
      sheet.getRange('O10').getDisplayValue().trim() === 'Total' &&
      sheet.getRange('Q6').getDisplayValue().trim() === 'Spent';
    if (restoreCore) cell.setFormula('=Q10-SUM(Q8:Q9)');
    else cell.clearContent();
  });
}

const INV_PAID_PENDING_PREFIX = 'INV_PAID_PENDING_';
const INV_PAID_RETRY_HANDLER = 'PROCESS_PENDING_INVOICE_PAYMENTS';

function INV_paidRetryTriggers_() {
  return ScriptApp.getProjectTriggers().filter(function(trigger) {
    return trigger.getHandlerFunction() === INV_PAID_RETRY_HANDLER &&
      trigger.getEventType() === ScriptApp.EventType.CLOCK;
  });
}

function INV_schedulePaidRetry_() {
  try {
    const existing = INV_paidRetryTriggers_();
    existing.slice(1).forEach(trigger => ScriptApp.deleteTrigger(trigger));
    if (!existing.length) ScriptApp.newTrigger(INV_PAID_RETRY_HANDLER).timeBased().after(60000).create();
  } catch (error) {
    console.error('Payment retry scheduling: ' + String(error));
  }
}

function INV_capturePaidCheckboxes_(ss, sheet, firstRow, lastRow) {
  const start = Math.max(INV_TO_PAY_FIRST_DATA_ROW, firstRow);
  const end = Math.min(INV_TO_PAY_BASE_LAST_ROW, lastRow);
  if (end < start) return {count: 0, issues: []};
  const rows = sheet.getRange(start, 11, end - start + 1, 8).getValues();
  const props = PropertiesService.getScriptProperties();
  const zone = ss.getSpreadsheetTimeZone() || INV_TIME_ZONE;
  const result = {count: 0, issues: []};
  rows.forEach(function(values, offset) {
    if (values[7] !== true) return;
    const row = start + offset;
    const date = INV_matchDate_(values[0]);
    const provider = String(values[1] || '').trim();
    const invoice = String(values[2] || '').trim();
    const amount = INV_matchAmount_(values[3]);
    if (!date || !provider || !invoice || amount === null || amount <= 0) {
      sheet.getRange(row, INV_TO_PAY_PAID_COL).setValue(false);
      result.issues.push('Row ' + row + ' has no complete invoice to mark Paid.');
      return;
    }
    const payment = {
      spreadsheetId: ss.getId(), provider: provider, invoice: invoice,
      amount: amount, date: Utilities.formatDate(date, zone, 'yyyy-MM-dd'),
      requestId: INV_idKey_(values[6]), created: Date.now(), state: 'queued', attempts: 0
    };
    props.setProperty(INV_PAID_PENDING_PREFIX + Utilities.getUuid(), JSON.stringify(payment));
    sheet.getRange(row, INV_TO_PAY_PAID_COL).setValue(false);
    result.count++;
  });
  return result;
}

function INV_onOverviewPaidEdit(e) {
  if (!e || !e.range) return false;
  const sheet = e.range.getSheet();
  if (PROJECT_PLAN_SHEET_ALIASES.indexOf(sheet.getName()) === -1 ||
      e.range.getColumn() > INV_TO_PAY_PAID_COL || e.range.getLastColumn() < INV_TO_PAY_PAID_COL ||
      e.range.getLastRow() < INV_TO_PAY_FIRST_DATA_ROW || e.range.getRow() > INV_TO_PAY_BASE_LAST_ROW) return false;
  const ss = e.source || SpreadsheetApp.openById(INV_SPREADSHEET_ID);
  try {
    const captured = INV_capturePaidCheckboxes_(ss, sheet, INV_TO_PAY_FIRST_DATA_ROW, INV_TO_PAY_BASE_LAST_ROW);
    if (captured.count) INV_processPendingPayments_(ss, false);
    if (captured.issues.length) ss.toast(captured.issues.join('\n'), 'Payment not recorded', 10);
  } catch (error) {
    INV_schedulePaidRetry_();
    ss.toast('Payment could not finish yet. Saved payment instructions will retry. ' + String(error), 'Payment pending', 10);
    throw error;
  }
  return true;
}

function PROCESS_PENDING_INVOICE_PAYMENTS() {
  INV_paidRetryTriggers_().forEach(trigger => ScriptApp.deleteTrigger(trigger));
  return INV_processPendingPayments_(SpreadsheetApp.openById(INV_SPREADSHEET_ID), true);
}

function INV_processPendingPayments_(ss, includeReview) {
  const props = PropertiesService.getScriptProperties();
  function entries() {
    const saved = props.getProperties();
    return Object.keys(saved).filter(key => key.indexOf(INV_PAID_PENDING_PREFIX) === 0).map(function(key) {
      try { return {key: key, payment: JSON.parse(saved[key])}; }
      catch (error) { console.error('Invalid saved payment: ' + key); return null; }
    }).filter(item => item && item.payment.spreadsheetId === ss.getId() &&
      (includeReview || item.payment.state !== 'review'));
  }
  if (!entries().length) return 'No pending invoice payments.';
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) {
    INV_schedulePaidRetry_();
    const message = 'Payment saved. The workbook is busy, so it will retry automatically.';
    ss.toast(message, 'Payment queued', 8);
    return message;
  }
  let count = 0;
  let retry = false;
  const issues = [];
  try {
    const claims = ss.getSheetByName(INV_CLAIMS_SHEET);
    if (!claims) throw new Error('Financial Claims was not found.');
    const last = claims.getLastRow();
    const source = last > 1 ? claims.getRange(2, 1, last - 1, 26).getValues() : [];
    const zone = ss.getSpreadsheetTimeZone() || INV_TIME_ZONE;
    let rawContext;
    const normal = value => String(value || '').trim().toLowerCase();
    entries().forEach(function(entry) {
      const payment = entry.payment;
      const matches = [];
      source.forEach(function(values, index) {
        const date = INV_matchDate_(values[19] || values[0]);
        const amount = INV_matchAmount_(values[21] === '' || values[21] == null ? values[6] : values[21]);
        if (normal(values[17] || values[4]) !== normal(payment.provider) ||
            normal(values[20] || values[5]) !== normal(payment.invoice) ||
            amount === null || Math.abs(amount - payment.amount) >= 0.005 ||
            !date || Utilities.formatDate(date, zone, 'yyyy-MM-dd') !== payment.date ||
            payment.requestId && INV_idKey_(values[22]) !== payment.requestId) return;
        matches.push({row: index + 2, values: values});
      });
      const candidate = matches.length === 1 ? matches[0] : null;
      const status = candidate ? normal(candidate.values[7]) + ' ' + normal(candidate.values[25]) : '';
      if (!candidate || /cancel|reject|needs review/.test(status)) {
        payment.state = 'review';
        payment.issue = !candidate ? 'Expected one matching invoice, found ' + matches.length + '.' : 'Invoice status needs review.';
        props.setProperty(entry.key, JSON.stringify(payment));
        issues.push(payment.invoice + '. ' + payment.issue);
        return;
      }
      try {
        claims.getRange(candidate.row, INV_CLAIMS_STATUS_COL).setValue('Paid');
        claims.getRange(candidate.row, INV_CLAIMS_PAID_COL).setValue(true);
        claims.getRange(candidate.row, 26).setFormula(INV_workflowFormulaForRow_(candidate.row));
        candidate.values[7] = 'Paid';
        candidate.values[24] = true;
        candidate.values[25] = 'Paid';
        if (!rawContext) rawContext = INV_rawPaidContext_(ss);
        const rawResult = INV_markRawClaimPaid_(rawContext, candidate.values);
        if (rawResult.issue) issues.push(payment.invoice + '. ' + rawResult.issue);
        SpreadsheetApp.flush();
        props.deleteProperty(entry.key);
        count++;
      } catch (error) {
        payment.attempts = (payment.attempts || 0) + 1;
        payment.state = payment.attempts >= 3 ? 'review' : 'queued';
        payment.issue = String(error);
        props.setProperty(entry.key, JSON.stringify(payment));
        if (payment.state === 'queued') retry = true;
        issues.push(payment.invoice + '. ' + payment.issue);
      }
    });
    SpreadsheetApp.flush();
  } catch (error) {
    retry = true;
    throw error;
  } finally {
    lock.releaseLock();
    if (retry) INV_schedulePaidRetry_();
  }
  const message = count + ' invoice payment(s) saved.' + (issues.length ? '\n' + issues.join('\n') : ' Paid invoices have left To Pay.');
  ss.toast(message, issues.length ? 'Payment check' : 'Payment updated', issues.length ? 10 : 5);
  return message;
}

function INV_onFinancialPaidEdit_(e) {
  if (!e || !e.range) return;
  const sheet = e.range.getSheet();
  if (sheet.getName() !== INV_CLAIMS_SHEET) return;
  const firstColumn = e.range.getColumn();
  const lastColumn = e.range.getLastColumn();
  const statusEdited = firstColumn <= INV_CLAIMS_STATUS_COL && lastColumn >= INV_CLAIMS_STATUS_COL;
  const paidEdited = firstColumn <= INV_CLAIMS_PAID_COL && lastColumn >= INV_CLAIMS_PAID_COL;
  if (!statusEdited && !paidEdited) return;
  const firstRow = Math.max(2, e.range.getRow());
  const lastRow = Math.min(e.range.getLastRow(), sheet.getLastRow());
  if (lastRow < firstRow) return;
  const ss = e.source || SpreadsheetApp.openById(INV_SPREADSHEET_ID);
  const values = sheet.getRange(firstRow, 1, lastRow - firstRow + 1, 26).getValues();
  let context;
  let paidCount = 0;
  const issues = [];
  values.forEach(function(invoice, index) {
    if (!invoice[0]) return;
    const markedPaid = statusEdited && String(invoice[7] || '').trim().toLowerCase() === 'paid';
    const checkedPaid = paidEdited && invoice[24] === true;
    if (!markedPaid && !checkedPaid) return;
    if (!context) context = INV_rawPaidContext_(ss);
    const row = firstRow + index;
    sheet.getRange(row, INV_CLAIMS_STATUS_COL).setValue('Paid');
    sheet.getRange(row, INV_CLAIMS_PAID_COL).setValue(true);
    invoice[7] = 'Paid';
    invoice[24] = true;
    const result = INV_markRawClaimPaid_(context, invoice);
    paidCount++;
    if (result.issue) issues.push('Row ' + row + '. ' + result.issue);
  });
  if (!paidCount) return;
  SpreadsheetApp.flush();
  ss.toast(
    issues.length ? issues.join('\n') : 'Invoice payment and matching raw claim updated to Paid.',
    'Payment updated',
    issues.length ? 10 : 3
  );
}

function INV_rawPaidContext_(ss) {
  const raw = PROJECT_getSheetByAliases_(ss, PROJECT_RAW_NDIS_SHEET_ALIASES);
  return {
    sheet: raw,
    values: raw && raw.getLastRow() > 1 ? raw.getRange(2, 1, raw.getLastRow() - 1, 7).getValues() : [],
    timeZone: ss.getSpreadsheetTimeZone() || INV_TIME_ZONE
  };
}

function INV_markRawClaimPaid_(context, invoice) {
  function skip(message) { return {updated: 0, issue: 'Raw claim not updated. ' + message}; }
  if (!context.sheet) return skip('Raw NDIS Records was not found.');
  const requestId = INV_idKey_(invoice[22] || invoice[8] || invoice[13]);
  if (!/^\d+$/.test(requestId)) return skip('One matching claim number is needed.');
  const invoiceDate = INV_matchDate_(invoice[0]);
  const amount = INV_matchAmount_(invoice[6]);
  if (!invoiceDate || amount === null) return skip('Check the invoice date and amount.');
  const matches = [];
  context.values.forEach(function(row, index) {
    if (INV_idKey_(row[0]) === requestId) matches.push({values: row, row: index + 2});
  });
  if (!matches.length) return skip('Claim ' + requestId + ' was not found.');
  const invoiceKey = INV_matchKey_(invoiceDate, amount, context.timeZone);
  if (matches.some(function(match) {
    const date = INV_matchDate_(match.values[3]);
    const claimAmount = INV_matchAmount_(match.values[5]);
    return !date || claimAmount === null || INV_matchKey_(date, claimAmount, context.timeZone) !== invoiceKey;
  })) return skip('Claim ' + requestId + ' has a different date or amount.');
  if (matches.some(function(match) { return /cancel|reject/i.test(String(match.values[6] || '')); })) {
    return skip('Claim ' + requestId + ' is cancelled or rejected.');
  }
  const pending = matches.filter(function(match) { return String(match.values[6] || '').trim() !== 'Paid'; });
  if (pending.length) {
    context.sheet.getRangeList(pending.map(function(match) { return 'G' + match.row; })).setValue('Paid');
    pending.forEach(function(match) { match.values[6] = 'Paid'; });
  }
  return {updated: pending.length, issue: ''};
}

const INV_BATCH = {state: 'INV_IMPORT_BATCH_V1', weekState: 'INV_IMPORT_WEEK_BATCH_V1',
  handler: 'CONTINUE_NDIS_INVOICE_IMPORT', pageSize: 10, attachments: 8, messages: 40, budgetMs: 120000};

function INV_importContinuationTriggers_() {
  return ScriptApp.getProjectTriggers().filter(t => t.getHandlerFunction() === INV_BATCH.handler);
}
function INV_scheduleImportContinuation_(delayMs) {
  INV_importContinuationTriggers_().forEach(t => ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger(INV_BATCH.handler).timeBased().after(delayMs || 60000).create();
}
function INV_restartFreshImport_(){
  const props=PropertiesService.getScriptProperties(),key='INV_IMPORT_FRESH_BATCH_V1',now=Date.now();
  const checkpoints=[key,INV_BATCH.weekState,INV_BATCH.state].map(k=>{const value=props.getProperty(k);return value?JSON.parse(value):null;}).filter(Boolean);
  let after=Math.floor((now-168*3600000)/1000);
  if(checkpoints.length)after=Math.max(after,Math.min(...checkpoints.map(s=>s.stateKey===key&&s.after?s.after:Math.floor(s.startedAt/1000)-1)));
  props.setProperty(key,JSON.stringify({version:1,labelVersion:1,metadataRepairVersion:1,stateKey:key,hours:168,provider:0,query:0,offset:0,threads:[],thread:0,message:0,attachment:0,startedAt:now,after:after,stalls:0,scanComplete:false}));
}
function INV_loadImportState_(hours,fresh) {
  const props = PropertiesService.getScriptProperties();
  hours = hours === 168 ? 168 : 24;
  const stateKey = fresh ? 'INV_IMPORT_FRESH_BATCH_V1' : hours === 168 ? INV_BATCH.weekState : INV_BATCH.state;
  const saved = props.getProperty(stateKey);
  if (saved) {
    const state = JSON.parse(saved);
    if (state.version !== 1) throw new Error('Unsupported invoice checkpoint. The saved import needs review.');
    return state;
  }
  const startedAt = Number(props.getProperty('INV_IMPORT_REQUEST_'+hours))||Date.now();
  return {version: 1, labelVersion: 1, metadataRepairVersion: 1, stateKey: stateKey, hours: hours, provider: 0, query: 0, offset: 0, threads: [], thread: 0,
    message: 0, attachment: 0, startedAt: startedAt,
    after: Math.floor((startedAt - hours * 3600000) / 1000), stalls: 0, scanComplete: false};
}
function INV_saveImportState_(state, progressed) {
  if (progressed) state.stalls = 0;
  PropertiesService.getScriptProperties().setProperty(state.stateKey, JSON.stringify(state));
}
function CONTINUE_NDIS_INVOICE_IMPORT() {
  const props = PropertiesService.getScriptProperties();
  const fresh=props.getProperty('INV_IMPORT_FRESH_BATCH_V1');
  if(props.getProperty('INV_IMPORT_FRESH_REQUEST'))return INV_runInvoiceBatch_(168,true,true);
  if(fresh&&!JSON.parse(fresh).paused)return INV_runInvoiceBatch_(168,true);
  const daily = props.getProperty(INV_BATCH.state), weekly = props.getProperty(INV_BATCH.weekState);
  if ((daily&&!JSON.parse(daily).paused)||(!daily&&props.getProperty('INV_IMPORT_REQUEST_24')))return INV_runInvoiceBatch_(24);
  if ((weekly&&!JSON.parse(weekly).paused)||(!weekly&&props.getProperty('INV_IMPORT_REQUEST_168')))return INV_runInvoiceBatch_(168);
  return 'No invoice import is pending.';
}
function INV_hasPendingImports_() {
  const props = PropertiesService.getScriptProperties();
  if(props.getProperty('INV_IMPORT_FRESH_REQUEST'))return true;
  return ['INV_IMPORT_FRESH_BATCH_V1',INV_BATCH.state, INV_BATCH.weekState].some(function(key) {
    const saved = props.getProperty(key);
    const hours=key===INV_BATCH.weekState?168:24;
    return saved?!JSON.parse(saved).paused:!!props.getProperty('INV_IMPORT_REQUEST_'+hours);
  });
}

function IMPORT_ALL_GMAIL_INVOICES_2026(hours,fresh) {
  const started = Date.now(), state = INV_loadImportState_(hours,fresh);
  if (state.scanComplete) return {candidates: 0, imported: 0, repaired: 0, duplicates: 0, errors: 0, review: 0, pending: false};
  const ss = SpreadsheetApp.openById(INV_SPREADSHEET_ID), claims = ss.getSheetByName(INV_CLAIMS_SHEET);
  if (!claims) throw new Error('Could not find ' + INV_CLAIMS_SHEET + '.');
  INV_preserveInvoiceInHeader_(claims);
  INV_repairFinancialClaimsHeaders_(claims);
  INV_ensureReceivedDateColumn_(claims);
  INV_repairSavedInvoiceLinks_(claims);
  const log = INV_getOrCreateLog_(ss), existing = INV_getExistingInvoices_(claims);
  const result = {candidates: 0, imported: 0, repaired: 0, duplicates: 0, errors: 0, review: 0, pending: true};
  const context = {claims: claims, folder: INV_getOrCreateFolder_(), log: log, existing: existing,
    knownKeys: INV_getKnownKeys_(log, existing), unlinked: INV_getUnlinkedInvoices_(claims, false),
    rows: [], logRows: [], repairedRows: [], result: result};
  let processed = 0, messagesRead = 0, attachmentFailed = false;
  const available = () => !attachmentFailed && Date.now() - started < INV_BATCH.budgetMs &&
    processed < INV_BATCH.attachments && messagesRead < INV_BATCH.messages;
  while (available() && state.provider < INV_SENDERS.length) {
    const sender = INV_SENDERS[state.provider], queries = INV_senderQueries_(sender);
    if (state.query >= queries.length) {
      state.provider++; state.query = 0; state.offset = 0; state.threads = []; state.thread = 0;
      state.message = 0; state.attachment = 0; INV_saveImportState_(state, true); continue;
    }
    if (state.thread >= state.threads.length) {
      let query = queries[state.query];
      if (state.after) query = query.replace(/after:\S+/, 'after:' + state.after);
      query += ' before:' + Math.floor(state.startedAt / 1000);
      const page = GmailApp.search(query, state.offset, INV_BATCH.pageSize);
      state.threads = page.map(t => t.getId()); state.thread = 0; state.offset += page.length;
      state.message = 0; state.attachment = 0;
      if (!page.length) { state.query++; state.offset = 0; }
      INV_saveImportState_(state, true);
      if (!page.length) continue;
    }
    const thread = GmailApp.getThreadById(state.threads[state.thread]);
    if (!thread) { state.thread++; INV_saveImportState_(state, true); continue; }
    const messages = thread.getMessages();
    while (available() && state.message < messages.length) {
      const message = messages[state.message]; messagesRead++;
      const received = message.getDate().getTime();
      if (received >= state.startedAt || (state.after && received < state.after * 1000) ||
          !INV_isCandidateInvoiceMessage_(message, sender)) {
        state.message++; state.attachment = 0; INV_saveImportState_(state, true); continue;
      }
      const attachments = message.getAttachments({includeInlineImages: false, includeAttachments: true});
      while (available() && state.attachment < attachments.length) {
        const attachment = attachments[state.attachment];
        if (INV_isInvoiceAttachmentForSender_(attachment, sender)) {
          processed++;
          try { INV_processInvoiceAttachment_(attachment, sender, message, context); delete state.failedAttachment; state.failureCount=0; }
          catch (error) {
            result.errors++;attachmentFailed=true;
            const failedKey=message.getId()+'|'+state.attachment;
            state.failureCount=state.failedAttachment===failedKey?(state.failureCount||0)+1:1;
            state.failedAttachment=failedKey;state.paused=state.failureCount>=3;
            INV_saveImportState_(state,false);
            console.error(sender.provider + ' attachment failed, ' + attachment.getName() + ': ' + String(error));
            context.logRows.push(INV_makeLogRow_(message.getId() + '|ERROR|' + state.attachment,
              sender.provider, attachment.getName(), '', '', message.getId(), 'Import failed: ' + String(error)));
          }
          INV_flushImportLog_(log, context.logRows);
          SpreadsheetApp.flush();
        }
        if(attachmentFailed)break;
        // Commit the cursor only after the invoice and its import log are saved.
        state.attachment++; INV_saveImportState_(state, true);
      }
      if (state.attachment >= attachments.length) {
        state.message++; state.attachment = 0; INV_saveImportState_(state, true);
      }
    }
    if (state.message >= messages.length) {
      state.thread++; state.message = 0; state.attachment = 0; INV_saveImportState_(state, true);
    }
  }
  INV_flushImportLog_(log, context.logRows);
  state.scanComplete = state.provider >= INV_SENDERS.length;
  INV_saveImportState_(state, false);
  result.pending = !state.scanComplete;result.paused=!!state.paused;
  console.log('Invoice batch result: ' + JSON.stringify(result));
  return result;
}

// A saved PDF or log entry does not mean that its spreadsheet row is complete.
function INV_invoiceRowNeedsRepair_(claims, row) {
  const values = claims.getRange(row, 1, 1, 8).getValues()[0];
  const amount = INV_matchAmount_(values[6]);
  const status = String(values[7] || '').trim();
  return !INV_matchDate_(values[0]) || amount === null || amount <= 0 ||
    !status || status === 'Needs Review';
}

function INV_ensureExistingInvoiceFormulas_(claims, row) {
  const formulas = claims.getRange(row, 12, 1, 15).getFormulas()[0];
  // L:V and Z are derived. W:Y contain claim IDs, notes and payment state.
  const missing = formulas.slice(0, 11).some(formula => !formula) || !formulas[14];
  if (!missing) return false;
  INV_writeDerivedClaimFormulas_(claims, row, 1, false);
  return true;
}

function INV_repairExistingInvoiceRow_(claims, row, metadata) {
  const values = claims.getRange(row, 1, 1, 26).getValues()[0];
  const status = String(values[7] || '').trim();
  const workflow = String(values[25] || '').trim();
  let date = INV_matchDate_(values[0]);
  let amount = INV_matchAmount_(values[6]);
  const pdfDate = INV_matchDate_(metadata.date);
  const pdfAmount = INV_matchAmount_(metadata.amount);

  // Fill missing information only. Existing invoice values and claim IDs stay intact.
  if (!date && pdfDate) {
    claims.getRange(row, 1).setValue(pdfDate).setNumberFormat('d mmm yyyy');
    date = pdfDate;
  }
  if ((amount === null || amount <= 0) && pdfAmount !== null && pdfAmount > 0) {
    claims.getRange(row, 7).setValue(pdfAmount).setNumberFormat('$#,##0.00');
    amount = pdfAmount;
  }

  if (!status || status === 'Needs Review') {
    let nextStatus = 'Needs Review';
    if (values[24] === true || workflow === 'Paid') nextStatus = 'Paid';
    else if (['Cancelled', 'Rejected', 'Claimed', 'To Be Paid'].includes(workflow)) nextStatus = workflow;
    else if (date && amount !== null && amount > 0 && !metadata.needsReview) {
      nextStatus = INV_idKey_(values[22] || values[8]) ? 'To Be Paid' : 'To Be Claimed';
    }
    if (nextStatus !== status) claims.getRange(row, 8).setValue(nextStatus);
  }

  // This repair mode does not reset Paid boxes, Request IDs or manually entered notes.
  INV_ensureExistingInvoiceFormulas_(claims, row);
  SpreadsheetApp.flush();
  return {needsReview: INV_invoiceRowNeedsRepair_(claims, row)};
}

function INV_processInvoiceAttachment_(attachment, sender, message, context) {
  const {claims, folder, log, existing, knownKeys, unlinked, rows, logRows, repairedRows, result} = context;
  const subject = String(message.getSubject() || '');
  const body = String(message.getPlainBody() || '');
  const bodyAmount = INV_findAmount_(subject + '\n' + body);
            if (!INV_isInvoiceAttachmentForSender_(attachment, sender)) return;
            result.candidates++;

            const bytes = attachment.getBytes();
            const hash = INV_hash_(bytes);
            const messageKey = message.getId() + '|' + hash;

            const knownRow=knownKeys['HASHROW|' + hash];
            const knownFile=knownRow?INV_invoiceFile_(claims.getRange(knownRow,11).getDisplayValue()):null;
            if(knownFile&&INV_setOriginalInvoiceLabel_(claims,knownRow,attachment.getName(),knownFile.getUrl()))result.repaired++;
            if(knownRow && knownFile && !INV_invoiceRowNeedsRepair_(claims, knownRow)) {
              INV_recordReceivedDate_(claims,knownRow,message.getDate());
              if (INV_ensureExistingInvoiceFormulas_(claims, knownRow)) result.repaired++;
              else result.duplicates++;
              return;
            }
            if (knownRow && !knownFile && !unlinked.some(item => item.row === knownRow)) {
              const saved = claims.getRange(knownRow, 1, 1, 11).getDisplayValues()[0];
              unlinked.push({row: knownRow, date: INV_parseSheetDate_(saved[0]), provider: saved[4],
                label: saved[5], providerKey: INV_providerFamilyKey_(saved[4]),
                identity: INV_invoiceIdentity_(saved[4], saved[5], saved[5], saved[5], INV_parseSheetDate_(saved[0])),
                labelKey: INV_normalise_(saved[5]), used: false});
            }
            const originalName = INV_safeFileName_(attachment.getName());
            const metadata=INV_invoiceMetadataFromAttachment_(attachment,sender,message.getDate(),subject+'\n'+body,bodyAmount);
            const invoiceLabel=INV_importLabel_(attachment.getName());
            const identityLabel=INV_invoiceIdentityLabel_(originalName,subject,metadata,hash);
            const provider=INV_providerForMessage_(sender,subject+'\n'+body+'\n'+originalName);

            const invoiceIdentity = INV_invoiceIdentity_(
              provider,
              identityLabel,
              originalName,
              subject,
              message.getDate()
            );

            const hashRow = knownKeys['HASHROW|' + hash];
            if (!existing[invoiceIdentity] && hashRow) existing[invoiceIdentity] = hashRow;
            if (existing[invoiceIdentity]) {
              INV_recordReceivedDate_(claims, existing[invoiceIdentity], message.getDate());
            }

            const repair = INV_findUnlinkedMatch_(
              unlinked,
              sender.providerAliases || [provider],
              invoiceLabel,
              originalName,
              subject,
              message.getDate()
            );

            if (repair) {

              const providerFolder = INV_getOrCreateProviderFolder_(folder, provider);
              const file = INV_saveInvoiceFile_(folder, providerFolder, bytes, originalName, hash, knownKeys['HASHURL|' + hash]);

              const url = file.getUrl();
              const safeUrl = url.replace(/"/g, '""');
              const safeLabel = invoiceLabel.replace(/"/g, '""');

              claims.getRange(repair.row, 6).setFormula(
                '=HYPERLINK("' + safeUrl + '","' + safeLabel + '")'
              );

              claims.getRange(repair.row, 11).setValue(url);
              const otherRow = existing[invoiceIdentity];
              const alreadyAllocatedElsewhere = otherRow && otherRow !== repair.row &&
                INV_matchAmount_(claims.getRange(otherRow, 7).getValue()) > 0;
              // Repair the canonical invoice only; a spare link row must not become a second claim.
              const metadataRow = alreadyAllocatedElsewhere ? otherRow : repair.row;
              const outcome = INV_repairExistingInvoiceRow_(claims, metadataRow, metadata);
              if (outcome.needsReview) result.review++;
              repair.label = invoiceLabel;
              repair.used = true;
              existing[invoiceIdentity] = metadataRow;
              INV_recordReceivedDate_(claims, existing[invoiceIdentity], message.getDate());
              existing['FILE|' + file.getId()] = existing[invoiceIdentity];
              knownKeys['HASHROW|' + hash] = existing[invoiceIdentity];
              knownKeys['HASHURL|' + hash] = url;
              repairedRows.push(repair.row);
              result.repaired++;

              logRows.push(INV_makeLogRow_(messageKey, provider, repair.label,
                hash, url, message.getId(),
                'Repaired row ' + repair.row + ', ' + repair.label));

              knownKeys[messageKey] = true;
              knownKeys['HASH|' + hash] = true;
              INV_flushImportLog_(log, logRows);
              return;
            }

            if (
              (knownKeys[messageKey] || knownKeys['HASH|' + hash]) &&
              existing[invoiceIdentity] &&
              !INV_invoiceRowNeedsRepair_(claims, existing[invoiceIdentity])
            ) {
              if (INV_ensureExistingInvoiceFormulas_(claims, existing[invoiceIdentity])) result.repaired++;
              else result.duplicates++;
              console.log(provider + ': ' + invoiceLabel + ' already recorded at Financial Claims row ' + existing[invoiceIdentity]);
              return;
            }

            if (existing[invoiceIdentity]) {
              const recordedRow = existing[invoiceIdentity];
              let action = 'Duplicate skipped, ' + invoiceLabel;
              if (INV_invoiceRowNeedsRepair_(claims, recordedRow)) {
                const outcome = INV_repairExistingInvoiceRow_(claims, recordedRow, metadata);
                repairedRows.push(recordedRow);
                if (outcome.needsReview) {
                  result.review++;
                  action = 'Needs Review at row ' + recordedRow + ', ' + invoiceLabel;
                } else {
                  result.repaired++;
                  action = 'Repaired row ' + recordedRow + ', ' + invoiceLabel;
                }
              } else if (INV_ensureExistingInvoiceFormulas_(claims, recordedRow)) {
                result.repaired++;
                action = 'Restored formulas at row ' + recordedRow + ', ' + invoiceLabel;
              } else result.duplicates++;
              console.log(provider + ': ' + action);
              // Keep the existing row so retries cannot create another invoice.
              knownKeys[messageKey] = true;
              knownKeys['HASH|' + hash] = true;
              knownKeys['HASHROW|' + hash] = recordedRow;
              logRows.push(INV_makeLogRow_(messageKey, provider, invoiceLabel,
                hash, claims.getRange(recordedRow, 11).getDisplayValue(), message.getId(), action));
              INV_flushImportLog_(log, logRows);
              return;
            }

            const providerFolder = INV_getOrCreateProviderFolder_(folder, provider);
            const file = INV_saveInvoiceFile_(folder, providerFolder, bytes, originalName, hash, knownKeys['HASHURL|' + hash]);

            const url = file.getUrl();
            const safeUrl = url.replace(/"/g, '""');
            const safeLabel = invoiceLabel.replace(/"/g, '""');

            rows.push([
              metadata.date || '',
              sender.budget,
              sender.support,
              sender.goals,
              provider,
              '=HYPERLINK("' + safeUrl + '","' + safeLabel + '")',
              metadata.amount === null ? '' : metadata.amount,
              metadata.needsReview?'Needs Review':'To Be Claimed',
              '',
              '',
              url
            ]);

            const savedRow = INV_nextInvoiceRow_(claims);
            INV_ensureRowCapacity_(claims, savedRow);
            PROJECT_copyFinancialClaimFormatting_(claims, savedRow, 1);
            INV_applyValidation_(claims, savedRow, 1);
            claims.getRange(savedRow, 1, 1, 11).setValues([rows[rows.length - 1]]);
            INV_recordReceivedDate_(claims, savedRow, message.getDate());
            existing[invoiceIdentity] = savedRow;
            existing['FILE|' + file.getId()] = savedRow;
            knownKeys['HASHROW|' + hash] = savedRow;
            knownKeys['HASHURL|' + hash] = url;
            result.imported++;
            if(metadata.needsReview)result.review++;
            INV_applyDerivedClaimFormulas_(claims, savedRow, 1);
            SpreadsheetApp.flush();

            logRows.push(INV_makeLogRow_(messageKey, provider, invoiceLabel,
              hash, url, message.getId(), 'Imported into Financial Claims'));

            knownKeys[messageKey] = true;
            knownKeys['HASH|' + hash] = true;
            INV_flushImportLog_(log, logRows);
}

function CHECK_ALL_GMAIL_INVOICE_PROVIDERS_2026() {
  const result = {};

  INV_SENDERS.forEach(function(sender) {
    result[sender.provider] = INV_checkProviderInvoices_(sender.provider);
  });

  return result;
}

function INV_checkProviderInvoices_(providerName) {
  const sender = INV_SENDERS.filter(function(item) {
    return item.provider === providerName;
  })[0];

  if (!sender) {
    throw new Error(providerName + ' is not configured in INV_SENDERS.');
  }

  const seenMessages = {};
  const found = [];

  INV_getThreadsForSender_(sender).forEach(function(thread) {
    thread.getMessages().forEach(function(message) {
      if (!INV_isCandidateInvoiceMessage_(message, sender)) return;

      const subject = String(message.getSubject() || '');
      const messageId = message.getId();

      if (seenMessages[messageId]) return;
      seenMessages[messageId] = true;

      const pdfs = message.getAttachments({
        includeInlineImages: false,
        includeAttachments: true
      }).filter(function(attachment) {
        return INV_isInvoiceAttachmentForSender_(attachment, sender);
      });

      if (!pdfs.length) return;

      found.push({
        date: message.getDate(),
        subject: subject,
        files: pdfs.map(function(file) {
          return file.getName();
        })
      });
    });
  });

  found.sort(function(a, b) {
    return a.date - b.date;
  });

  console.log(providerName + ' invoice messages found: ' + found.length);

  found.forEach(function(item) {
    console.log(
      Utilities.formatDate(
        item.date,
        Session.getScriptTimeZone(),
        'd MMM yyyy'
      ) +
      ' | ' + item.subject +
      ' | ' + item.files.join(', ')
    );
  });

  return found.length;
}

function INV_getAllThreads_(query) {
  const all = [];
  let start = 0;
  const pageSize = 100;

  while (true) {
    const page = GmailApp.search(query, start, pageSize);
    if (!page.length) break;

    Array.prototype.push.apply(all, page);
    start += page.length;

    if (page.length < pageSize) break;
  }

  return all;
}

function INV_searchStartDate_() {
  const date=INV_parseAustralianDate_(INV_START_DATE.split('/').reverse().join('/'));
  if(!date)throw new Error('Invalid invoice start date.');
  date.setDate(date.getDate()-1);
  return Utilities.formatDate(date,INV_TIME_ZONE,'yyyy/MM/dd');
}
function INV_senderQueries_(sender) {
  const emails = [sender.email].concat(sender.searchEmails || []);
  const names = sender.searchNames || [];
  const queries = [];

  emails.forEach(function(email) {
    if (!email) return;

    queries.push(
      'after:' + INV_searchStartDate_() +
      ' from:' + email +
      ' has:attachment'
    );
  });

  names.forEach(function(name) {
    if (!name) return;

    queries.push(
      'after:' + INV_searchStartDate_() +
      ' from:"' + String(name).replace(/"/g, '') + '"' +
      ' has:attachment'
    );
  });

  (sender.searchSubjects || []).forEach(function(subject) {
    queries.push(
      'after:' + INV_searchStartDate_() +
      ' subject:"' + String(subject).replace(/"/g, '') + '"' +
      ' has:attachment'
    );
  });

  [sender.provider].concat(sender.providerAliases || []).forEach(function(name) {
    if (!name) return;
    queries.push(
      'after:' + INV_searchStartDate_() + ' "' +
      String(name).replace(/"/g, '') + '" has:attachment filename:pdf'
    );
  });

  if (sender.provider === 'Rebecca Somervaille') {
    queries.push(
      'after:' + INV_searchStartDate_() +
      ' has:attachment filename:pdf subject:invoice "Rebecca Somervaille"'
    );
  }

  return Array.from(new Set(queries));
}

function INV_getThreadsForSender_(sender) {
  const byId = {};
  INV_senderQueries_(sender).forEach(function(query) {
    INV_getAllThreads_(query).forEach(function(thread) { byId[thread.getId()] = thread; });
  });
  return Object.keys(byId).map(id => byId[id]);
}

function INV_isAllowedMessage_(message, sender) {
  const from = String(message.getFrom() || '').toLowerCase();
  const subject = String(message.getSubject() || '').toLowerCase();

  const accepted = [sender.email]
    .concat(sender.searchEmails || [])
    .concat(sender.searchNames || [])
    .map(function(value) {
      return String(value || '').toLowerCase();
    })
    .filter(Boolean);

  const fromMatches = accepted.some(function(value) {
    return from.indexOf(value) !== -1;
  });

  if (fromMatches) return true;

  const providerInSubject = [sender.provider]
    .concat(sender.providerAliases || [])
    .some(function(value) {
      return subject.indexOf(String(value || '').toLowerCase()) !== -1;
    });

  if (providerInSubject && /\b(?:invoice|inv)\b/i.test(subject)) return true;

  return (sender.searchSubjects || []).some(function(value) {
    return subject.indexOf(String(value).toLowerCase()) !== -1;
  });
}

function INV_isCandidateInvoiceMessage_(message,sender) {
  const date=message.getDate();
  const first=INV_parseAustralianDate_(INV_START_DATE.split('/').reverse().join('/'));
  if(!(date instanceof Date)||isNaN(date.getTime())||!first)return false;
  // Gmail returns whole threads, which can include messages before the search date.
  if(Utilities.formatDate(date,INV_TIME_ZONE,'yyyy-MM-dd')<Utilities.formatDate(first,INV_TIME_ZONE,'yyyy-MM-dd'))return false;
  if(!INV_isAllowedMessage_(message,sender))return false;
  const subject=String(message.getSubject()||'').trim();
  if(/\b(?:receipt|receipts|remittance)\b/i.test(subject)&&!/\b(?:invoice|inv)\b/i.test(subject))return false;
  return /\b(?:invoice|inv)\b/i.test(subject)||/\bHU-\d+\b/i.test(subject);
}

function INV_isInvoiceAttachmentForSender_(attachment, sender) {
  if (!INV_isInvoiceAttachment_(attachment)) return false;
  const name = String(attachment.getName() || '');
  if (/(?:^|[\s_-])(?:payment|receipt|remittance|statement)(?:[\s_.-]|$)/i.test(name)) return false;
  return true;
}

function INV_providerForMessage_(sender, text) {
  const value = INV_normalise_(text);
  const aliases = sender.providerAliases || [sender.provider];

  for (let index = 0; index < aliases.length; index++) {
    if (value.indexOf(INV_normalise_(aliases[index])) !== -1) {
      return aliases[index];
    }
  }

  return sender.provider;
}

function INV_isInvoiceAttachment_(attachment) {
  const name = String(attachment.getName() || '').toLowerCase();
  const type = String(attachment.getContentType() || '').toLowerCase();

  return type === 'application/pdf' || /\.pdf$/i.test(name);
}

function INV_invoiceMetadataFromAttachment_(attachment,sender,fallbackDate,messageText,bodyAmount) {
  const result={date:null,amount:null,invoiceNumber:'',needsReview:true};
  try {
    const text=INV_extractPdfText_(attachment);
    if(!text)throw new Error('The PDF returned no readable text.');
    const family=INV_providerFamilyKey_(sender&&sender.provider);
    result.date=INV_findInvoiceDateInPdf_(text,family);
    result.amount=INV_findInvoiceAmountInPdf_(text,family);
    result.invoiceNumber=INV_findInvoiceNumber_(text);
    result.needsReview=!result.date||result.amount===null||result.amount<=0;
  } catch(error) {
    console.error('PDF metadata needs review for '+attachment.getName()+': '+String(error));
  }
  // An email date or body total must not silently become a verified invoice value.
  return result;
}
function INV_findInvoiceNumber_(text) {
  const match=String(text||'').match(/\b(?:tax\s+)?invoice\s*(?:number|no\.?|#|id)\s*[:#-]?\s*([a-z0-9][a-z0-9_/-]*\d[a-z0-9_/-]*|\d+)\b/i)||
    String(text||'').match(/\b(?:HU|INV)[-_]\d{3,}\b/i);
  return match?String(match[1]||match[0]).trim():'';
}
function INV_scheduleFilenameRepair_() {
  ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='REPAIR_INVOICE_FILENAMES')
    .forEach(t=>ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('REPAIR_INVOICE_FILENAMES').timeBased().after(60000).create();
}
function INV_filenameHistory_(ss) {
  const log=ss.getSheetByName(INV_LOG_SHEET);
  if(!log||log.getLastRow()<2)return [];
  return log.getRange(2,1,log.getLastRow()-1,7).getDisplayValues().map(function(row) {
    return {label:String(row[2]||''),hash:String(row[3]||''),url:String(row[4]||''),messageId:String(row[5]||'')};
  }).filter(row=>row.hash&&row.messageId);
}
function INV_originalAttachmentFromHistory_(label, url, history) {
  const fileId=INV_driveFileIdFromUrl_(url),prefix=(String(label).match(/^Invoice PDF ([a-zA-Z0-9_-]{16})$/)||[])[1];
  const candidates=history.filter(function(entry) {
    return (fileId&&INV_driveFileIdFromUrl_(entry.url)===fileId)||(prefix&&entry.hash.slice(0,16)===prefix);
  });
  const hashes=Array.from(new Set(candidates.map(entry=>entry.hash)));
  if(hashes.length>1)throw new Error('More than one PDF hash matches this invoice. The label was kept.');
  const checked=new Set();
  for(let i=candidates.length-1;i>=0;i--) {
    const entry=candidates[i];if(checked.has(entry.messageId))continue;checked.add(entry.messageId);
    if(checked.size>3)break;
    const message=GmailApp.getMessageById(entry.messageId);if(!message)continue;
    const attachments=message.getAttachments({includeInlineImages:false,includeAttachments:true});
    for(let j=0;j<attachments.length;j++) {
      const attachment=attachments[j];if(!INV_isInvoiceAttachment_(attachment))continue;
      if(INV_hash_(attachment.getBytes())===entry.hash) {
        return {name:attachment.getName(),url:entry.url||url,source:'Original Gmail attachment'};
      }
    }
  }
  return null;
}
function INV_filenameReport_(ss, rows, reset) {
  const sheet=ss.getSheetByName('Invoice Filename Check')||ss.insertSheet('Invoice Filename Check');
  if(reset)sheet.clearContents();
  sheet.getRange(1,1,1,6).setValues([['Invoice row','Previous label','Original filename','Result','Source','Details']]);
  if(rows.length) {
    const start=Math.max(2,sheet.getLastRow()+1);INV_ensureRowCapacity_(sheet,start+rows.length-1);
    sheet.getRange(start,1,rows.length,6).setValues(rows).setWrap(true);
  }
}
function INV_repairFallbackInvoiceLabels_(ss) {
  const sheet=ss.getSheetByName(INV_CLAIMS_SHEET);
  if(!sheet)throw new Error('Financial Claims is missing.');
  INV_repairSavedInvoiceLinks_(sheet);
  const props=PropertiesService.getScriptProperties(),key='INV_FILENAME_REPAIR_ROW';
  const first=Math.max(2,Number(props.getProperty(key))||2),last=sheet.getLastRow();
  const rows=last>=first?sheet.getRange(first,6,last-first+1,6).getDisplayValues():[];
  const history=INV_filenameHistory_(ss),report=[];
  const started=Date.now();let checked=0,changed=0,unresolved=0,pending=false;
  for(let i=0;i<rows.length;i++) {
    const row=first+i,label=String(rows[i][0]||'').trim();
    if(!/^Invoice PDF [a-zA-Z0-9_-]{16}$/.test(label))continue;
    if(checked>=8||Date.now()-started>=90000){pending=true;props.setProperty(key,String(row));break;}
    checked++;
    try {
      let url=String(rows[i][5]||'').trim();
      if(!url) {
        const formula=sheet.getRange(row,6).getFormula(),link=String(formula||'').match(/^=HYPERLINK\("([^"\n]+)"/i);
        if(link)url=link[1].replace(/""/g,'"');
        if(!url) {const rich=sheet.getRange(row,6).getRichTextValue();if(rich)url=rich.getLinkUrl()||'';}
      }
      let original=null;
      try {original=INV_originalAttachmentFromHistory_(label,url,history);}
      catch(error){console.error('Gmail filename lookup at row '+row+': '+String(error));}
      if(!original) {
        const file=INV_invoiceFile_(url);
        if(file&&!/^Invoice PDF [a-zA-Z0-9_-]{16}(?:\.pdf)?$/i.test(file.getName())) {
          original={name:file.getName(),url:file.getUrl(),source:'Saved PDF filename'};
        }
      }
      if(!original||!original.name||!original.url) {
        unresolved++;report.push([row,label,'','Unresolved','', 'Could not verify the original filename and PDF link. The label was kept.']);
      } else {
        if(INV_setOriginalInvoiceLabel_(sheet,row,original.name,original.url))changed++;
        report.push([row,label,original.name,'Corrected',original.source,'']);
      }
    }catch(error){unresolved++;report.push([row,label,'','Unresolved','',String(error)]);}
    props.setProperty(key,String(row+1));
  }
  INV_filenameReport_(ss,report,first===2);
  if(pending)INV_scheduleFilenameRepair_();
  else {
    props.deleteProperty(key);
    ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='REPAIR_INVOICE_FILENAMES')
      .forEach(t=>ScriptApp.deleteTrigger(t));
  }
  return {changed:changed,unresolved:unresolved,pending:pending};
}

function REPAIR_INVOICE_FILENAMES() {
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1000)){INV_scheduleFilenameRepair_();return 'Invoice filename repair is queued.';}
  try {
    const ss=SpreadsheetApp.openById(INV_SPREADSHEET_ID),result=INV_repairFallbackInvoiceLabels_(ss);
    SpreadsheetApp.flush();INV_setupCurrentInvoiceQueues_(ss);SpreadsheetApp.flush();
    const message='Invoice filenames corrected: '+result.changed+'. Unresolved: '+result.unresolved+'.'+
      (result.pending?' More names will be corrected automatically.':'')+' See Invoice Filename Check.';
    ss.toast(message,'Invoice filenames',8);return message;
  }finally{lock.releaseLock();}
}

function INV_importLabel_(fileName) {
  return String(fileName || '').trim() || 'Invoice.pdf';
}
function INV_setOriginalInvoiceLabel_(claims, row, fileName, url) {
  const label=INV_importLabel_(fileName),cell=claims.getRange(row,6);
  const changed=cell.getDisplayValue()!==label;
  if(url) {
    claims.getRange(row,11).setValue(url);
    const formula='=HYPERLINK("'+String(url).replace(/"/g,'""')+'","'+label.replace(/"/g,'""')+'")';
    cell.setFormula(formula);
  } else cell.setValue(label);
  claims.getRange(row,21).setFormula('=IF($F'+row+'="","",IF($K'+row+'="",$F'+row+',HYPERLINK($K'+row+',$F'+row+')))');
  return changed;
}

function INV_invoiceIdentityLabel_(fileName,subject,metadata,hash) {
  if(metadata.invoiceNumber)return 'Invoice '+metadata.invoiceNumber;
  const label=INV_invoiceLabel_(fileName,subject);
  if(/^(?:invoice(?: file)?|attachment|document|scan|download)(?:[ _-]?\d*)?$/i.test(label))return 'Invoice PDF '+hash.slice(0,16);
  return label;
}
function INV_extractPdfText_(blob) {
  if (!blob) return '';

  const boundary = 'ndis_invoice_' + Utilities.getUuid().replace(/-/g, '');
  const metadata = JSON.stringify({
    name: '__NDIS_INVOICE_TEXT__ ' + new Date().getTime(),
    mimeType: 'application/vnd.google-apps.document'
  });

  const before =
    '--' + boundary + '\r\n' +
    'Content-Type: application/json; charset=UTF-8\r\n\r\n' +
    metadata + '\r\n' +
    '--' + boundary + '\r\n' +
    'Content-Type: application/pdf\r\n\r\n';

  const after = '\r\n--' + boundary + '--';
  const payload = Utilities.newBlob(before).getBytes()
    .concat(blob.getBytes())
    .concat(Utilities.newBlob(after).getBytes());

  const token = ScriptApp.getOAuthToken();
  let tempDocId = '';

  try {
    const createResponse = UrlFetchApp.fetch(
      'https://www.googleapis.com/upload/drive/v3/files' +
      '?uploadType=multipart&fields=id',
      {
        method: 'post',
        contentType: 'multipart/related; boundary=' + boundary,
        headers: {
          Authorization: 'Bearer ' + token
        },
        payload: payload,
        muteHttpExceptions: true
      }
    );

    const createCode = createResponse.getResponseCode();
    if (createCode < 200 || createCode >= 300) {
      throw new Error(
        'Drive PDF conversion failed (' + createCode + '): ' +
        createResponse.getContentText().slice(0, 500)
      );
    }

    const created = JSON.parse(createResponse.getContentText() || '{}');
    tempDocId = String(created.id || '');
    if (!tempDocId) throw new Error('Drive PDF conversion returned no file ID.');

    const exportResponse = UrlFetchApp.fetch(
      'https://www.googleapis.com/drive/v3/files/' +
      encodeURIComponent(tempDocId) +
      '/export?mimeType=' + encodeURIComponent('text/plain'),
      {
        method: 'get',
        headers: {
          Authorization: 'Bearer ' + token
        },
        muteHttpExceptions: true
      }
    );

    const exportCode = exportResponse.getResponseCode();
    if (exportCode < 200 || exportCode >= 300) {
      throw new Error(
        'Drive text export failed (' + exportCode + '): ' +
        exportResponse.getContentText().slice(0, 500)
      );
    }

    return String(exportResponse.getContentText() || '');
  } finally {
    if (tempDocId) {
      try {
        UrlFetchApp.fetch(
          'https://www.googleapis.com/drive/v3/files/' +
          encodeURIComponent(tempDocId),
          {
            method: 'delete',
            headers: {
              Authorization: 'Bearer ' + token
            },
            muteHttpExceptions: true
          }
        );
      } catch (cleanupError) {
        console.error(
          'Could not delete temporary invoice text document ' + tempDocId
        );
      }
    }
  }
}

function INV_findInvoiceDateInPdf_(text, family) {
  const value=String(text||'').replace(/\u00a0/g,' ');
  const match=value.match(/(?:invoice\s+date|date\s+(?:of\s+)?issue|date\s+issued|issued\s+(?:on|date))\s*[:#-]?\s*(\d{1,2}[\/.-]\d{1,2}[\/.-]\d{4})/i);
  if (match) return INV_parseAustralianDate_(match[1]);

  // Rebecca labels the issue date simply Date immediately after the invoice number.
  // Restrict this to that header so appointment and due dates cannot be substituted.
  if (family === 'rebecca') {
    const rebeccaHeader=value.match(/(?:^|\n)\s*Invoice\s*:\s*\d+\s+Date\s*:\s*(\d{1,2}[\/.-]\d{1,2}[\/.-]\d{4})\b/i);
    if (rebeccaHeader) return INV_parseAustralianDate_(rebeccaHeader[1]);
  }

  // Hireup places the issue date directly below Tax Invoice and its HU number,
  // without an Invoice date label. Do not use the due date or service dates.
  if (family === 'hireup') {
    const hireupHeader=value.match(/\b(?:tax\s+)?invoice\s*#?\s*HU-\d+\s+(\d{1,2}[\/.-]\d{1,2}[\/.-]\d{4})\b/i);
    if (hireupHeader) return INV_parseAustralianDate_(hireupHeader[1]);
  }
  return null;
}

function INV_findServiceDateInPdf_(text, family) {
  const value = String(text || '').replace(/\u00a0/g, ' ');
  const patterns = [];

  if (family === 'rebecca') {
    patterns.push(/Appointment\s*:\s*(\d{1,2}\/\d{1,2}\/\d{4})/i);
  }

  patterns.push(
    /(?:service\s+date|date\s+of\s+service|appointment\s+date)\s*:\s*(\d{1,2}[\/.-]\d{1,2}[\/.-]\d{4})/i,
    /(?:invoice\s+date|date)\s*:\s*(\d{1,2}[\/.-]\d{1,2}[\/.-]\d{4})/i
  );

  for (let i = 0; i < patterns.length; i++) {
    const match = value.match(patterns[i]);
    if (!match) continue;

    const parsed = INV_parseAustralianDate_(match[1]);
    if (parsed) return parsed;
  }

  return null;
}

function INV_parseAustralianDate_(value) {
  const match = String(value || '').trim().match(
    /^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})$/
  );

  if (!match) return null;

  const day = Number(match[1]);
  const month = Number(match[2]);
  const year = Number(match[3]);

  if (
    !isFinite(day) || !isFinite(month) || !isFinite(year) ||
    day < 1 || day > 31 || month < 1 || month > 12
  ) {
    return null;
  }

  const date = new Date(year, month - 1, day, 12, 0, 0, 0);

  if (
    date.getFullYear() !== year ||
    date.getMonth() !== month - 1 ||
    date.getDate() !== day
  ) {
    return null;
  }

  return date;
}

function INV_findInvoiceAmountInPdf_(text, family) {
  const value = String(text || '')
    .replace(/\u00a0/g, ' ')
    .replace(/\r/g, '');

  if (family === 'rebecca') {
    const invoiceTotalSection = INV_textSection_(
      value,
      /Invoice\s+Total/i,
      /Total\s+Paid|Balance\s+Owing|Items/i
    );

    const invoiceTotal = INV_lastPositiveMoney_(invoiceTotalSection);
    if (invoiceTotal !== null) return invoiceTotal;


  }

  const labelledPatterns = [
    /(?:invoice\s+total|grand\s+total|total\s+(?:incl(?:uding)?\.?\s+gst|amount))\s*[:\-]?\s*(?:AUD\s*)?\$?\s*([0-9][0-9,]*\.\d{2})/i,
    /(?:^|\n)\s*total\s*[:\-]?\s*(?:AUD\s*)?\$?\s*([0-9][0-9,]*\.\d{2})/i
  ];

  for (let i = 0; i < labelledPatterns.length; i++) {
    const match = value.match(labelledPatterns[i]);
    if (!match) continue;

    const amount = Number(match[1].replace(/,/g, ''));
    if (isFinite(amount) && amount > 0) return amount;
  }

  return null;
}

function INV_textSection_(text, startPattern, endPattern) {
  const value = String(text || '');
  const start = value.search(startPattern);
  if (start < 0) return '';

  const tail = value.slice(start);
  const startMatch = tail.match(startPattern);
  const contentStart = startMatch ? startMatch.index + startMatch[0].length : 0;
  const content = tail.slice(contentStart);
  const end = content.search(endPattern);

  return end >= 0 ? content.slice(0, end) : content.slice(0, 300);
}

function INV_lastPositiveMoney_(text) {
  const matches = String(text || '').match(/\$\s*([0-9][0-9,]*\.\d{2})/g) || [];
  const values = matches.map(function(item) {
    return Number(item.replace(/[^0-9.]/g, ''));
  }).filter(function(amount) {
    return isFinite(amount) && amount > 0;
  });

  return values.length ? values[values.length - 1] : null;
}

function INV_repairRebeccaInvoiceMetadata_(ss) {
  const claims = ss.getSheetByName(INV_CLAIMS_SHEET);
  if (!claims || claims.getLastRow() < 2) return 0;

  const lastRow = claims.getLastRow();
  const values = claims.getRange(2, 1, lastRow - 1, 11).getValues();
  let repaired = 0;

  for (let i = 0; i < values.length; i++) {
    const row = i + 2;
    const provider = String(values[i][4] || '').trim(); // E
    const amount = Number(values[i][6]);                 // G
    const driveUrl = String(values[i][10] || '').trim(); // K

    if (INV_providerFamilyKey_(provider) !== 'rebecca') continue;
    if (isFinite(amount) && amount > 0) continue;
    if (!INV_isDriveInvoiceUrl_(driveUrl)) continue;

    const fileId = INV_driveFileIdFromUrl_(driveUrl);
    if (!fileId) continue;

    try {
      const file = DriveApp.getFileById(fileId);
      const text = INV_extractPdfText_(file.getBlob());
      const parsedAmount = INV_findInvoiceAmountInPdf_(text, 'rebecca');
      const parsedDate = INV_findServiceDateInPdf_(text, 'rebecca');

      if (parsedAmount === null) {
        console.error('Rebecca invoice row ' + row + ': amount not found in PDF.');
        continue;
      }

      claims
        .getRange(row, 7)
        .setValue(parsedAmount)
        .setNumberFormat('$#,##0.00');

      if (parsedDate) {
        claims
          .getRange(row, 1)
          .setValue(parsedDate)
          .setNumberFormat('d mmm yyyy');
      }

      claims.getRange(row, 20).setFormula('=IF($A' + row + '="","",$A' + row + ')');
      claims.getRange(row, 22).setFormula('=IF($A' + row + '="","",$G' + row + ')');
      claims.getRange(row, 20).setNumberFormat('d mmm yyyy');
      claims.getRange(row, 22).setNumberFormat('$#,##0.00');

      repaired++;
      console.log(
        'Repaired Rebecca invoice row ' + row + ': ' +
        Utilities.formatDate(parsedDate || new Date(), INV_TIME_ZONE, 'd MMM yyyy') +
        ' / $' + parsedAmount.toFixed(2)
      );
    } catch (error) {
      console.error(
        'Rebecca invoice row ' + row + ' repair failed: ' +
        (error && error.message ? error.message : String(error))
      );
    }
  }

  if (repaired) SpreadsheetApp.flush();
  return repaired;
}

function INV_driveFileIdFromUrl_(url) {
  const value = String(url || '').trim();
  let match = value.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
  if (match) return match[1];

  match = value.match(/[?&]id=([a-zA-Z0-9_-]+)/);
  return match ? match[1] : '';
}

function INV_findAmount_(text) {
  const cleaned = String(text || '').replace(/\u00a0/g, ' ');
  const patterns = [
    /(?:amount\s+due|total\s+due|invoice\s+total|total)\s*[:\-]?\s*(?:aud\s*)?\$?\s*([0-9][0-9,]*\.\d{2})/i,
    /(?:aud\s*)?\$\s*([0-9][0-9,]*\.\d{2})/i
  ];

  for (let index = 0; index < patterns.length; index++) {
    const match = cleaned.match(patterns[index]);
    if (!match) continue;

    const amount = Number(match[1].replace(/,/g, ''));
    if (isFinite(amount) && amount > 0) return amount;
  }

  return null;
}

function INV_invoiceLabel_(fileName, subject) {
  const withoutExtension = String(fileName || '')
    .replace(/\.pdf$/i, '')
    .replace(/[_]+/g, ' ')
    .trim();

  if (withoutExtension && !/^attachment$/i.test(withoutExtension)) {
    return withoutExtension;
  }

  const match = String(subject || '').match(
    /(?:invoice|inv)[\s#:_-]*([a-z0-9-]+)/i
  );

  return match ? 'Invoice ' + match[1] : 'Invoice file';
}

var INV_RECEIVED_COLUMN_CACHE = {};
function INV_ensureReceivedDateColumn_(sheet) {
  if(!sheet)throw new Error('Financial Claims is missing.');
  const key=sheet.getParent().getId()+'|'+sheet.getSheetId();
  if(INV_RECEIVED_COLUMN_CACHE[key])return INV_RECEIVED_COLUMN_CACHE[key];
  const width=Math.max(1,sheet.getLastColumn());
  const headers=sheet.getRange(1,1,1,width).getDisplayValues()[0];
  const matches=[];
  headers.forEach(function(label,index){if(INV_normalise_(label)==='invoice received')matches.push(index+1);});
  if(matches.length>1)throw new Error('More than one Invoice received column exists in Financial Claims. No received dates were written.');
  if(matches.length){INV_RECEIVED_COLUMN_CACHE[key]=matches[0];return matches[0];}
  // Append beyond existing data and merged headers. A merged target writes to its
  // top-left cell, which may be the Paid checkbox column instead of this column.
  let column=Math.max(32,sheet.getLastColumn()+1);
  const merges=sheet.getRange(1,1,1,sheet.getMaxColumns()).getMergedRanges()
    .sort((a,b)=>a.getColumn()-b.getColumn());
  merges.forEach(function(range) {
    if(range.getColumn()<=column&&range.getLastColumn()>=column)column=range.getLastColumn()+1;
  });
  if(sheet.getMaxColumns()<column)sheet.insertColumnsAfter(sheet.getMaxColumns(),column-sheet.getMaxColumns());
  // Inserted columns can inherit checkbox or dropdown validation from a neighbour.
  // This column is newly allocated for dates, so remove that inherited validation.
  sheet.getRange(1,column,sheet.getMaxRows(),1).clearDataValidations();
  sheet.getRange(1,column).setValue('Invoice received').setFontFamily('Montserrat').setFontSize(11)
    .setFontWeight('bold').setFontColor('#FFFFFF').setBackground('#559899')
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);
  if(sheet.getMaxRows()>1)sheet.getRange(2,column,sheet.getMaxRows()-1,1).setNumberFormat('d mmm yyyy')
    .setFontFamily('Montserrat').setFontSize(10).setFontWeight('normal').setVerticalAlignment('middle');
  sheet.setColumnWidth(column,135);
  INV_RECEIVED_COLUMN_CACHE[key]=column;
  return column;
}
function INV_columnLetters_(column) {
  let letters='';
  while(column>0){column--;letters=String.fromCharCode(65+column%26)+letters;column=Math.floor(column/26);}
  return letters;
}

function INV_recordReceivedDate_(sheet, row, receivedAt) {
  if (!row || !(receivedAt instanceof Date) || isNaN(receivedAt.getTime())) return;
  const cell = sheet.getRange(row, INV_ensureReceivedDateColumn_(sheet));
  const current = INV_matchDate_(cell.getValue());
  if (!current || receivedAt.getTime() < current.getTime()) {
    cell.setValue(receivedAt).setNumberFormat('d mmm yyyy');
  }
}

function INV_getExistingInvoices_(sheet) {
  const result = {};
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) return result;

  const values = sheet
    .getRange(2, 1, lastRow - 1, 11)
    .getDisplayValues();

  values.forEach(function(row, index) {
    const date = INV_parseSheetDate_(row[0]);
    const provider = row[4];
    const invoice = row[5];

    if (!provider || !invoice) return;

    const identity = INV_invoiceIdentity_(
      provider,
      invoice,
      invoice,
      invoice,
      date
    );

    if (identity) {
      const previous = result[identity];
      const hasAmount = Number(String(row[6] || '').replace(/[^0-9.-]/g, '')) > 0;
      if (!previous || hasAmount && !(Number(String(values[previous - 2][6] || '').replace(/[^0-9.-]/g, '')) > 0)) {
        result[identity] = index + 2;
      }
    }
    const fileId = String(row[10] || '').match(/\/d\/([a-zA-Z0-9_-]+)|[?&]id=([a-zA-Z0-9_-]+)/);
    if (fileId) result['FILE|' + (fileId[1] || fileId[2])] = index + 2;
  });

  return result;
}

function INV_isDriveInvoiceUrl_(value) {
  return /^https:\/\/drive\.google\.com\//i.test(
    String(value || '').trim()
  );
}

function INV_getUnlinkedInvoices_(sheet, verifyFiles) {
  const result = [];
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) return result;

  const values = sheet
    .getRange(2, 1, lastRow - 1, 11)
    .getDisplayValues();

  values.forEach(function(row, index) {
    const date = INV_parseSheetDate_(row[0]);
    const provider = String(row[4] || '').trim();
    const label = String(row[5] || '').trim();
    const url = String(row[10] || '').trim();

    if (!provider || !label) return;
    const currentYear = date instanceof Date && date.getFullYear() === 2026;
    if (INV_isDriveInvoiceUrl_(url) && (verifyFiles === false || !currentYear || INV_invoiceFile_(url))) return;

    result.push({
      row: index + 2,
      date: date,
      provider: provider,
      label: label,
      providerKey: INV_providerFamilyKey_(provider),
      identity: INV_invoiceIdentity_(
        provider,
        label,
        label,
        label,
        date
      ),
      labelKey: INV_normalise_(label),
      used: false
    });
  });

  return result;
}

function INV_findUnlinkedMatch_(
  unlinked,
  providers,
  invoiceLabel,
  fileName,
  subject,
  messageDate
) {
  const familyKeys = providers.map(function(provider) {
    return INV_providerFamilyKey_(provider);
  });

  const identities = providers.map(function(provider) {
    return INV_invoiceIdentity_(
      provider,
      invoiceLabel,
      fileName,
      subject,
      messageDate
    );
  }).filter(Boolean);

  const labelKeys = [
    INV_normalise_(invoiceLabel),
    INV_normalise_(String(fileName || '').replace(/\.pdf$/i, ''))
  ].filter(Boolean);

  const candidates = unlinked.filter(function(item) {
    if (item.used || familyKeys.indexOf(item.providerKey) === -1) {
      return false;
    }

    return (
      identities.indexOf(item.identity) !== -1 ||
      labelKeys.indexOf(item.labelKey) !== -1
    );
  });

  if(candidates.length>1)throw new Error('More than one unlinked invoice matches. No invoice row was chosen.');
  return candidates[0]||null;
}

function INV_invoiceIdentity_(provider, label, fileName, subject, date) {
  const family = INV_providerFamilyKey_(provider);
  const source = [label, fileName, subject]
    .map(function(value) {
      return String(value || '');
    })
    .join(' ');

  const pdfNumber=String(label||'').match(/^Invoice\s+([a-z0-9][a-z0-9_/-]*)$/i);
  if(pdfNumber&&/\d/.test(pdfNumber[1])) {
    const number=pdfNumber[1].toUpperCase();
    if(family==='hireup')return family+'|'+(/^HU[-_]?/.test(number)?number.replace(/^HU[_-]?/,'HU-'):'HU-'+number);
    return family+'|'+(/^INV[-_]?/.test(number)?number.replace(/^INV[_-]?/,'INV-'):'INV-'+number);
  }
  let match;

  if (family === 'hireup') {
    match = source.match(/\bHU[-_\s]?(\d{5,})\b/i);
    if (match) return family + '|HU-' + match[1];
  }

  if (family === 'hannah') {
    match = source.match(/\bINV[-_\s]?(\d{5,})\b/i);
    if (match) return family + '|INV-' + match[1];
  }

  if (family === 'rebecca') {
    match = source.match(/\b(?:invoice|inv)[\s_#-]*(\d{3,})\b/i);
    if (match) return family + '|INV-' + match[1];

    const bareRebecca = String(label || fileName || '')
      .replace(/\.pdf$/i, '')
      .trim()
      .match(/^(\d{3,})$/);

    if (bareRebecca) return family + '|INV-' + bareRebecca[1];
  }

  if (family === 'cliniko') {
    match = source.match(/\b(?:invoice[\s_#-]*)?(\d{6,})\b/i);
    if (match) return family + '|INV-' + match[1];
  }

  if (family === 'angela') {
    match = source.match(
      /(january|february|march|april|may|june|july|august|september|october|november|december)[^0-9]{0,3}(20\d{2})/i
    );

    if (match) {
      const monthNames = [
        'january', 'february', 'march', 'april', 'may', 'june',
        'july', 'august', 'september', 'october', 'november', 'december'
      ];

      const month = monthNames.indexOf(match[1].toLowerCase()) + 1;
      return family + '|' + match[2] + '-' + String(month).padStart(2, '0');
    }

    if (date instanceof Date && !isNaN(date.getTime())) {
      return family + '|' + Utilities.formatDate(
        date,
        Session.getScriptTimeZone(),
        'yyyy-MM'
      );
    }
  }

  const fallback = INV_invoiceKey_(label || fileName || subject);
  return family + '|FALLBACK-' + fallback;
}

function INV_providerFamilyKey_(provider) {
  const value = INV_normalise_(provider);

  if (value.indexOf('hireup') !== -1) return 'hireup';
  if (value.indexOf('hannah warne-smith') !== -1) return 'hannah';
  if (value.indexOf('rebecca somervaille') !== -1) return 'rebecca';
  if (value.indexOf('angela mcmahon') !== -1) return 'angela';

  if (
    value.indexOf('move beyond chatswood') !== -1 ||
    value.indexOf('movement 101') !== -1
  ) {
    return 'cliniko';
  }

  return value;
}

function INV_invoiceKey_(value) {
  return INV_normalise_(value)
    .replace(/\.pdf$/i, '')
    .replace(/\b(invoice|inv|file|pdf)\b/g, ' ')
    .replace(/[^a-z0-9]+/g, '')
    .trim();
}

function INV_parseSheetDate_(value) {
  if(value instanceof Date)return isNaN(value.getTime())?null:value;
  const text=String(value||'').trim();
  if(!text)return null;
  const australian=INV_parseAustralianDate_(text);
  if(australian)return australian;
  if(/^\d{1,2}[/.\-]\d{1,2}[/.\-]\d{4}$/.test(text))return null;
  const date=new Date(text);
  return isNaN(date.getTime())?null:date;
}



function INV_getOrCreateFolder_() {
  const folder = DriveApp.getFolderById(INV_FOLDER_ID);
  if (folder.isTrashed()) throw new Error('The NDIS invoice folder is in the bin. Restore it before importing.');
  return folder;
}

function INV_safeFolderName_(value) {
  return String(value || 'Other Provider')
    .replace(/[\\/:*?"<>|]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim() || 'Other Provider';
}

function INV_getOrCreateProviderFolder_(rootFolder, provider) {
  const fixedId = INV_PROVIDER_FOLDER_IDS[INV_providerFamilyKey_(provider)];
  if (fixedId) {
    const folder = DriveApp.getFolderById(fixedId);
    if (folder.isTrashed()) throw new Error('The invoice folder for ' + provider + ' is in the bin.');
    const parents = folder.getParents();
    let inRoot = false;
    while (parents.hasNext()) if (parents.next().getId() === rootFolder.getId()) inRoot = true;
    if (!inRoot) throw new Error('The invoice folder for ' + provider + ' is outside ' + INV_FOLDER_NAME + '. Check its location.');
    return folder;
  }
  const name = INV_safeFolderName_(provider);
  const folders = rootFolder.getFoldersByName(name);
  return folders.hasNext() ? folders.next() : rootFolder.createFolder(name);
}

function INV_invoiceFile_(url) {
  const match = String(url || '').match(/\/d\/([a-zA-Z0-9_-]+)|[?&]id=([a-zA-Z0-9_-]+)/);
  if (!match) return null;
  const id = match[1] || match[2];
  if (Object.prototype.hasOwnProperty.call(INV_FILE_CACHE, id)) return INV_FILE_CACHE[id];
  try {
    const file = DriveApp.getFileById(id);
    INV_FILE_CACHE[id] = !file.isTrashed() && file.getMimeType() === 'application/pdf' ? file : null;
  } catch (error) { INV_FILE_CACHE[id] = null; }
  return INV_FILE_CACHE[id];
}

function INV_saveInvoiceFile_(root, folder, bytes, originalName, hash, knownUrl) {
  const known = knownUrl && INV_invoiceFile_(knownUrl);
  if (known && INV_hash_(known.getBlob().getBytes()) === hash) return known;
  const name = /\.pdf$/i.test(originalName) ? originalName : originalName + '.pdf';
  for (const parent of [folder, root]) {
    for (const candidateName of Array.from(new Set([name, originalName]))) {
      const files = parent.getFilesByName(candidateName);
      while (files.hasNext()) {
        const file = files.next();
        if (file.isTrashed() || file.getMimeType() !== 'application/pdf') continue;
        if (INV_hash_(file.getBlob().getBytes()) !== hash) continue;
        if (parent.getId() !== folder.getId()) file.moveTo(folder);
        return file;
      }
    }
  }
  return folder.createFile(Utilities.newBlob(bytes, 'application/pdf', name));
}

function INV_repairSavedInvoiceLinks_(sheet) {
  const count = sheet.getLastRow() - 1;
  if (count < 1) return;
  const values = sheet.getRange(2, 1, count, 11).getDisplayValues();
  const formulas = sheet.getRange(2, 6, count, 1).getFormulas();
  values.forEach(function(row, i) {
    if (!row[4] || !row[5] || INV_isDriveInvoiceUrl_(row[10])) return;
    const match = String(formulas[i][0] || "").match(/^=HYPERLINK\("(https:\/\/drive\.google\.com\/[^"]+)"/i);
    if (match && INV_isDriveInvoiceUrl_(match[1])) {
      sheet.getRange(i + 2, 11).setValue(match[1]);
    }
  });
}

function INV_nextInvoiceRow_(sheet) {
  const count = sheet.getLastRow() - 1;
  if (count < 1) return 2;
  const rows = sheet.getRange(2, 1, count, Math.min(31, sheet.getMaxColumns())).getValues();
  for (let i = rows.length - 1; i >= 0; i--) {
    const r = rows[i];
    const hasData = r.slice(0, 11).some(v => v !== '' && v !== null) ||
      r.slice(22, 24).some(v => v !== '' && v !== null) || r[24] === true ||
      r.slice(26).some(v => v !== '' && v !== null);
    if (hasData) return i + 3;
  }
  return 2;
}

function INV_flushImportLog_(log, rows) {
  if (!rows.length) return;
  const start = log.getLastRow() + 1;
  INV_ensureRowCapacity_(log, start + rows.length - 1);
  log.getRange(start, 1, rows.length, 7).setValues(rows);
  SpreadsheetApp.flush();
  rows.length = 0;
}

function INV_getOrCreateLog_(ss) {
  let sheet = ss.getSheetByName(INV_LOG_SHEET);

  if (!sheet) {
    sheet = ss.insertSheet(INV_LOG_SHEET);
    sheet.setFrozenRows(1);
    sheet.hideSheet();
  }

  sheet.getRange('A1:G1').setValues([[
    'Duplicate Key',
    'Provider',
    'Invoice #',
    'PDF Hash',
    'Drive URL',
    'Gmail Message ID',
    'Result'
  ]]);

  return sheet;
}

function INV_makeLogRow_(key, provider, invoice, hash, url, messageId, result) {
  return [
    key || '', provider || '', invoice || '', hash || '',
    url || '', messageId || '', result || ''
  ];
}

function INV_getKnownKeys_(sheet, existing) {
  const result = {};
  const lastRow = sheet.getLastRow();

  if (lastRow < 2) return result;

  sheet
    .getRange(2, 1, lastRow - 1, 7)
    .getDisplayValues()
    .forEach(function(row) {
      if (row[0]) result[row[0]] = true;
      const hash = row[3] || (String(row[0]).indexOf('|') !== -1 ? row[1] : '');
      if (hash) result['HASH|' + hash] = true;
      if (!hash) return;
      const url = String(row[4] || '');
      if (INV_isDriveInvoiceUrl_(url)) result['HASHURL|' + hash] = url;
      if (!existing) return;
      const fileId = url.match(/\/d\/([a-zA-Z0-9_-]+)|[?&]id=([a-zA-Z0-9_-]+)/);
      const identity = INV_invoiceIdentity_(row[1], row[2], row[2], row[2], null);
      const matched = (fileId && existing['FILE|' + (fileId[1] || fileId[2])]) || existing[identity];
      if (matched) result['HASHROW|' + hash] = matched;
    });

  return result;
}

function INV_ensureRowCapacity_(sheet, neededLastRow) {
  const maxRows = sheet.getMaxRows();

  if (neededLastRow <= maxRows) return;

  const rowsToAdd = Math.max(
    neededLastRow - maxRows,
    100
  );

  sheet.insertRowsAfter(maxRows, rowsToAdd);
}

function INV_applyValidation_(sheet, startRow, rowCount) {
  const budgetRule = SpreadsheetApp.newDataValidation()
    .requireValueInList([
      'Flexible Core',
      'Transport',
      'Capacity Building'
    ], true)
    .setAllowInvalid(false)
    .build();

  const statusRule = SpreadsheetApp.newDataValidation()
    .requireValueInList([
      'Paid',
      'To Be Paid',
      'To Be Claimed',
      'Claimed',
      'Cancelled',
      'Rejected',
      'Needs Review'
    ], true)
    .setAllowInvalid(false)
    .build();

  sheet
    .getRange(startRow, 2, rowCount, 1)
    .setDataValidation(budgetRule);

  sheet
    .getRange(startRow, 8, rowCount, 1)
    .setDataValidation(statusRule);
}

function INV_hash_(bytes) {
  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    bytes
  );

  return Utilities.base64EncodeWebSafe(digest);
}

function INV_safeFileName_(name) {
  const cleaned = String(name || 'Invoice.pdf')
    .replace(/[\\/:*?"<>|]/g, '_')
    .trim();

  return cleaned || 'Invoice.pdf';
}

function INV_normalise_(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/\s+/g, ' ')
    .trim();
}

function INV_preserveInvoiceInHeader_(claims) {
  const width=Math.max(33,claims.getLastColumn()),row=claims.getRange(1,1,1,width).getValues()[0];
  const date=INV_parseSheetDate_(row[0]),amount=INV_matchAmount_(row[6]);
  if(!date||!row[4]||!row[5]||amount===null||amount<=0)return 0;
  const ss=claims.getParent();
  let history=ss.getSheetByName('__INVOICE_HEADER_BACKUP__');
  if(!history){history=ss.insertSheet('__INVOICE_HEADER_BACKUP__');history.getRange(1,1,1,3).setValues([['Saved at','Source','Original values']]);history.hideSheet();}
  history.getRange(history.getLastRow()+1,1,1,3).setValues([[new Date(),'Financial Claims row 1',JSON.stringify(row)]]);
  SpreadsheetApp.flush();
  const data=claims.getLastRow()>1?claims.getRange(2,1,claims.getLastRow()-1,11).getValues():[];
  let target=0;
  data.forEach((r,i)=>{if(r[10]&&r[10]===row[10]&&String(r[4])===String(row[4])&&INV_matchAmount_(r[6])===amount)target=i+2;});
  if(!target){
    target=claims.getLastRow()+1;if(target>claims.getMaxRows())claims.insertRowsAfter(claims.getMaxRows(),1);
    PROJECT_copyFinancialClaimFormatting_(claims,target,1);
    INV_applyValidation_(claims,target,1);
    const base=row.slice(0,11);base[0]=date;
    if(/^Request ID$/i.test(String(base[8])))base[8]='';
    if(/^Notes$/i.test(String(base[9])))base[9]='';
    claims.getRange(target,1,1,11).setValues([base]);
    if(base[10])claims.getRange(target,6).setFormula('=HYPERLINK("'+String(base[10]).replace(/"/g,'""')+'","'+String(base[5]).replace(/"/g,'""')+'")');
    const received=INV_matchDate_(row[31]);if(received)INV_recordReceivedDate_(claims,target,received);
    claims.getRange(target,25).insertCheckboxes().setValue(/^paid$/i.test(String(row[7])));
    INV_writeDerivedClaimFormulas_(claims,target,1,false);
    SpreadsheetApp.flush();
    const saved=claims.getRange(target,1,1,11).getValues()[0];
    if(String(saved[5])!==String(base[5])||INV_matchAmount_(saved[6])!==amount||String(saved[10])!==String(base[10]))throw new Error('The invoice in row 1 could not be verified. Original row kept.');
  }
  if(INV_matchDate_(row[31]))claims.getRange(1,32).clearDataValidations().setValue('Legacy received date');
  claims.getRange(1,1,1,15).clearDataValidations().setValues([['Invoice date','Funding category','Support','Goal','Provider','Invoice','Amount','Status','Request ID','Notes','PDF link','Budget category','Effective status','Effective claim ID','Claim date']]);
  INV_repairFinancialClaimsHeaders_(claims);
  return target;
}
function REPAIR_INVOICE_HEADER() {
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(60000))throw new Error('Workbook is busy. The invoice header has not been changed.');
  try {
    const ss=SpreadsheetApp.openById(INV_SPREADSHEET_ID),claims=ss.getSheetByName(INV_CLAIMS_SHEET);
    const row=INV_preserveInvoiceInHeader_(claims);
    const message=row?'Invoice from row 1 safely preserved at row '+row+'. Column headers restored.':'Invoice headers contain no misplaced invoice.';
    Logger.log(message);return message;
  }finally{lock.releaseLock();}
}

function INV_repairFinancialClaimsInfrastructure_(ss) {
  INV_syncSheetAliases_(ss);
  const claims = ss.getSheetByName(INV_CLAIMS_SHEET);
  if (!claims) throw new Error('Could not find ' + INV_CLAIMS_SHEET + '.');

  INV_preserveInvoiceInHeader_(claims);
  INV_repairFinancialClaimsHeaders_(claims);
  INV_ensureReceivedDateColumn_(claims);
  INV_repairSavedInvoiceLinks_(claims);

  INV_repairAllDerivedFormulaColumns_(claims);

  const lastRow = Math.max(claims.getLastRow(), 2);
  if (lastRow >= 2) {
    INV_applyValidation_(claims, 2, lastRow - 1);
    PROJECT_repairFinancialClaimsFormatting_(ss);
  }
}

function INV_repairFinancialClaimsHeaders_(claims) {
  const headers = [
    'Support',
    'Goal',
    'Provider',
    'ABN',
    'Invoice Date',
    'invoice #',
    'Amount',
    'Request ID',
    'Notes',
    '✓ Paid',
    'Workflow status'
  ];

  // Header labels are text. Checkbox validation belongs on data rows only.
  // Clear it before writing Y1, or Sheets can report the failed buffered write
  // during the next read in received-date setup.
  claims.getRange(1, 16, 1, headers.length).clearDataValidations().setValues([headers]);
}

