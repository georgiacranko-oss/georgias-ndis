}
function S6_applyNoteLabel_(resource,item,labels) {
  if(!labels||!CS4_supportKind_(item.type))return;
  const needs=S6_needsNoteLabel_(resource,item.type),name=CS4_cleanSummary_(resource.summary);
  resource.summary=needs?name+' MISSING NOTE':name;
  if(needs&&labels.byType.Missing)resource.eventLabelId=labels.byType.Missing;
  else if(S6_hasDescriptionNotes_(resource.description)||resource.eventLabelId===labels.byType.Missing)
    resource.eventLabelId=labels.byType.Regular||resource.eventLabelId;
}
function APPLY_MISSING_NOTES_LABELS() {
  const p=PropertiesService.getScriptProperties();
  if(p.getProperty('CALENDAR_PAUSED')==='1'){const message='Calendar automation is paused. No note labels were changed.';NDIA_safeNotify_(message);return message;}
  p.deleteProperty('CALWARN_PROGRESS_V1');
  CALWARN_queue_(60000);
  return 'Missing Notes labels are queued after note recovery. Away and future shifts are exempt.';
}

function S6_clearMissingWarning_(event, labels) {
  const summary=String(event.summary||'');
  const clean=summary.replace(/\b(?:MISSING\s+(?:SHIFT\s+)?NOTES?|MISSING\s+SHIFTS?|NOTES?\s+MISSING|SHIFT\s+NOTE\s+NOT\s+COMPLETED)\b\s*[!.,:]*/gi,'')
    .replace(/\[\s*\]/g,'').replace(/\s+/g,' ').replace(/^[.,:;\s]+|[.,:;\s]+$/g,'');
  const missingLabel=(!!labels.byType.Missing&&event.eventLabelId===labels.byType.Missing)||labels.byId[event.eventLabelId]==='Missing';
  const parsed=S6_event_(event,labels);if(!parsed)return null;
  const needs=S6_needsNoteLabel_(event,parsed.type);
  if(clean===summary&&!missingLabel&&!needs)return null;
  const label=needs?'Missing':CS4_supportKind_(parsed.type)?'Regular':parsed.type;
  const labelId=labels.byType[label]||labels.byType.Regular;
  const title=needs?clean+' MISSING NOTE':clean;
  if(title===summary&&event.eventLabelId===labelId)return null;
  const next=Object.assign({},event,{summary:title,eventLabelId:labelId});
  const oldPrivate=event.extendedProperties&&event.extendedProperties.private||{};
  return {summary:title,eventLabelId:next.eventLabelId,extendedProperties:{private:Object.assign({},oldPrivate,{s6Hash:S6_eventHash_(next)})}};
}

function REPAIR_SAVED_OCTOBER_SHIFTS() {
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(240000))throw new Error('Another calendar process is running. No shift repair was started.');
  try {
    const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID),registry=S6_registry_(ss),labels=CS4_labels_();
    S6_resource_.labels=labels;
    const targets=[
      {key:'roster6|2026-10-08|fab|Support|0',person:'Fab',day:'2026-10-08',id:'cs3e2a21bd8a89ae42247f2b40f7d8ac86035c22dbe'},
      {key:'roster6|2026-10-09|freya|Support|0',person:'Freya',day:'2026-10-09',id:'cs31f3e0727cefff7f2945377c543c9b991bfe2f3b2'}
    ];
    const jobs=targets.map(function(target){
      const record=registry.records[target.key];
      if(!record||!record.model||record.model.day!==target.day||CS4_name_(record.model.person)!==CS4_name_(target.person)||!S6_hasDescriptionNotes_(record.lastDescription))throw new Error('Saved shift or notes not found for '+target.person+'. No repairs started.');
      const current=S6_call_(()=>Calendar.Events.get(CS4.calendarId,target.id,{eventLabelVersion:1})),model=record.model;
      if(current.status==='cancelled'||current.recurringEventId||CS4_name_(CS4_cleanSummary_(current.summary))!==CS4_name_(target.person)||!current.start.dateTime||new Date(current.start.dateTime).toISOString()!==model.start)throw new Error('The surviving '+target.person+' event changed. No repairs started.');
      return {target:target,record:record,current:current};
    });
    const results=[];
    jobs.forEach(function(job){
      const {target,record,current}=job,model=record.model,item=Object.assign({},model,{key:target.key,start:new Date(model.start),end:new Date(model.end)});
      const resource={summary:target.person,description:record.lastDescription,status:'confirmed',
        start:{dateTime:model.start,timeZone:CS4.zone},end:{dateTime:model.end,timeZone:CS4.zone},eventLabelId:labels.byType.Regular,
        extendedProperties:{private:Object.assign({},current.extendedProperties&&current.extendedProperties.private||{},
          {managedBy:'SYNC6',sourceKey:target.key,syncVersion:'6',type:model.type})}};
      S6_patchPreservingNotes_(item,target.id,resource,record);
      const verified=S6_call_(()=>Calendar.Events.get(CS4.calendarId,target.id,{eventLabelVersion:1}));
      if(verified.status==='cancelled'||new Date(verified.start.dateTime).toISOString()!==model.start||new Date(verified.end.dateTime).toISOString()!==model.end||!S6_normal_(verified.description).includes(S6_normal_(record.lastDescription)))throw new Error('Could not verify the repaired '+target.person+' event. Its saved notes remain intact.');
      record.id=verified.id;record.phase='active';record.eventHash=S6_eventHash_(verified);record.lastDescription=S6_duplicateDescription_(record.lastDescription,verified.description);delete record.error;
      S6_save_(registry,record);
