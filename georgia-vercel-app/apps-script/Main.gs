  const statements={
    'tasks taking longer and causing physical strain':[
      'Everyday tasks took longer and caused physical strain.',
      'Georgia needed more time for everyday tasks, which also placed strain on their body.',
      'Daily activities were taking longer and were physically demanding for Georgia.'
    ],
    'physical exhaustion affecting self care and safety':[
      'Physical exhaustion made self care and staying safe more difficult.',
      'Georgia was physically exhausted, which affected self care and safety.',
      'Self care and safety were affected by physical exhaustion.'
    ],
    'pain limiting everyday activities':[
      'Pain limited what Georgia could do in everyday activities.',
      'Everyday activities were harder for Georgia because of pain.',
      'Georgia needed assistance because pain restricted everyday activities.',
      'Pain made it difficult for Georgia to carry out everyday activities.'
    ],
    'communication taking much more effort':[
      'Communication required much more effort from Georgia.',
      'It took Georgia considerably more effort to communicate.',
      'Georgia was having to put much more effort into communication.'
    ],
    'reduced control of swallowing':[
      'Georgia had less control over swallowing.',
      'Swallowing was becoming harder for Georgia to control.',
      'Reduced control of swallowing contributed to the need for support.'
    ],
    'reduced capacity for thinking and planning':[
      'Georgia had less capacity for thinking and planning.',
      'Thinking and planning were more difficult for Georgia.',
      'Reduced capacity to think and plan contributed to the need for assistance.'
    ],
    'overwhelm increasing pain and reducing stamina':[
      'Overwhelm increased pain and reduced stamina.',
      'Georgia experienced more pain and less stamina when overwhelmed.',
      'Increased pain and reduced stamina were linked to overwhelm.'
    ],
    'significantly reduced movement and thinking':[
      'Georgia had significantly reduced capacity for movement and thinking.',
      'Movement and thinking were both significantly reduced.',
      'Significant difficulty with movement and thinking contributed to the need for support.'
    ]
  };
  const sentences=[],remaining=[];
  NDISPara_unique_(needs).forEach(need=>{
    if(statements[need])sentences.push(NDISPara_variant_(statements[need],seed,need));
    else remaining.push(need);
  });
  sentences.push(NDISPara_groups_(remaining,['Support was needed because of {items}.','Georgia needed assistance with {items}.'],['Other difficulties included {items}.','Support was also needed because of {items}.'],seed));
  if(extra.length)sentences.push('Further difficulties were recorded. '+extra.map(NDISPara_sentence_).join(' '));
  const regular={
    'every time this activity occurs':['This support is needed each time the activity occurs.','Georgia needs this assistance whenever the activity takes place.'],
    'most times this activity occurs':['This support is usually needed when the activity occurs.','Georgia generally needs assistance for this activity.'],
    'regularly, but not every time':['This support is needed regularly, though not every time.','Georgia regularly needs this assistance, but not on every occasion.'],
    'first time or unusual event':['This was recorded as a first occurrence or an unusual support need.','The support need was recorded as new or unusual.']
  };
  if(regular[NDISPara_normalise_(regularity)])sentences.push(NDISPara_variant_(regular[NDISPara_normalise_(regularity)],seed,'regularity'));
  return sentences.filter(Boolean).join(' ');
}
function NDISPara_contextParagraph_(wellbeing,source,painLocation,moodReason,seed) {
  const states=wellbeing.states||[],sentences=[];
  const wording={
    'general mood':['lower mood','much lower mood','higher mood'],
    'swallowing':['more difficulty swallowing','much more difficulty swallowing','less difficulty swallowing'],
    'anxiety':['higher anxiety','much higher anxiety','lower anxiety'],
    'energy':['lower energy','much lower energy','higher energy'],
    'cognition':['more difficulty thinking','much more difficulty thinking','less difficulty thinking'],
    'pain':['more pain','much more pain','less pain']
  };
  const lower=NDISPara_normalise_(source);
  const prefixes=lower==='georgia told me'?[
    'Georgia reported {items} compared with their usual level.',
    'Georgia described {items} compared with how they usually feel.',
    'According to Georgia, they were experiencing {items} than usual.',
    'Georgia told me they were experiencing {items} compared with usual.'
  ]:/both/.test(lower)?[
    'My observations and what Georgia reported indicated {items} compared with their usual level.',
    'Georgia described {items} compared with usual, which was consistent with what I observed.',
    'Both Georgia\'s account and my observations indicated {items} compared with usual.'
  ]:/directly observed/.test(lower)?[
    'I observed {items} compared with Georgia\'s usual level.',
    'Compared with how Georgia usually presents, I noticed {items}.',
    'I noticed {items} than is usual for Georgia.',
    'My observations were of {items} compared with Georgia\'s usual level.'
  ]:/interpretation/.test(lower)?[
    'My impression was of {items} compared with Georgia\'s usual level.',
    'I interpreted Georgia\'s presentation as {items} compared with usual.',
    'In my view, Georgia appeared to have {items} compared with usual.'
  ]:[
    'The note records {items} compared with Georgia\'s usual level.',
    'Compared with Georgia\'s usual level, the note records {items}.'
  ];
  const comparisons=[];states.forEach(x=>{if(x.value==='a challenge')return;const w=wording[x.label];if(!w)return;if(/worse/.test(x.value))comparisons.push(w[/much/.test(x.value)?1:0]);else if(/better/.test(x.value))comparisons.push(w[2]);});
  const continuing=lower==='georgia told me'?'Georgia also reported {items}.':
    /both/.test(lower)?'My observations and Georgia\'s account also indicated {items}.':
    /directly observed/.test(lower)?'I also observed {items}.':
    /interpretation/.test(lower)?'I also had the impression of {items}.':
    'The note also records {items}.';
  if(comparisons.length)sentences.push(NDISPara_groups_(comparisons,prefixes,[continuing],seed));
  const challenge=states.filter(x=>x.value==='a challenge').map(x=>x.label==='general mood'?'mood':x.label==='cognition'?'thinking':x.label);
  if(challenge.length) {
    const reported=lower==='georgia told me'?[
      'Georgia described difficulties with {items}.','Georgia said that {items} had been difficult.','Georgia reported challenges with {items}.'
    ]:/directly observed/.test(lower)?[
      'I observed difficulties with {items}.','I noticed that {items} presented difficulties.'
    ]:/interpretation/.test(lower)?[
      'In my view, Georgia was having difficulty with {items}.','I considered {items} to be areas of difficulty.'
    ]:/both/.test(lower)?[
      'Both my observations and Georgia\'s account indicated difficulties with {items}.'
    ]:['The note records difficulties with {items}.','Difficulties with {items} were recorded.'];
    sentences.push(NDISPara_groups_(challenge,reported,reported,seed+3));
  }
  if((wellbeing.worse||[]).includes('pain')||(wellbeing.challenge||[]).includes('pain')) {
    if(painLocation&&!NDISPara_emptyOrNo_(painLocation))sentences.push('The recorded pain location was '+NDISPara_sentenceFragment_(NDISPara_lowerFirst_(painLocation))+'.');
  }
  if((wellbeing.worse||[]).includes('general mood')||(wellbeing.challenge||[]).includes('general mood')) {
    if(moodReason&&!NDISPara_emptyOrNo_(moodReason))sentences.push('The factor noted as affecting mood was '+NDISPara_sentenceFragment_(NDISPara_lowerFirst_(moodReason))+'.');
  }
  return sentences.join(' ');
}
function NDISPara_enabledParagraph_(value,seed,source) {
