function RESUME_CALENDAR_AUTOMATION() {
  const lock=LockService.getScriptLock();if(!lock.tryLock(1000))throw new Error('Workbook is busy. Automation settings were kept.');
  try {
    const p=PropertiesService.getScriptProperties();
    if(p.getProperty('S6_NOTE_REPAIR')||p.getProperty('S6_NOTE_RESTORE_PENDING'))throw new Error('Finish the pending note recovery before resuming calendar automation.');
    const health=CHECK_PROCESS_HEALTH(),notes=CHECK_SHEET_CALENDAR_EXPORT(),preview=health.calendarPreview;
    if(health.issues.length||health.noteRowsWithoutText||notes.issues.length||preview.updates||preview.missing||preview.ambiguous||preview.duplicateCandidates)
      throw new Error('Calendar or note checks need reconciliation. Automation settings were kept.');
    PROJECT_installTriggers_(SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID));PROJECT_installCalendarUpdateTrigger_();
    // Retire completed recovery requests, then start the normal two way path.
    ScriptApp.getProjectTriggers().filter(t=>['CLEAR_CALENDAR_NOTE_WARNINGS','CLEAN_CALENDAR_DUPLICATES'].includes(t.getHandlerFunction())).forEach(t=>ScriptApp.deleteTrigger(t));
    ['CALWARN_REQUESTED','CALWARN_PROGRESS_V1','S6_FROM_SHEETS','S6_DELTA_PROGRESS','S6_DELTA_PENDING'].forEach(k=>p.deleteProperty(k));
    p.deleteProperty('CALENDAR_PAUSED');p.setProperty('S6_PENDING','1');
    p.setProperty('S6_SHEET_AT',String(Date.now()-120001));CALENDAR_queueChange_();
    const result={calendarAutomationEnabled:true,direction:'two way',dailyCheck:'About 08:15 Australia/Melbourne',changes:'After two quiet minutes',submittedNotesVerified:notes.verifiedSupportNotes};
    Logger.log(JSON.stringify(result));return result;
  }finally{lock.releaseLock();}
}

function INSTALL_REVIEWED_TRIGGERS() {
  const lock=LockService.getScriptLock();if(!lock.tryLock(1000))throw new Error('Workbook is busy. Trigger settings were kept.');
  try {
    const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
    PROJECT_installTriggers_(ss);PROJECT_installCalendarUpdateTrigger_();
    const paused=PropertiesService.getScriptProperties().getProperty('CALENDAR_PAUSED')==='1';
    const message='Daily and change triggers installed. '+(paused?'Calendar automation remains paused.':'Calendar checks run daily and after changes.');
    Logger.log(message);return message;
  }finally{lock.releaseLock();}
}

