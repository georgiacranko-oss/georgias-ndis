function CHECK_SHEET_CALENDAR_EXPORT() {
  const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID),t=CS4_table_(ss),labels=CS4_labels_(),registry=S6_registry_(ss),events=S6_events_(labels);
  const count=t.sheet.getLastRow()-t.header,names=count>0?t.sheet.getRange(t.header+1,CS4_col_(t,['Person / Event']),count,1).getDisplayValues():[];
  const changes=CS4_readChanges_(t,false).filter(c=>c.show&&String(names[c.row-t.header-1][0]||'').trim());
  const issues=[];
  changes.forEach(function(item) {
    const matches=events.filter(e=>e.id===item.id);
    if(matches.length!==1){issues.push('Saved row '+item.row+' has no unique active event.');return;}
    const resource=X7_resource_({item:item,record:registry.records[item.key]||{},current:matches[0].event},labels,registry);
    if(!X7_same_(resource,matches[0].event))issues.push('Saved row '+item.row+' differs from its calendar event.');
  });
  const groups=S6_noteRepairGroups_(registry,{records:[]},[]).filter(g=>CS4_supportKind_(g.model.type)&&g.model.day>=CS4.start&&g.model.day<='2026-10-11');
  let verified=0;
  groups.forEach(function(group) {
    const match=S6_noteRepairMatch_(group,events);
    if(!match||!S6_normal_(match.event.description).includes(S6_normal_(group.text))||match.event.eventLabelId!==labels.byType.Regular||/missing\s+notes?/i.test(match.event.summary))issues.push('Saved note mismatch for '+group.model.day+' '+group.model.person);
