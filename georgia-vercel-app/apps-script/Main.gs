function X7_export_(apply) {
  const lock=LockService.getScriptLock();if(!lock.tryLock(1000)){if(apply)X7_queueExport_();return 'Another workbook job is running. Saved changes are kept.'+(apply?' Export is queued.':' Preview did not run.');}
