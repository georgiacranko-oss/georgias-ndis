  if(props.getProperty('S6_NOTE_REPAIR'))return 'Missing support events will be restored after the note batches finish.';
  const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return 'Missing support note restoration is queued.';
  try {
    const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID),t=CS4_table_(ss),registry=S6_registry_(ss),labels=CS4_labels_(),notes=S6_notes_(ss),changes=CS4_readChanges_(t);
    S6_resource_.labels=labels;S6_workers_(ss,notes,changes);
