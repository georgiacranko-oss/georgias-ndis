function OV_ON_EDIT(e) {
  if (!e || !e.range) return;

  const sheet = e.range.getSheet();
  const sheetName = sheet.getName();

  if (PROJECT_OVERVIEW_SHEET_ALIASES.indexOf(sheetName) !== -1) {
    const touchesMonth = GCAL4_rangeTouchesCell_(e.range, OV_CONFIG.monthCell);
    const touchesYear = GCAL4_rangeTouchesCell_(e.range, OV_CONFIG.yearCell);

    if (touchesMonth || touchesYear) {
      OV_REFRESH();
      refreshOverviewWrittenNotes();
      resizeOverviewRows();
    }
    return;
  }

  if (
    OV_CONFIG.responseSheets.indexOf(sheetName) !== -1 &&
    e.range.getRow() > 1
  ) {
    OV_REFRESH();
  }
}

function OV_refreshEvidenceLinks_(sheet) {
  const safeUrl = String(PROJECT_SHIFT_NOTE_WEB_APP_URL || '')
    .replace(/"/g, '""');

  const formula =
    '=IFNA(LET(' +
    'monthSel,LOWER(TRIM($B$5)),' +
    'yearSel,$E$5,' +
    'startDate,IF(monthSel="all months",DATE(yearSel,1,1),' +
      'DATE(yearSel,MATCH(monthSel,{"january","february","march","april","may","june","july","august","september","october","november","december"},0),1)),' +
    'endDate,IF(monthSel="all months",DATE(yearSel+1,1,1),EDATE(startDate,1)),' +
    'shifts,SORT(FILTER(HSTACK(ROW(\'Shift Notes\'!$C$2:$C),\'Shift Notes\'!$C$2:$C,\'Shift Notes\'!$B$2:$B),' +
      '\'Shift Notes\'!$C$2:$C>=startDate,\'Shift Notes\'!$C$2:$C<endDate),2,FALSE),' +
    'MAP(CHOOSECOLS(shifts,1),CHOOSECOLS(shifts,2),CHOOSECOLS(shifts,3),' +
      'LAMBDA(r,d,w,HYPERLINK("' + safeUrl + '?row="&r,TEXT(d,"d mmm")&", "&w)))),' +
    '"")';

  sheet.getRange('M64').setFormula(formula);
}

function OV_formatFormulaGrid_(sheet) {
  const firstRow = OV_CONFIG.weekdayRow;   // 39
  const lastRow = OV_CONFIG.lastDataRow;   // 50
  const firstCol = OV_CONFIG.firstDayCol;  // J = 10
  const lastCol = OV_CONFIG.lastDayCol;    // AN = 40
  const rowCount = lastRow - firstRow + 1;
  const colCount = lastCol - firstCol + 1;

  const grid = sheet.getRange(firstRow, firstCol, rowCount, colCount);

  grid.setBorder(
    true, true, true, true, true, true,
    '#FFFFFF',
    SpreadsheetApp.BorderStyle.SOLID
  );

  OV_applySundayBorders_(sheet);

  sheet.getRange('J50:AN50').setBorder(
    true, false, false, false, false, false,
    '#FFFFFF', SpreadsheetApp.BorderStyle.SOLID
  ).setBorder(
    null, null, true, null, null, null,
    '#0097a6', SpreadsheetApp.BorderStyle.SOLID_THICK
  );
}

function OV_applySundayBorders_(sheet) {
  const monthText = String(
    sheet.getRange(OV_CONFIG.monthCell).getDisplayValue() || ''
  ).trim();

  const year = Number(
    sheet.getRange(OV_CONFIG.yearCell).getValue()
  );

  if (!monthText || !year || OV_isAllMonths_(monthText)) return;

  const monthIndex = OV_monthIndex_(monthText);
  if (monthIndex < 0) return;

  const firstCol = OV_CONFIG.firstDayCol;
  const firstRow = OV_CONFIG.weekdayRow;
  const rowCount = OV_CONFIG.lastDataRow - firstRow + 1;
  const daysInMonth = new Date(year, monthIndex + 1, 0).getDate();

  for (let day = 1; day <= daysInMonth; day++) {
    const date = new Date(year, monthIndex, day);
    if (date.getDay() !== 0) continue;

    const col = firstCol + day - 1;
    sheet.getRange(firstRow, col, rowCount, 1).setBorder(
      null, null, null, true, null, null,
      '#FFFFFF',
      SpreadsheetApp.BorderStyle.SOLID_MEDIUM
    );
  }
}

function OV_monthIndex_(
  value
) {
  const text =
    OV_normalize_(value);

  const months = [
    'january',
    'february',
    'march',
    'april',
    'may',
    'june',
    'july',
    'august',
    'september',
    'october',
    'november',
    'december'
  ];

  for (
    let i = 0;
    i < months.length;
    i++
  ) {
    if (
      text === months[i] ||
      text ===
        months[i].slice(
          0,
          3
        )
    ) {
      return i;
    }
  }

  return -1;
}

function OV_isAllMonths_(
  value
) {
  return (
    OV_normalize_(
      value
    ) ===
    'all months'
  );
}

function OV_normalize_(
  value
) {
  return String(
    value || ''
  )
    .toLowerCase()
    .replace(
      /[\u2013\u2014]/g,
      '-'
    )
    .replace(
      /[^a-z0-9]+/g,
      ' '
    )
    .replace(
      /\s+/g,
      ' '
    )
    .trim();
}

function RUN_PARAGRAPHS() {
  return NDISPara_regenerateAll_();
}

function REGENERATE_SELECTED_PARAGRAPH() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss && ss.getActiveSheet();
  const range = sheet && sheet.getActiveRange();
  if (!sheet || sheet.getName() !== 'Shift Notes' || !range || range.getRow() < 2) {
    throw new Error('Select a response row on Shift Notes first.');
  }
  NDISPara_generateRow_(sheet, range.getRow(), true);
  CS4_markSheetChange_(sheet);
  CALENDAR_AND_SUPPORT_REFRESH(ss);
  return 'Selected note regenerated.';
}

function NDISPara_onFormSubmit(e) {
  const sheet = e && e.range
    ? e.range.getSheet()
    : NDISPara_getSheet_();

  if (!sheet) return;

  if (sheet.getName() !== "Shift Notes") return;

  const row = e && e.range
    ? e.range.getRow()
    : sheet.getLastRow();

  if (row > 1) {
    NOTES_captureInput_(sheet,row,row,e);
    NDISPara_generateRow_(sheet, row);
  }
}

function NDISPara_onShiftNotesEdit(e) {
  if (!e || !e.range) return;

  const sheet = e.range.getSheet();
  if (sheet.getName() !== "Shift Notes" || e.range.getRow() < 2) return;

  NOTES_captureInput_(sheet,e.range.getRow(),e.range.getLastRow(),e);
  const outputColumn = NDISPara_findOutputColumn_(sheet);

  if (
    e.range.getColumn() === outputColumn &&
    e.range.getLastColumn() === outputColumn
  ) {
    return;
  }

  const firstRow = Math.max(2, e.range.getRow());
  const lastRow = e.range.getLastRow();

  for (let row = firstRow; row <= lastRow; row++) {
    NDISPara_generateRow_(sheet, row, false, true);
  }
}

function NDISPara_regenerateAll_() {
  const sheet = NDISPara_getSheet_();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return 0;
  const outputColumn = NDISPara_findOutputColumn_(sheet);
  const values = sheet.getRange(1, 1, lastRow, sheet.getLastColumn()).getDisplayValues();
  const headerMap = NDISPara_headerMap_(values[0]);
  let count = 0;
  for (let i = 1; i < values.length; i++) {
    if (NDISPara_clean_(values[i][outputColumn - 1]) || NDISPara_rowBlank_(values[i], outputColumn - 1)) continue;
    if (NDISPara_writeRow_(sheet, i + 1, values[i], headerMap, outputColumn, false, false)) count++;
  }
  SpreadsheetApp.flush();
  if (count) CS4_markSheetChange_(sheet);
  return count;
}

function NDISPara_generateRow_(sheet, rowNumber, replaceExisting, refreshGenerated) {
  const outputColumn = NDISPara_findOutputColumn_(sheet);
  const width = sheet.getLastColumn();
  const headers = sheet.getRange(1, 1, 1, width).getDisplayValues()[0];
  const row = sheet.getRange(rowNumber, 1, 1, width).getDisplayValues()[0];
  return NDISPara_writeRow_(sheet, rowNumber, row, NDISPara_headerMap_(headers),
    outputColumn, replaceExisting === true, refreshGenerated === true);
}

function NOTES_captureInput_(sheet,first,last,e) {
  const width=sheet.getLastColumn(),headers=sheet.getRange(1,1,1,width).getDisplayValues()[0];
  const rows=sheet.getRange(first,1,last-first+1,width).getDisplayValues();
  if(e&&e.oldValue!==undefined&&first===last&&e.range.getColumn()===e.range.getLastColumn())
    NOTES_backupText_('Shift Notes prior input',sheet.getSheetId()+'!R'+first+'C'+e.range.getColumn(),String(e.oldValue));
  rows.forEach(function(row,i){
    const text=row.map((v,c)=>v?String(headers[c]||('Column '+(c+1)))+': '+v:'').filter(Boolean).join('\n');
    if(text)NOTES_backupText_('Shift Notes input',sheet.getSheetId()+'!R'+(first+i),text);
  });
}
function SC5_backupDetails_(key,cells) {
  const text=[cells[8],cells[9]].filter(Boolean).join('\n\n');
  if(text)NOTES_backupText_('Schedule Changes',key,text);
  return text;
}

var NOTES_HISTORY_CACHE = null;
function NOTES_backupText_(source, sourceId, text) {
  text=String(text||'');if(!text.trim())return;
  const hash=CS4_digest_(text),key=source+'|'+sourceId+'|'+hash;
  if(NOTES_HISTORY_CACHE&&NOTES_HISTORY_CACHE.seen[key])return;
  const lock=LockService.getDocumentLock()||LockService.getUserLock();
  if(!lock.tryLock(1000))throw new Error('Note history is busy. The note write was stopped to keep existing text.');
  try {
    if(!NOTES_HISTORY_CACHE) {
      const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
      let sheet=ss.getSheetByName('__NOTE_HISTORY__');
      if(!sheet) {
        sheet=ss.insertSheet('__NOTE_HISTORY__');
        sheet.getRange(1,1,1,5).setValues([['Saved at','Source','Source ID','Text hash','Note text']]);
        sheet.hideSheet();
      }
      const seen={},count=sheet.getLastRow()-1;
      if(count>0)sheet.getRange(2,2,count,3).getValues().forEach(row=>seen[row[0]+'|'+row[1]+'|'+row[2]]=true);
      NOTES_HISTORY_CACHE={sheet:sheet,seen:seen};
    }
    if(NOTES_HISTORY_CACHE.seen[key])return;
    const sheet=NOTES_HISTORY_CACHE.sheet,row=sheet.getLastRow()+1;
    if(row>sheet.getMaxRows())sheet.insertRowsAfter(sheet.getMaxRows(),row-sheet.getMaxRows());
    sheet.getRange(row,1,1,5).setValues([[new Date(),source,String(sourceId),hash,text]]);
    SpreadsheetApp.flush();NOTES_HISTORY_CACHE.seen[key]=true;
  }finally{lock.releaseLock();}
}

function NDISPara_writeRow_(sheet, rowNumber, row, headerMap, outputColumn, replaceExisting, refreshGenerated) {
  const cell = sheet.getRange(rowNumber, outputColumn);
  const current = String(cell.getDisplayValue() || '');
  const cellNote = String(cell.getNote() || '');
  const marker = cellNote.match(/^NDIA generated text hash: ([0-9a-f]+)$/m);
  if (!replaceExisting) {
    if (cell.getFormula()) return false;
    if (current && (!refreshGenerated || !marker || marker[1] !== CS4_digest_(current))) return false;
  }
  if (NDISPara_rowBlank_(row, outputColumn - 1)) return false;
  const text = NDISPara_buildNote_(row, headerMap, rowNumber);
  if (!text || (text === current && !replaceExisting)) return false;
  const userNote = cellNote.replace(/^NDIA generated text hash: [0-9a-f]+(?:\n|$)/gm, '').trim();
  const sourceId=sheet.getSheetId()+'!R'+rowNumber+'C'+outputColumn;
  if(current)NOTES_backupText_('Shift Notes',sourceId,current);
  NOTES_backupText_('Shift Notes',sourceId,text);
  if(String(cell.getDisplayValue()||'')!==current||String(cell.getNote()||'')!==cellNote)throw new Error('This note changed during generation. The newer note was kept.');
  cell.setValue(text).setWrap(true).setVerticalAlignment('top');
  cell.setNote((userNote ? userNote + '\n' : '') + 'NDIA generated text hash: ' + CS4_digest_(text));
  return true;
}

function NDISPara_getSheet_() {
  const ss = SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);

  const sheet = ss.getSheetByName("Shift Notes");

  if (!sheet) {
    throw new Error('Could not find "Shift Notes".');
  }

  return sheet;
}

function NDISPara_findOutputColumn_(sheet) {
  const headers = sheet
    .getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1))
    .getDisplayValues()[0];

  const accepted = [
    "generated paragraph",
    "generated note",
    "auto paragraph",
    "autoparagraph",
    "auto support paragraph",
    "auto support note",
    "ndia paragraph",
    "evidence paragraph"
  ];

  for (let index = 0; index < headers.length; index++) {
    if (
      accepted.indexOf(
        NDISPara_normaliseHeader_(headers[index])
      ) !== -1
    ) {
      return index + 1;
    }
  }

  const newColumn = sheet.getLastColumn() + 1;

  sheet
    .getRange(1, newColumn)
    .setValue("Generated Paragraph")
    .setFontWeight("bold");

  return newColumn;
}

function NDISPara_seed_(value) {
  let hash=2166136261;
  for(let i=0;i<value.length;i++)hash=Math.imul(hash^value.charCodeAt(i),16777619);
  hash=Math.imul(hash^(hash>>>16),0x85ebca6b);
  hash=Math.imul(hash^(hash>>>13),0xc2b2ae35);
  hash^=hash>>>16;
  return hash>>>0;
}
function NDISPara_variant_(options,seed,part) {
  return NDISPara_pick_(options,NDISPara_seed_(String(seed)+'|'+part));
}
function NDISPara_groups_(items,first,next,seed) {
  const values=NDISPara_unique_(items.filter(Boolean)),sentences=[];
  let previous='';
  for(let i=0;i<values.length;i+=3) {
    const options=i?next:first;
    const alternatives=options.filter(x=>x!==previous);
    const template=NDISPara_pick_(alternatives.length?alternatives:options,NDISPara_seed_(String(seed)+'|'+i));
    const chunk=values.slice(i,i+3);
    const list=chunk.length===2&&chunk.some(x=>/\band\b/.test(x))?chunk.join(', as well as '):NDISPara_list_(chunk);
    sentences.push(template.replace('{items}',list));
    previous=template;
  }
  return sentences.join(' ');
}
function NDISPara_choices_(value,starts) {
  const text=NDISPara_clean_(value);
  if(!text||NDISPara_emptyOrNo_(text))return [];
  const escaped=starts.map(x=>x.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'));
  return text.split(new RegExp(',\\s*(?=(?:'+escaped.join('|')+'))','i')).map(x=>x.trim()).filter(Boolean);
}
function NDISPara_freeText_(value,seed,part,source) {
  const text=NDISPara_clean_(value);
  if(!text||NDISPara_emptyOrNo_(text.replace(/[.!?]+$/,'')))return '';
  const body=NDISPara_sentence_(text);
  if(/^(?:also\b|by the way\b|worth(?:[- ]a)?[- ]mention|worth[- ]noting|(?:it is|it's|this is) worth|i(?: also)? (?:feel|noticed|picked up|want to mention)|just an observation|from what i saw|it caught my attention|(?:a|one) thing (?:that )?i noticed)/i.test(text))return body;

  const fullClause=/^(?:Georgia|G|They|She|He|I|We|It|This|That|There)\s+\S+/i.test(text)&&!/[?]/.test(text);
  const inline=body.replace(/^(They|Their|The|This|That|There|It|We|My|Our|She|He|A|An)\b/,word=>word.toLowerCase());
  const options=fullClause?[
    'Also, '+inline,
    'By the way, '+inline,
    'I also feel it needs to be documented that '+inline,
    'It is worth noting that '+inline,
    'This is worth a mention. '+body,
    'I also want to mention that '+inline
  ]:[
    'This is worth a mention. '+body,
    'I also feel this needs to be documented. '+body,
    'There is something else worth noting. '+body
  ];
  const directlyObserved=['directly observed','i directly observed it'].includes(NDISPara_normalise_(source));
  const observedClause=/^(?:Georgia|G|They|She|He)\s+(?:was|were|is|seemed|appeared|looked|walked|struggled|needed|found|had|kept|stopped|started|took|used|became|remained|ate|drank|coughed|slept|moved|spoke)\b/i.test(text);
  const reportedOrUncertain=/\b(?:said|says|told|reported|reports|mentioned|explained|according|thinks?|believes?|suspects?|guesses?|interpretation|apparently|perhaps|maybe|might|could|would|may|will|should|likely|possibly|probably|next|tomorrow|later|asked|please)\b/i.test(text);
  if(fullClause&&directlyObserved&&observedClause&&!reportedOrUncertain)options.push(
    'I noticed that '+inline,
    'A thing that I noticed was that '+inline,
    'Just an observation. '+body,
    'One thing I picked up on was that '+inline,
    'From what I saw, '+inline,
    'It caught my attention that '+inline
  );
  return NDISPara_variant_(options,seed,'free text '+part);
}
function PROJECT_writtenNoteTexts_(row, headerMap) {
  const seen = new Set();
  return PROJECT_WRITTEN_NOTE_HEADERS.map(function(title) {
    const index = headerMap[NDISPara_normaliseHeader_(title)];
    if (index === undefined) return '';
    const text = String(row[index] == null ? '' : row[index]).trim();
    const key = NDISPara_normalise_(text);
    if (!key || seen.has(key)) return '';
    seen.add(key);
    return text;
  }).filter(Boolean);
}

function NDISPara_buildNote_(row,headerMap,unusedRowSeed) {
  const get=(...names)=>NDISPara_get_(row,headerMap,...names);
  const tasks=get('What did you support Georgia to do?','What activities did you support Georgia with?');
  const difficulties=get('Which "disability-related" difficulties made support necessary?','Which disability-related difficulties made support necessary?','What happened that showed why support was needed?');
  const assistance=get('What was the highest level of assistance needed during this support period?','Assistance level');
  const enabled=get('What did the support enable Georgia to do that would otherwise not have happened?','What did this support enable?','What was Georgia able to do because of this support?');
  const risks=get('Without this support, what was likely to be affected?','What would have happened without support?');
  const regularity=get('How often is this type of support usually needed?','How regularly is this support needed?');
  const later=get('Were you concerned about any of these things after you left?','Were effects still present, or were consequences expected later?','Were there consequences later or the next day?');
  const outings=get('What outings did you support Georgia with?','Which outings did you support?');
  const appointment=get('Which appointment was supported?','Please specify any appointments Georgia attended.');
  const outingDetails=get('Please elaborate on any outing or appointment.','Outing or appointment details');
  const goals=get('Which silly NDIS goals could this support be seen as directly aiding and abetting?','Which NDIS goals did this support work towards?','Main goal','Goal');
  const source=get('How do you know the information recorded here?');
  const wellbeing=NDISPara_collectWellbeing_(row,headerMap);
  const seed=NDISPara_seed_([get('Timestamp'),get('Your name'),get('Date support was provided'),tasks,difficulties,assistance].join('|'));
  const sections={
    tasks:NDISPara_practicalParagraph_(tasks,'',seed),
    assistance:NDISPara_assistanceSentence_(assistance,seed),
    outing:NDISPara_communityParagraph_(outings,appointment,outingDetails,seed+11,source),
    need:NDISPara_needParagraph_(difficulties,regularity,seed+23),
    context:NDISPara_contextParagraph_(wellbeing,source,get('If pain was worse, what was mostly hurting','Pain location','Where was the pain?'),get('If mood was worse, what seemed the primarily reason','If mood was worse, what seemed the primary reason','What seemed to be affecting mood?'),seed+31),
    enabled:NDISPara_enabledParagraph_(enabled,seed+43,source),
    later:NDISPara_laterParagraph_(later,seed+47),
    outcome:NDISPara_outcomeParagraph_(risks,goals,seed+59)
  };
  const layouts=[
    [['tasks','assistance'],['outing'],['need','context'],['enabled'],['outcome'],['later']],
    [['need','assistance'],['tasks','outing'],['context'],['enabled','outcome'],['later']],
    [['context'],['need','assistance'],['tasks'],['outing','enabled'],['outcome'],['later']],
    [['assistance','tasks'],['context','need'],['outing'],['enabled'],['outcome','later']]
  ];
  const layout=NDISPara_variant_(layouts,seed,'layout');
  const paragraphs=layout.map(group=>group.map(key=>sections[key]).filter(Boolean).join(' '));
  const notes=PROJECT_writtenNoteTexts_(row,headerMap).filter(text=>!NDISPara_emptyOrNo_(text));
  notes.forEach((text,index)=>paragraphs.push(NDISPara_freeText_(text,seed+67+index,'worth noting',source)));
  return NDISPara_dedupe_(paragraphs.filter(Boolean)).join('\n\n').replace(/[ \t]+\n/g,'\n').trim();
}
function NDISPara_practicalParagraph_(value,assistanceLevel,seed) {
  let text=NDISPara_clean_(value),tasks=[];
  text=text.replace(/planning, administration or appointments/ig,'appointment administration');
  const map=[
    [/^(food preparation|made food|prepare food|meal preparation|cooking)$/i,'preparing food'],
    [/^(cleaning or tidying)$/i,'household cleaning tasks'],
    [/^cleaning$/i,'cleaning'],[/^tidying$/i,'tidying'],
    [/^(laundry|washing clothes)$/i,'laundry'],[/^(dishes|washing up)$/i,'washing dishes'],
    [/^(took out rubbish\/recycling|rubbish or recycling)$/i,'rubbish and recycling'],
    [/^(rubbish|bins)$/i,'taking out rubbish'],[/^recycling$/i,'recycling'],
    [/^(changing linen|changed sheets|change sheets|bed linen)$/i,'changing the sheets'],
    [/^(helped with eating and drinking|eating and drinking)$/i,'eating and drinking'],
    [/^eating or drinking support$/i,'mealtime support'],[/^eating$/i,'eating'],[/^drinking$/i,'drinking'],
    [/^self[- ]care$/i,'self care'],[/^medication(?: routine)?$/i,'the medication routine'],
    [/^(admin|administration|paperwork|appointment administration)$/i,'administrative tasks'],
    [/^planning$/i,'planning'],[/^organi[sz]ing$/i,'organising'],
    [/^(kept routines going|keeping routines going)$/i,'daily routines'],
    [/^communication or decision support$/i,'communication and decision support'],
    [/^communication$/i,'communication'],[/^decision support$/i,'decision making'],
    [/^emotional regulation(?: or social connection| oocial connection)$/i,'emotional regulation or social connection'],
    [/^emotional regulation$/i,'emotional regulation'],
    [/^social connection$/i,'social connection'],
    [/^(looked after myra|looking after myra)$/i,'looking after Myra'],
    [/^(got georgia out of the house|leaving home or community access)$/i,'getting out of the house'],
    [/^(appointment|appointments|support in appointments)$/i,'appointment support'],
    [/^work$/i,'work tasks'],[/^professional activity$/i,'professional activities'],
    [/^social activity$/i,'social activities'],[/^community activity$/i,'community activities'],
    [/^saw family$/i,'seeing family'],[/^bought groceries$/i,'grocery shopping'],
    [/^ran errands$/i,'errands']
  ];
  const extra=[];
  NDISPara_split_(text).forEach(item=>{
    if(NDISPara_emptyOrNo_(item)||/^other$/i.test(item))return;
    const match=map.find(pair=>pair[0].test(item));
    if(match)tasks.push(match[1]);else extra.push(item);
  });
  function combine(a,b,c){if(tasks.includes(a)&&tasks.includes(b)){const index=Math.min(tasks.indexOf(a),tasks.indexOf(b));tasks=tasks.filter(x=>x!==a&&x!==b);tasks.splice(index,0,c);}}
  combine('cleaning','tidying','cleaning and tidying');
  combine('eating','drinking','eating and drinking');
  combine('taking out rubbish','recycling','rubbish and recycling');
  const taskWords={
    'cleaning and tidying':['cleaning and tidying','household cleaning and tidying'],
    'washing dishes':['washing dishes','the dishes','washing up'],
    'preparing food':['preparing food','food preparation'],
    'changing the sheets':['changing the sheets','changing bed linen'],
    'administrative tasks':['administrative tasks','admin tasks'],
    'looking after Myra':['looking after Myra','caring for Myra']
  };
  tasks=NDISPara_unique_(tasks).map(task=>taskWords[task]?NDISPara_variant_(taskWords[task],seed,'task '+task):task);
  const sentences=[NDISPara_groups_(tasks,
    ['I helped Georgia with {items}.','During the shift, I supported Georgia with {items}.','I provided practical help with {items}.','My support covered {items}.','The tasks I helped Georgia with included {items}.','Georgia had my help with {items}.'],
    ['I also helped with {items}.','Further support covered {items}.','The shift also included {items}.','I provided help with {items} as well.'],seed)];
  const help=NDISPara_assistanceSentence_(assistanceLevel,seed);
  if(help)sentences.push(help);
  if(extra.length)sentences.push(NDISPara_sentence_(extra.join(', ')));
  return NDISPara_dedupe_(sentences.filter(Boolean)).join(' ');
}
function NDISPara_assistanceSentence_(assistanceLevel,seed) {
  const level=NDISPara_normalise_(assistanceLevel);
  // The form uses a 1 to 10 linear scale. Keep historical text answers supported below.
  if (/^(?:[1-9]|10)$/.test(level)) {
    return 'The highest level of assistance needed was rated ' + level +
      ' out of 10, where 1 means very minimal assistance and 10 means full assistance.';
  }
  const levels=[
    [/doing almost everything/,[
      'Georgia had very little capacity to move and think, so I carried out almost all tasks.',
      'I did almost everything because Georgia had very limited capacity for movement and thinking.',
      'Almost all tasks needed to be done for Georgia because their capacity to move and think was very limited.',
      'With very little capacity for movement and thinking, Georgia needed me to carry out almost everything.'
    ]],
    [/doing most essential things/,[
      'Georgia had very little capacity, so I completed most essential tasks.',
      'I took care of most essential tasks because Georgia had very limited capacity.',
      'Most essential tasks needed to be done for Georgia because their capacity was very limited.',
      'With very little capacity available, Georgia needed me to do most essential things.'
    ]],
    [/taking over parts/,[
      'I took over parts of tasks to help Georgia conserve energy.',
      'To reduce the energy Georgia needed to use, I completed parts of tasks for them.',
      'Georgia could conserve energy because I took responsibility for parts of the tasks.'
    ]],
    [/helping physically/,[
      'I gave physical assistance to reduce the effort tasks took.',
      'Physical help reduced how much effort Georgia needed for the tasks.',
      'I helped with the physical parts of tasks so they took less out of Georgia.'
    ]],
    [/staying close when/,[
      'I stayed close because injury and swallowing risks were higher.',
      'Higher risks with swallowing and injury meant I needed to stay close.',
      'Georgia needed me nearby because of increased injury and swallowing risks.'
    ]],
    [/keeping routines/,[
      'I helped keep routines and essential tasks going.',
      'My assistance kept daily routines and essential tasks going.',
      'Georgia needed help to continue their routines and essential tasks.'
    ]],
    [/getting georgia started/,[
      'I helped Georgia get started with basic tasks.',
      'Georgia needed assistance to begin basic tasks.',
      'My support helped Georgia make a start on basic tasks.'
    ]],
    [/occasional prompting|prompting only/,[
      'Georgia needed occasional prompting.',
      'I provided prompts from time to time.',
      'Prompts were needed occasionally during the support period.'
    ]],
    [/step-by-step planning|sequencing/,[
      'I helped Georgia plan tasks and work through them step by step.',
      'Georgia needed help planning each task and working out the sequence.',
      'My assistance involved breaking tasks into steps and planning their order.'
    ]],
    [/mixed assistance|shared|intermittent/,[
      'Georgia needed a mix of prompting and practical assistance.',
      'I combined prompts with practical help.',
      'Support involved both prompting and practical assistance.'
    ]],
    [/tasks done for georgia|tasks done for geogia|worker completed|most or all/,[
      'I completed tasks for Georgia.',
      'Tasks were carried out for Georgia.',
      'I provided support by doing tasks for Georgia.'
    ]],
    [/continuous|supervision/,[
      'The assistance level was recorded as continuous support or supervision.',
      'Continuous support or supervision was the recorded level of assistance.'
    ]]
  ];
  const match=levels.find(pair=>pair[0].test(level));
  if(match)return NDISPara_variant_(match[1],seed,'assistance');
  return level&&!NDISPara_emptyOrNo_(level)?'The recorded assistance level was '+NDISPara_sentenceFragment_(NDISPara_lowerFirst_(assistanceLevel))+'.':'';
}
function NDISPara_communityParagraph_(value,appointment,details,seed,source) {
  const actions=[],extra=[];
  const mapping=[[/walked? myra/i,'walk Myra'],[/ran errands|run errands/i,'run errands'],[/bought groceries|groceries/i,'buy groceries'],[/saw family/i,'see family'],[/saw friends/i,'see friends'],[/social activity/i,'take part in a social activity'],[/community activity/i,'take part in a community activity'],[/work|professional activity/i,'take part in work activities'],[/interstate flight/i,'take an interstate flight']];
  NDISPara_split_(value).forEach(item=>{if(/^other$/i.test(item)||NDISPara_emptyOrNo_(item))return;const match=mapping.find(x=>x[0].test(item));if(match)actions.push(match[1]);else extra.push(item);});
  const sentences=[NDISPara_groups_(actions,['I supported Georgia to {items}.','The shift included support to {items}.'],['I also supported Georgia to {items}.','Further support helped Georgia {items}.'],seed)];
  if(appointment&&!NDISPara_emptyOrNo_(appointment)&&!/^other$/i.test(appointment)) {
    const appt=NDISPara_cleanAppointment_(appointment);
    sentences.push(NDISPara_pick_(['I supported Georgia with '+appt+'.','I helped Georgia during '+appt+'.'],seed+7));
  }
  if(extra.length)sentences.push(NDISPara_freeText_(extra.join(', '),seed,'other outing',source));
  if(details&&!NDISPara_emptyOrNo_(details))sentences.push(NDISPara_freeText_(details,seed,'outing details',source));
  return sentences.filter(Boolean).join(' ');
}
function NDISPara_needParagraph_(value,regularity,seed) {
  const items=NDISPara_choices_(value,['Everyday tasks','Physical exhaustion','Pain limiting','Communication requiring','Swallowing becoming','Reduced capacity','Overwhelm increasing','Movement and thinking','Physical:','Cognitive:','Communication:','Sensory:','Emotional regulation:','Social:']);
  const mapping=[
    [/^everyday tasks/,'tasks taking longer and causing physical strain'],
    [/^physical exhaustion/,'physical exhaustion affecting self care and safety'],
    [/^pain limiting/,'pain limiting everyday activities'],
    [/^communication requiring/,'communication taking much more effort'],
    [/^swallowing becoming/,'reduced control of swallowing'],
    [/^reduced capacity/,'reduced capacity for thinking and planning'],
    [/^overwhelm increasing/,'overwhelm increasing pain and reducing stamina'],
    [/^movement and thinking/,'significantly reduced movement and thinking'],
    [/^physical:.*(?:fatigue|stamina)/,'fatigue and stamina difficulties'],
    [/^physical:/,'physical difficulties affecting everyday tasks'],
    [/^cognitive:.*initiation/,'difficulty getting started and organising tasks'],
    [/^cognitive:/,'difficulty processing information and keeping track of tasks'],
    [/^communication:.*(?:eating|swallowing)/,'difficulties with eating and drinking safely'],
    [/^communication:/,'communication difficulties'],
    [/^sensory:/,'sensory difficulties'],
    [/^emotional regulation:/,'difficulty with emotional regulation'],
    [/^social:/,'difficulty with social connection and participation']
  ];
  const needs=[],extra=[];
