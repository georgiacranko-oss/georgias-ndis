    });
    let operations=0;const available=()=>operations<SYNC6.limit&&Date.now()-started<Math.min(SYNC6.budgetMs,180000);
    plans.forEach(function(plan){
      if(deferred[plan.item.key]||!available()){report.pending++;return;}
      const {item,match,record}=plan,resource=S6_resource_(item,match,record),props=match&&match.event.extendedProperties&&match.event.extendedProperties.private||{};
      const same=match&&S6_eventHash_(match.event)===S6_eventHash_(resource)&&props.managedBy==='SYNC6'&&props.sourceKey===item.key;
      if(!same&&!available()){report.pending++;return;}
      try {
        let event=match&&match.event;
        if(!same){
          if(!match&&plan.uncertain)throw new Error('Uncertain worker/day match. No new event was created.');
          operations++;event=S6_write_(item,match,resource,record,registry,labels,!!options.restore,reserved,!!options.fromSheets);
          if(!match&&record.phase==='pending')report.created++;else report.updated++;
          reserved[event.id]=true;
        }
        S6_ack_(t,item,event,registry,record);
        const retained=S6_event_(event,labels);
        const oldIndex=events.findIndex(e=>e.id===event.id);if(oldIndex>=0)events[oldIndex]=retained;else events.push(retained);
        plan.duplicates.forEach(function(duplicate){
          if(reserved[duplicate.id])return;if(!available()){report.pending++;return;}
          const raw=duplicate.event;
          const managed=duplicate.owned||(raw.extendedProperties&&raw.extendedProperties.private&&raw.extendedProperties.private.managedBy==='SYNC6');
          if(!managed||(raw.attendees||[]).length||(raw.attachments||[]).length||raw.location)return;
          const fresh=S6_call_(()=>Calendar.Events.get(CS4.calendarId,duplicate.id,{eventLabelVersion:1}));
          const kept=S6_call_(()=>Calendar.Events.get(CS4.calendarId,event.id,{eventLabelVersion:1}));
          const freshProps=fresh.extendedProperties&&fresh.extendedProperties.private||{};
          const freshItem=S6_event_(fresh,labels),keptItem=S6_event_(kept,labels);
          if(!freshItem||!keptItem||!CS4_sameSlot_(freshItem,keptItem)||S6_kind_(freshItem.type)!==S6_kind_(keptItem.type)||
             (fresh.attendees||[]).length||(fresh.attachments||[]).length||fresh.location||
             ![CS4.owner,'SYNC6','CALSYNC3','CALSYNC2','CALSYNC'].includes(freshProps.managedBy))return;
          const combined=S6_duplicateDescription_(kept.description,fresh.description);
          if(combined!==String(kept.description||'')) {
            if(!available()){report.pending++;return;}
            operations++;
            event=S6_patchPreservingNotes_(item,event.id,Object.assign({},resource,{description:combined}),record);
            S6_ack_(t,item,event,registry,record);
          } else event=kept;
          if(S6_hasDescriptionNotes_(fresh.description)&&!S6_normal_(event.description).includes(S6_normal_(fresh.description)))return;
          if(!available()){report.pending++;return;}
          operations++;S6_call_(()=>Calendar.Events.remove(CS4.calendarId,duplicate.id));report.removed++;reserved[duplicate.id]=true;
        });
      }catch(err){record.error=String(err);if(/Note history is busy/i.test(String(err)))report.pending++;if(record.phase!=='pending'&&record.phase!=='deleted')record.phase='blocked';S6_save_(registry,record);report.blocked.push(item.person+' '+item.day+': '+String(err));}
    });
    // Only remove explicitly hidden source events or obsolete events owned by this engine.
    events.forEach(function(e){
      if(reserved[e.id]||e.day<CS4.start||e.day>=CS4.end||!available())return;
      if(e.owned) {
        const warning=S6_clearMissingWarning_(e.event,labels);
        if(warning) {
          const fresh=S6_call_(()=>Calendar.Events.get(CS4.calendarId,e.id,{eventLabelVersion:1}));
          const patch=S6_clearMissingWarning_(fresh,labels);
          if(patch) {
            if(S6_hasDescriptionNotes_(fresh.description))NOTES_backupText_('Google Calendar',e.id,fresh.description);
            operations++;S6_call_(()=>Calendar.Events.patch(patch,CS4.calendarId,e.id,{eventLabelVersion:1}));report.updated++;
          }
        }
      }
      if(report.blocked.length)return;
      const hidden=changes.some(c=>!c.show&&(c.id===e.id||c.key===e.key));
      const source=Object.values(registry.records).find(r=>r.id===e.id);
      const obsolete=(source&&e.event.extendedProperties&&e.event.extendedProperties.private&&e.event.extendedProperties.private.managedBy==='SYNC6'&&!items.some(i=>i.key===source.key))||
        S6_isSuppressedSupport_(e,changes,notes);
      const hasNotes=!!notes.index[e.day+'|'+CS4_name_(e.person)];
      if((hidden||obsolete)&&!hasNotes&&!S6_hasDescriptionNotes_(e.event.description)&&!S6_hasDescriptionNotes_(source&&source.lastDescription)){const fresh=S6_call_(()=>Calendar.Events.get(CS4.calendarId,e.id,{eventLabelVersion:1}));if(S6_hasDescriptionNotes_(fresh.description)||(fresh.attendees||[]).length||(fresh.attachments||[]).length||fresh.location)return;operations++;S6_call_(()=>Calendar.Events.remove(CS4.calendarId,e.id));report.removed++;if(source){source.phase='deleted';S6_save_(registry,source);}}
    });
    SC5_REFRESH_(ss);
    const p=PropertiesService.getScriptProperties();
    p.setProperty('S6_VIEW_PENDING',String(Date.now()));
    if((Number(p.getProperty('S6_SHEET_AT'))||0)<=started)p.deleteProperty('S6_SHEET_AT');if((Number(p.getProperty('S6_CAL_AT'))||0)<=started)p.deleteProperty('S6_CAL_AT');p.setProperty('S6_PENDING',report.pending||Object.values(registry.records).some(r=>r.phase==='pending')?'1':'0');p.setProperty('S6_LAST_DAY',CS4_date_(new Date()));
    try {S6_report_(ss,report,!!options.fromSheets);}
    catch(error){Logger.log('Sync progress saved. The status sheet could not refresh. '+String(error));}
    if(options.fromSheets&&!report.pending)p.deleteProperty('S6_FROM_SHEETS');
    const message='Calendar sync. Imported '+report.imported+'. Updated '+report.updated+'. Created '+report.created+'. Removed '+report.removed+'. Pending '+report.pending+'. Needs review '+report.blocked.length+'.';
    Logger.log(message);report.blocked.forEach(x=>Logger.log(x));return message;
  }finally{lock.releaseLock();}
}
function S6_isSuppressedSupport_(event, changes, notes) {
  if(!event.owned||!CS4_supportKind_(event.type)||!CS4_status_(event,changes))return false;
  if(notes.index[event.day+'|'+CS4_name_(event.person)])return false;
  const raw=event.event||{};
  return !(raw.attendees||[]).length&&!(raw.attachments||[]).length&&!raw.location;
}



function CS4_UPDATE() {return S6_sync_({importCalendar:true});}
function CS4_SYNC_FROM_SHEETS() {
  PropertiesService.getScriptProperties().setProperty('S6_FROM_SHEETS','1');
  return S6_sync_({importCalendar:false,fromSheets:true});
}
function CS4_syncNow_(importCalendar,importOnly) {return S6_sync_({importCalendar:importCalendar!==false,importOnly:!!importOnly});}
function CS4_markSheetChange_(sheet) {
  if(!sheet||!['Regular Shifts','Schedule Changes','Shift Notes'].includes(sheet.getName()))return;
  PropertiesService.getScriptProperties().setProperty('S6_SHEET_AT',String(Date.now()));
  CALENDAR_queueChange_();
}
function CALENDAR_queueChange_(delay) {
  const p=PropertiesService.getScriptProperties();
  if(p.getProperty('CALENDAR_PAUSED')==='1')return;
  if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='CALENDAR_PROCESS_PENDING'))
    ScriptApp.newTrigger('CALENDAR_PROCESS_PENDING').timeBased().after(delay||120000).create();
}
function CALENDAR_PROCESS_PENDING() {
  ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='CALENDAR_PROCESS_PENDING').forEach(t=>ScriptApp.deleteTrigger(t));
  try {return CS4_POLL();}
  finally {
    const p=PropertiesService.getScriptProperties();
    if(p.getProperty('S6_SHEET_AT')||p.getProperty('S6_CAL_AT')||p.getProperty('S6_PENDING')==='1'||p.getProperty('S6_DELTA_PENDING')==='1'||p.getProperty('S6_VIEW_PENDING'))CALENDAR_queueChange_();
  }
}

function CS4_POLL() {
  if(PropertiesService.getScriptProperties().getProperty('CALENDAR_PAUSED')==='1')return 'Calendar automation is paused.';
  const lock=LockService.getUserLock();if(!lock.tryLock(0))return 'Another calendar check is running.';
  try {
    const p=PropertiesService.getScriptProperties(),now=Date.now();
    if(p.getProperty('S6_NOTE_REPAIR'))return REPAIR_ALL_CALENDAR_NOTES();
    if(p.getProperty('S6_NOTE_RESTORE_PENDING'))return RESTORE_MISSING_SUPPORT_NOTES();
    if(p.getProperty('CALWARN_REQUESTED')==='1'||p.getProperty('CALWARN_PROGRESS_V1'))return CLEAR_CALENDAR_NOTE_WARNINGS();
    if(p.getProperty('S6_DELTA_PENDING')==='1'||p.getProperty('S6_DELTA_PROGRESS'))CALENDAR_onUpdate();
    const latest=Math.max(Number(p.getProperty('S6_SHEET_AT'))||0,Number(p.getProperty('S6_CAL_AT'))||0);
    if(latest&&now-latest<120000){CALENDAR_queueChange_();return 'Waiting for two minutes without further changes.';}
    const daily=p.getProperty('S6_LAST_DAY')!==CS4_date_(new Date());
    if(!latest&&!daily&&p.getProperty('S6_PENDING')!=='1') {
      if(p.getProperty('S6_VIEW_PENDING'))return REFRESH_CALENDAR_VIEWS();
      return 'No calendar changes.';
    }
    return p.getProperty('S6_FROM_SHEETS')==='1'?CS4_SYNC_FROM_SHEETS():CS4_UPDATE();
  }finally{lock.releaseLock();}
}
function CALENDAR_onUpdate(e) {
  if(PropertiesService.getScriptProperties().getProperty('CALENDAR_PAUSED')==='1')return 'Calendar automation is paused.';
  if(e&&e.calendarId&&e.calendarId!==CS4.calendarId)return 'Different calendar. No update queued.';
  const p=PropertiesService.getScriptProperties(),lock=LockService.getScriptLock();
  const progressKey='S6_DELTA_PROGRESS',pendingKey='S6_DELTA_PENDING';
  p.setProperty(pendingKey,'1');
  if(e){CALENDAR_queueChange_();return 'Calendar notification queued for the next change check.';}
  if(!lock.tryLock(1000))return 'Calendar change check is queued.';
  try {
    let state;try{state=JSON.parse(p.getProperty(progressKey)||'null');}catch(error){state=null;}
    if(!state||state.calendarId!==CS4.calendarId)state={calendarId:CS4.calendarId,syncToken:p.getProperty('S6_DELTA_TOKEN')||'',pageToken:'',changed:false};
    const labels=CS4_labels_();
    const started=Date.now();let pages=0,restarted=false;
    while(pages<10&&Date.now()-started<90000) {
      const request={showDeleted:true,maxResults:500,eventLabelVersion:1};
      if(state.syncToken)request.syncToken=state.syncToken;
      if(state.pageToken)request.pageToken=state.pageToken;
      let page;
      try{page=S6_call_(()=>Calendar.Events.list(CS4.calendarId,request));}
      catch(error){
        if(state.syncToken&&!restarted&&/410|sync.?token|expired|gone/i.test(String(error))) {
          p.deleteProperty('S6_DELTA_TOKEN');state.syncToken='';state.pageToken='';restarted=true;
          p.setProperty(progressKey,JSON.stringify(state));continue;
        }
        throw error;
      }
      (page.items||[]).forEach(function(raw){
        const props=raw.extendedProperties&&raw.extendedProperties.private||{};
        // A stored hash must never hide an old Missing Notes warning.
        const warning=!!S6_clearMissingWarning_(raw,labels);
        if(!warning&&raw.status!=='cancelled'&&props.managedBy==='SYNC6'&&props.s6Hash===S6_eventHash_(raw))return;
        state.changed=true;
      });
      pages++;state.pageToken=page.nextPageToken||'';
      if(state.changed) {
        p.setProperty('S6_CAL_AT',String(Date.now()));p.setProperty('S6_PENDING','1');
        CALENDAR_queueChange_();
      }
      if(!state.pageToken) {
        if(!page.nextSyncToken)throw new Error('Calendar returned no final sync token. Change check will retry.');
        p.setProperty('S6_DELTA_TOKEN',page.nextSyncToken);
        p.deleteProperty(progressKey);p.deleteProperty(pendingKey);
        return state.changed?'Calendar update and both cleanups are queued.':'No external calendar changes.';
      }
      p.setProperty(progressKey,JSON.stringify(state));
    }
    return 'Calendar change check saved its progress and will continue automatically.';
  }catch(error){p.setProperty('S6_CAL_AT',String(Date.now()));p.setProperty('S6_PENDING','1');throw error;}
  finally{lock.releaseLock();}
}
function CS4_INSTALL_POLL_TRIGGER() {
  ScriptApp.getProjectTriggers().forEach(t=>{if(['CS4_POLL','CALENDAR_AND_SUPPORT_REFRESH'].includes(t.getHandlerFunction()))ScriptApp.deleteTrigger(t);});
  ScriptApp.newTrigger('CS4_POLL').timeBased().atHour(8).nearMinute(15).everyDays(1).inTimezone(PROJECT_TIME_ZONE).create();
  return 'Daily calendar check installed. Edits and submissions queue a separate check.';
}

function CALENDAR_RESTORE_MISSING() {return S6_sync_({importCalendar:true,restore:true});}
function CS4_RESTORE_REPORTED_EVENTS() {return CALENDAR_RESTORE_MISSING();}
function CALENDAR_SETUP() {
  const lock=LockService.getScriptLock();if(!lock.tryLock(10000))return 'Another workbook process is running. Run CALENDAR_SETUP again after it finishes.';
  try {
    const ss=SpreadsheetApp.openById(CS4.spreadsheetId);S6_registry_(ss);
    ScriptApp.getProjectTriggers().forEach(function(t){const h=t.getHandlerFunction();if(/^(?:CALSYNC\d*_|CS[123]_)/.test(h)||['CS4_POLL','SC5_REPAIR','SC5_onChange','CALENDAR_onUpdate','CALENDAR_AND_SUPPORT_REFRESH'].includes(h))ScriptApp.deleteTrigger(t);});
    CS4_INSTALL_POLL_TRIGGER();
    ScriptApp.newTrigger('CALENDAR_onUpdate').forUserCalendar(CS4.calendarId).onEventUpdated().create();
    ['PROJECT_onEdit','PROJECT_onFormSubmit'].forEach(function(h){let kept=false;const expected=h==='PROJECT_onEdit'?ScriptApp.EventType.ON_EDIT:ScriptApp.EventType.ON_FORM_SUBMIT;
      ScriptApp.getProjectTriggers().forEach(function(t){if(t.getHandlerFunction()!==h)return;const valid=t.getTriggerSourceId()===ss.getId()&&t.getEventType()===expected;if(kept||!valid)ScriptApp.deleteTrigger(t);else kept=true;});
      if(!kept){const b=ScriptApp.newTrigger(h).forSpreadsheet(ss);if(h==='PROJECT_onEdit')b.onEdit().create();else b.onFormSubmit().create();}
    });
    ScriptApp.newTrigger('SC5_onChange').forSpreadsheet(ss).onChange().create();
    SC5_UPDATE_INPUTS_(ss);SC5_REFRESH_(ss);
    const p=PropertiesService.getScriptProperties();['CS4_PENDING_SYNC','CS4_CALENDAR_SYNC_TOKEN','CS4_SHEET_CHANGE_AT','CS4_CALENDAR_CHANGE_AT'].forEach(k=>p.deleteProperty(k));p.deleteProperty('S6_DELTA_TOKEN');p.deleteProperty('S6_DELTA_PROGRESS');p.deleteProperty('S6_DELTA_PENDING');p.setProperty('S6_SHEET_AT',String(Date.now()));
    CALENDAR_queueChange_();
    return p.getProperty('CALENDAR_PAUSED')==='1'?'Daily and change checks installed. Calendar automation remains paused.':'Daily and change checks installed. Automatic sync starts after two quiet minutes.';
  }finally{lock.releaseLock();}
}
