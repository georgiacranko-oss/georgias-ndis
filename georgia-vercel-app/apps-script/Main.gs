    'reduced social connection':'Georgia could have had less social connection',
    'reduced capacity for work and creative activities':'Georgia could have had less capacity for work and creative activities',
    'needing more support later':'Georgia could have needed more support later',
    'greater fatigue':'fatigue could have increased',
    'administrative tasks remaining unfinished':'administrative tasks could have remained unfinished',
    'reduced physical wellbeing':'Georgia\'s physical wellbeing could have deteriorated'
  };
  const sentences=[NDISPara_variant_([false,true],seed,'risk style')?
