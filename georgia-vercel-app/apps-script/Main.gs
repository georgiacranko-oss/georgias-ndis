// The public entrypoint serves no notes or spreadsheet data.
function doGet(e) {
  const configured=String(PropertiesService.getScriptProperties().getProperty('SUPPORT_WEB_SITE_URL')||'');
  if(!/^https:\/\/[a-z0-9-]+\.pages\.dev\/?$/i.test(configured)) {
    return ContentService.createTextOutput('The support website connection is not configured yet.');
  }
  const row=Number(e&&e.parameter&&(e.parameter.noteRow||e.parameter.row));
  const target=configured.replace(/\/$/,'')+'/app.html'+(Number.isInteger(row)&&row>=2?'?noteRow='+row:'');
  return HtmlService.createHtmlOutput('<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"></head><body><p>The support app has moved.</p><p><a target="_top" href="'+target+'">Open Georgia’s Support App</a></p></body></html>');
}

