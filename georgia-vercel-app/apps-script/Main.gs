    const message=apply?'Schedule export. '+verified+'/'+jobs.length+' verified, '+updated+' updated, '+remaining+' remaining. Original note paragraphs preserved.'+(remaining?' Remaining entries continue automatically.':''):'Schedule export preview. '+jobs.length+' saved rows matched. No calendar changes made.';
    Logger.log(message);ss.toast(message);return message;
