function S6_write_(item,match,resource,record,registry,labels,restore,reserved,allowMissing) {
  if(match)return S6_patchPreservingNotes_(item,match.id,resource,record);
  const id=record.id||item.id||'cs6'+CS4_digest_(CS4.calendarId+'|'+item.key);
  if(S6_hasDescriptionNotes_(resource.description))NOTES_backupText_('Google Calendar',id,resource.description);
  let saved=null;
  try{saved=S6_call_(()=>Calendar.Events.get(CS4.calendarId,id,{eventLabelVersion:1}));}
  catch(err){if(!CS4_notFound_(err))throw err;}
  if(saved&&saved.status!=='cancelled') {
    if(reserved[id])throw new Error('The saved event is already assigned to another shift.');
    const props=saved.extendedProperties&&saved.extendedProperties.private||{};
    if(props.managedBy==='SYNC6'&&props.sourceKey!==item.key)throw new Error('The saved event belongs to another source.');
    return S6_patchPreservingNotes_(item,id,resource,record);
  }
  if(saved&&saved.status==='cancelled'&&!restore){record.phase='deleted';throw new Error('Saved event was deleted. Use CALENDAR_RESTORE_MISSING to restore the same ID.');}
  // Check the live calendar again immediately before either creation or restoration.
  const live=S6_liveForItem_(item,labels),found=S6_match_(item,live,registry,reserved);
  if(found.event)return S6_patchPreservingNotes_(item,found.event.id,resource,record);
  if(found.uncertain)throw new Error('Another event for this worker and day needs review. No new event was created.');
  if(saved&&saved.status==='cancelled')return S6_patchPreservingNotes_(item,id,Object.assign({},resource,{status:'confirmed'}),record);
  if((record.id||item.id)&&record.phase!=='pending'&&!allowMissing)throw new Error('Saved event ID cannot be found. No replacement was created.');
  record.id=id;record.phase='pending';record.key=item.key;record.model=S6_model_(item);S6_save_(registry,record);
  resource.id=id;
  try{return S6_call_(()=>Calendar.Events.insert(resource,CS4.calendarId,{eventLabelVersion:1}));}
  catch(err){
    if(!/409|already exists|duplicate/i.test(String(err)))throw err;
    const existing=S6_call_(()=>Calendar.Events.get(CS4.calendarId,id,{eventLabelVersion:1}));
    const props=existing.extendedProperties&&existing.extendedProperties.private||{};
    if(existing.status==='cancelled'||props.sourceKey!==item.key)throw new Error('Event ID conflict. No replacement was created.');
    return S6_patchPreservingNotes_(item,id,resource,record);
  }
}
function S6_needsNoteLabel_(event,type) {
