    if(typeof Calendar==='undefined'||!Calendar.Events)throw new Error('Enable the Google Calendar API service.');
    const ss=SpreadsheetApp.openById(CS4.spreadsheetId),t=CS4_table_(ss),labels=CS4_labels_(),registry=S6_registry_(ss);
    const input=ss.getSheetByName('Schedule Changes');
