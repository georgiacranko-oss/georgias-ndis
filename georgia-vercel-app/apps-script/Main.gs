function HANDOVER_findNextVisitor_(ss,regular,shiftNotes,supportDate,submittedBy) {
  const supportDay=HANDOVER_dateKey_(supportDate);if(!supportDay)return null;
  const endDay=CS4_addDay_(supportDay,36),submittedNameKey=CS4_name_(submittedBy);
  const changes=CS4_readChanges_(CS4_table_(ss),false);
  const unique={};
  const visits=CS4_roster_(ss,changes,supportDay,endDay)
    .concat(changes.filter(i=>i.show&&['Additional','Changed'].includes(i.type)))
    .filter(i=>i.day>=supportDay&&i.day<endDay&&CS4_supportKind_(i.type)&&!CS4_status_(i,changes)&&!CS4_replaced_(i,changes))
    .filter(i=>{const key=CS4_signature_(i);if(unique[key])return false;unique[key]=true;return true;});
  const current=visits.filter(i=>i.day===supportDay&&CS4_name_(i.person)===submittedNameKey);
  // Without one verified shift end, do not guess which same-day visitor comes next.
  const cutoff=current.length===1&&!current[0].allDay&&current[0].end
    ?current[0].end:CS4_instant_(CS4_addDay_(supportDay,1),'00:00');
  const next=visits.filter(i=>CS4_name_(i.person)!==submittedNameKey&&!i.allDay&&i.start&&i.start>=cutoff)
    .sort((a,b)=>a.start-b.start||(a.row||0)-(b.row||0))[0];
  return next?{name:next.person,date:next.start,dateKey:next.day}:null;
}

function HANDOVER_findHeaderColumn_(headers, acceptedTitles) {
  const wanted = acceptedTitles.map(function(title) {
    return HANDOVER_normaliseHeader_(title);
  });

  for (let i = 0; i < headers.length; i++) {
    if (
      wanted.indexOf(
        HANDOVER_normaliseHeader_(headers[i])
      ) !== -1
    ) {
      return i + 1;
    }
  }

  return 0;
}

function HANDOVER_normaliseHeader_(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/[“”]/g, '"')
    .replace(/[’]/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function HANDOVER_normaliseName_(value) {
  return CS4_name_(value);
}

function HANDOVER_dateKey_(value) {
  if (!(value instanceof Date) || isNaN(value.getTime())) {
    return '';
  }

  return Utilities.formatDate(
    value,
    PROJECT_TIME_ZONE,
    'yyyy-MM-dd'
  );
}

function HANDOVER_escapeHtml_(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function CHECK_HANDOVER_EMAILS() {
  const ss = SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
  const regular = ss.getSheetByName('Regular Shifts');

  if (!regular) {
    throw new Error('Regular Shifts sheet is missing.');
  }

  const roster = GCAL4_getRegularRoster_(regular);
  const names = {};

  Object.keys(roster).forEach(function(weekday) {
    roster[weekday].forEach(function(person) {
      if (person.isAppointment) return;
      names[HANDOVER_normaliseName_(person.worker)] = person.worker;
