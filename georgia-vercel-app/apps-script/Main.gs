  const mapped=goalItems.filter(x=>!NDISPara_emptyOrNo_(x)&&!/^other$/i.test(x)).map(x=>{const m=gm.find(p=>p[0].test(x));return m?m[1]:NDISPara_lowerFirst_(x);});
  sentences.push(NDISPara_groups_(mapped,['The support related to Georgia\'s goals of {items}.','This work supported Georgia\'s goals of {items}.'],['It also related to the goals of {items}.'],seed+13));
