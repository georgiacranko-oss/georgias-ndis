function NDISPara_collectWellbeing_(row,headerMap) {
  const result={worse:[],challenge:[],states:[]};
  ['General mood','Swallowing','Anxiety','Energy','Cognition','Pain'].forEach(label=>{
    const value=NDISPara_normalise_(NDISPara_get_(row,headerMap,'Compared with Georgia’s usual level, how was their wellbeing? ['+label+']',label));
    const key=label.toLowerCase();if(!value||/not observed|not sure|n\/a/.test(value))return;
    result.states.push({label:key,value:value});
    if(value==='a challenge'||/much worse/.test(value))result.challenge.push(key);
    else if(/worse/.test(value))result.worse.push(key);
  });return result;
}

function NDISPara_headerMap_(headers) {
  const map = {};

  headers.forEach(function(header, index) {
    const key = NDISPara_normaliseHeader_(header);

    if (key && map[key] === undefined) {
      map[key] = index;
    }
  });

  return map;
}

function NDISPara_get_(row, headerMap, ...names) {
  for (let index = 0; index < names.length; index++) {
    const key = NDISPara_normaliseHeader_(names[index]);

    if (headerMap[key] !== undefined) {
      return NDISPara_clean_(
        row[headerMap[key]]
      );
    }
  }

  return "";
}

function NDISPara_normaliseHeader_(value) {
  return String(value || "")
    .replace(/[’‘]/g, "'")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
}

function NDISPara_normalise_(value) {
  return String(value || "")
    .replace(/[’‘]/g, "'")
    .replace(/\s+/g, " ")
    .trim()
    .toLowerCase();
}

function NDISPara_clean_(value) {
  return String(value || "")
    .replace(/\s+/g, " ")
    .trim();
}

function NDISPara_split_(value) {
  const text = NDISPara_clean_(value);

  if (!text) return [];

  return text
    .split(/\s*,\s*/)
    .map(function(item) {
      return NDISPara_clean_(item);
    })
    .filter(Boolean);
}

function NDISPara_unique_(items) {
  const seen = {};
  const output = [];

  items.forEach(function(item) {
    const key = NDISPara_normalise_(item);

    if (key && !seen[key]) {
      seen[key] = true;
      output.push(item);
    }
  });

  return output;
}

function NDISPara_dedupe_(sentences) {
  return NDISPara_unique_(
    sentences.filter(Boolean)
  );
}

function NDISPara_list_(items) {
  const values = NDISPara_unique_(
    items.filter(Boolean)
  );

  if (!values.length) return "";
  if (values.length === 1) return values[0];
  if (values.length === 2) {
    return values[0] + " and " + values[1];
  }

  return (
    values.slice(0, -1).join(", ") +
    ", and " +
    values[values.length - 1]
  );
}

function NDISPara_pick_(options, seed) {
  if (!options || !options.length) return "";

  const index =
    Math.abs(Number(seed) || 0) %
    options.length;

  return options[index];
}

function NDISPara_lowerFirst_(value) {
  const text = NDISPara_clean_(value);

  if (!text) return "";

  return (
    text.charAt(0).toLowerCase() +
    text.slice(1)
  );
}

function NDISPara_sentence_(value) {
  const text = NDISPara_clean_(value);

  if (!text) return "";

  if (/[.!?]$/.test(text)) {
    return text;
  }

  return text + ".";
}

function NDISPara_sentenceFragment_(value) {
  return NDISPara_clean_(value)
    .replace(/[.!?]+$/, "");
}

function NDISPara_emptyOrNo_(value) {
  const text = NDISPara_normalise_(value);

  return [
    "",
    "no",
    "n/a",
    "na",
    "none",
    "nothing",
    "not applicable"
  ].indexOf(text) !== -1;
}

function NDISPara_cleanAppointment_(value) {
  let text = NDISPara_clean_(value);

  text = text
    .replace(/^other\s*:?\s*/i, "")
    .replace(/[.!?]+$/, "")
    .trim();

  const types = {
    'physio': 'physiotherapy',
    'physiotherapy': 'physiotherapy',
    'neurophysio': 'neurophysiotherapy',
    'neurophysiotherapy': 'neurophysiotherapy',
    'speech therapy': 'speech therapy',
    'occupational therapy': 'occupational therapy',
    'ot': 'OT',
    'gp': 'GP',
    'dentist': 'dentist',
    'psychiatry': 'psychiatry'
  };
  const type = types[text.toLowerCase()];
  if (type) return 'their ' + type + ' appointment';
  if (/^(physio(?:therapy)?|neurophysio(?:therapy)?|speech therapy|occupational therapy|dentist|dental|psychiatry|phone|telephone|video|telehealth)\s+appointment\b/i.test(text)) {
    return 'their ' + NDISPara_lowerFirst_(text);
  }
  if (/^(OT|GP)\s+appointment\b/i.test(text)) {
    return 'their ' + text.replace(/^(ot|gp)\b/i, function(name) { return name.toUpperCase(); });
  }
  if (!text) return 'their appointment';
  if (/\bappointment\b/i.test(text)) {
    return /^(their|the|an?|my)\s/i.test(text) ? text : 'the ' + text;
  }
  return 'the ' + text + ' appointment';
}

function NDISPara_rowBlank_(row, outputIndex) {
  return !row.some(function(value, index) {
    if (index === outputIndex) return false;

    return NDISPara_clean_(value) !== "";
  });
}

function OVERVIEW_expandSubmittedNoteRows_(overview, notes) {
  if (!overview || !notes || notes.getLastRow() < 2) return;
  const month = String(overview.getRange('B5').getDisplayValue()).trim().toLowerCase();
  const year = Number(overview.getRange('E5').getValue());
  const months = ['january', 'february', 'march', 'april', 'may', 'june',
    'july', 'august', 'september', 'october', 'november', 'december'];
  const monthIndex = months.indexOf(month);
  if (!year || (month !== 'all months' && monthIndex < 0)) return;
  const start = new Date(year, month === 'all months' ? 0 : monthIndex, 1);
  const end = month === 'all months'
    ? new Date(year + 1, 0, 1)
    : new Date(year, monthIndex + 1, 1);
  const count = notes.getRange(2, 3, notes.getLastRow() - 1, 1)
    .getValues().filter(function(row) {
      return row[0] instanceof Date && row[0] >= start && row[0] < end;
    }).length;
  const requiredLastRow = Math.max(90, 62 + count);
  const currentLastRow = overview.getMaxRows() - 2;
  if (requiredLastRow <= currentLastRow) return;
  const additionalRows = requiredLastRow - currentLastRow;
  const template = overview.getRange(currentLastRow, 10, 1, 31);
  const merges = template.getMergedRanges().filter(function(range) {
    return range.getNumRows() === 1 && range.getColumn() >= 10 &&
      range.getLastColumn() <= 40;
  }).map(function(range) {
    return { column: range.getColumn(), width: range.getNumColumns() };
  });
  const height = overview.getRowHeight(currentLastRow);
  overview.insertRowsAfter(currentLastRow, additionalRows);
  for (let row = currentLastRow + 1; row <= requiredLastRow; row++) {
    template.copyTo(overview.getRange(row, 10, 1, 31),
      SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
    merges.forEach(function(merge) {
      const target = overview.getRange(row, merge.column, 1, merge.width);
      target.breakApart();
      target.merge();
    });
    overview.setRowHeight(row, height);
  }
  SpreadsheetApp.flush();
}

function refreshOverviewWrittenNotes(ss) {
  ss = ss || SpreadsheetApp.getActiveSpreadsheet() || SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
  const overview = PROJECT_getOverviewSheet_(ss);
  const notes = ss.getSheetByName('Shift Notes');

  if (!overview) return;

  OVERVIEW_expandSubmittedNoteRows_(overview, notes);

  overview.getRange('M17').clearContent();
  const worthNotingCell = overview.getRange('M18');
  const worthNotingFormula = worthNotingCell.getFormula();
  if (worthNotingFormula) {
    worthNotingCell.setFormula(worthNotingFormula);
    SpreadsheetApp.flush();
  }
}





