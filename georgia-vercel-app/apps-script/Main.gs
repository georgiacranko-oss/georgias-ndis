  const items=NDISPara_split_(value);if(!items.length||NDISPara_emptyOrNo_(value))return '';
  if(items.every(x=>map[NDISPara_normalise_(x)])) {
    const clauses={
      'anxiety staying high':'anxiety could remain high',
      'fatigue getting worse':'fatigue could worsen',
      'pain increasing':'pain could increase',
      'communication becoming harder':'communication could become more difficult',
      'thinking becoming harder':'thinking could become harder',
      'sleep being disrupted':'sleep could be disrupted',
      'injury risk increasing':'the risk of injury could increase',
      'more support needed the next day':'Georgia could need more support the next day'
    };
    if(NDISPara_variant_([false,true],seed,'later style'))return NDISPara_groups_(items.map(x=>clauses[NDISPara_normalise_(x)]),[
      'When I left, I was concerned that {items}.','My concern after the shift was that {items}.',
      'I remained concerned that {items} after the shift.'
    ],['I was also concerned that {items}.'],seed);
    return NDISPara_groups_(items.map(x=>map[NDISPara_normalise_(x)]),[
      'At the end of the shift, I remained concerned about {items}.','Concerns after the shift included {items}.',
      'I left with concerns about {items}.','After the support period, my concerns were about {items}.'
    ],['There were also concerns about {items}.'],seed);
  }
  return NDISPara_sentence_(value);
}
