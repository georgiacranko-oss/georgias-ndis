function PROJECT_validateWorkbook_(ss, throwOnError) {
  const errors = [];
  const warnings = [];

  PROJECT_REQUIRED_SHEETS.forEach(function(name) {
    if (!ss.getSheetByName(name)) {
      errors.push('Missing sheet: ' + name);
    }
  });

  if (!PROJECT_getOverviewSheet_(ss)) {
    errors.push(
      'Missing Support and Funding sheet. Accepted names: ' +
      PROJECT_OVERVIEW_SHEET_ALIASES.join(', ')
    );
  }

  if (!PROJECT_getPlanExpenditureSheet_(ss)) {
    errors.push(
      'Missing Plan Expenditure sheet. Accepted names: ' +
      PROJECT_PLAN_SHEET_ALIASES.join(', ')
    );
  }

  if (!PROJECT_getRawNdisSheet_(ss)) {
    errors.push(
      'Missing Raw NDIS sheet. Accepted names: ' +
      PROJECT_RAW_NDIS_SHEET_ALIASES.join(', ')
    );
  }

  const shiftNotes = ss.getSheetByName('Shift Notes');
  if (shiftNotes) {
    const headers = shiftNotes
      .getRange(1, 1, 1, Math.max(shiftNotes.getLastColumn(), 1))
      .getDisplayValues()[0]
      .map(PROJECT_normalise_);

    [
      ['your name'],
      ['date support was provided'],
      ['how many hours of support did you provide?'],
      PROJECT_WRITTEN_NOTE_HEADERS,
      ['generated paragraph']
    ].forEach(function(acceptedTitles) {
      const found = acceptedTitles.some(function(title) {
        return headers.indexOf(PROJECT_normalise_(title)) !== -1;
      });

      if (!found) {
        errors.push('Shift Notes header missing: ' + acceptedTitles[0]);
      }
    });
  }

  const claims = ss.getSheetByName('Financial Claims');
  if (claims) {
    const headers = claims.getRange('A1:Z1').getDisplayValues()[0];
    const expected = {
      A: 'Date',
      H: 'Status',
      K: 'Invoice URL',
      W: 'Request ID',
      Y: '✓ Paid',
      Z: 'Workflow status'
    };

    Object.keys(expected).forEach(function(letter) {
      const index = PROJECT_columnNumber_(letter) - 1;
      if (PROJECT_normalise_(headers[index]) !== PROJECT_normalise_(expected[letter])) {
        warnings.push(
          'Financial Claims ' + letter + '1 is "' +
          String(headers[index] || '') + '"; expected "' + expected[letter] + '".'
        );
      }
    });
  }

  if (throwOnError && errors.length) {
    throw new Error(errors.join('\n'));
  }

  return { errors: errors, warnings: warnings };
}

function PROJECT_columnNumber_(letters) {
  return String(letters)
    .toUpperCase()
    .split('')
    .reduce(function(total, ch) {
      return total * 26 + ch.charCodeAt(0) - 64;
    }, 0);
}

function PROJECT_normalise_(value) {
  return String(value || '')
    .toLowerCase()
    .replace(/[“”]/g, '"')
    .replace(/[’]/g, "'")
    .replace(/\s+/g, ' ')
    .trim();
}

function PROJECT_runSafely_(label, fn) {
  try {
    return fn();
  } catch (error) {
    console.error(
      label + ': ' +
      (error && error.stack ? error.stack : String(error))
    );
    return null;
  }
}

