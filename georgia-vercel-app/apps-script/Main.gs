    if(!model||!model.day||!model.person||['Away','Missed'].includes(model.type)||!S6_hasDescriptionNotes_(text))return;
    const key=model.day+'|'+CS4_name_(model.person)+'|'+S6_kind_(model.type);
    const g=groups[key]||(groups[key]={key:key,model:model,text:'',records:[]});
    g.text=S6_duplicateDescription_(g.text,text);
    if(record)g.records.push(record);
  }
  Object.values(registry.records).forEach(r=>add(r.model,r.lastDescription,r));
  changes.forEach(c=>add(c,c.note,null));
  notes.records.forEach(n=>add({day:n.day,person:n.person,type:'Additional'},n.text,null));
  return Object.keys(groups).sort().map(k=>groups[k]);
