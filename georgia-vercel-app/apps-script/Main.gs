function HANDOVER_sendToNextVisitor_(e) {
  if (!e || !e.range) return;

  const sheet = e.range.getSheet();
  if (!sheet || sheet.getName() !== 'Shift Notes') return;

  const rowNumber = e.range.getRow();
  if (rowNumber < 2) return;

  const lastColumn = Math.max(sheet.getLastColumn(), 1);
  const headers = sheet
    .getRange(1, 1, 1, lastColumn)
    .getDisplayValues()[0];

  const consentCol = HANDOVER_findHeaderColumn_(headers, ['Send this to the next person who is visiting?']);
  // The form now sends written handovers automatically and no longer asks this question.
  // A leftover blank response column must not block sending. Respect any explicit old answer.
  if (consentCol) {
    const choice = sheet.getRange(rowNumber, consentCol).getValue();
    if (String(choice == null ? '' : choice).trim() && !HANDOVER_hasConsent_(choice)) {
      console.log('Handover not sent: the response explicitly declined sending.');
      return;
    }
  }

  const nameCol = HANDOVER_findHeaderColumn_(headers, [
    'Your name'
  ]);

  const dateCol = HANDOVER_findHeaderColumn_(headers, [
    'Date support was provided'
  ]);

  const noteCol = HANDOVER_findHeaderColumn_(headers, PROJECT_WRITTEN_NOTE_HEADERS);

  if (!nameCol || !dateCol || !noteCol) {
    console.log(
      'Handover not sent: could not find name, date or written-note header.'
    );
    return;
  }

  const submittedBy = String(
    sheet.getRange(rowNumber, nameCol).getDisplayValue() || ''
  ).trim();

  const supportDate = sheet.getRange(rowNumber, dateCol).getValue();

  const noteRow = sheet.getRange(rowNumber, 1, 1, lastColumn).getDisplayValues()[0];
  const note = PROJECT_writtenNoteTexts_(noteRow, NDISPara_headerMap_(headers))
    .filter(function(text) { return !/^(?:[-\u2013\u2014~.\s]+|n\/?a)$/i.test(text); })
    .join('\n\n');

  if (!note) return;

  if (!(supportDate instanceof Date) || isNaN(supportDate.getTime())) {
    console.log('Handover not sent: support date is invalid.');
    return;
  }

  const ss = e.source || SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
  const regular = ss.getSheetByName('Regular Shifts');

  if (!regular) {
    console.log('Handover not sent: Regular Shifts sheet is missing.');
    return;
  }

  const next = HANDOVER_findNextVisitor_(
    ss,
    regular,
    sheet,
    supportDate,
    submittedBy
  );

  if (!next) {
    console.log('Handover not sent: no next scheduled visitor was found.');
    return;
  }

  const nextEmail = HANDOVER_EMAIL_BY_NAME[
    HANDOVER_normaliseName_(next.name)
  ];

  const submitterEmail = HANDOVER_EMAIL_BY_NAME[
    HANDOVER_normaliseName_(submittedBy)
  ];

  if (!submitterEmail) {
    console.log(
      'Handover not sent: no email is listed for submitter "' +
      submittedBy + '".'
    );
    return;
  }

  if (!nextEmail) {
    console.log(
      'Handover not sent: no email is listed for next visitor "' +
      next.name + '".'
    );
    return;
  }

  const shiftNoteLink = HANDOVER_prepareShiftNoteLink_(ss, rowNumber);

  const email = HANDOVER_buildEmail_(
    submittedBy,
    next.name,
    supportDate,
    note,
    shiftNoteLink,
    false
  );

  const recipients = [submitterEmail, nextEmail]
    .filter(function(emailAddress, index, all) {
      return emailAddress && all.indexOf(emailAddress) === index;
    })
    .join(',');

  const sent=EMAIL_sendOnce_('handover',sheet,rowNumber,{
    to: recipients,
    subject: email.subject,
    body: email.plainBody,
    htmlBody: email.htmlBody,
    name: 'Georgia Shift Notes'
  });
  if(!sent)return;

  const nextDateText = Utilities.formatDate(
    next.date,
    PROJECT_TIME_ZONE,
    'EEE d MMM'
  );

  console.log(
    'Handover group email sent to ' + submittedBy + ' <' +
    submitterEmail + '> and ' + next.name + ' <' + nextEmail +
    '> for ' + nextDateText
  );
}

function HANDOVER_prepareShiftNoteLink_(ss, sourceRow) {
  if (!ss || !sourceRow || Number(sourceRow) < 2) return '';

  const shiftNotes = ss.getSheetByName('Shift Notes');
  if (!shiftNotes) {
    console.log('Handover link not created: Shift Notes sheet is missing.');
    return '';
  }

  const row = Number(sourceRow);
  if (row > shiftNotes.getMaxRows()) {
    console.log(
      'Handover link not created: Shift Notes row ' + row + ' does not exist.'
    );
    return '';
  }

  try {
    return GCAL4_shiftNoteUrlForSourceRow_(ss, row);
  } catch (err) {
    console.log(
      'Handover link not created: ' + err
    );
    return '';
  }
}

function doGet(e) {
  const action = String(
    e && e.parameter ? e.parameter.action || '' : ''
  );

  const requestedSpreadsheet = String(
    e && e.parameter ? e.parameter.spreadsheet || '' : ''
  );

  const sourceRow = Number(
    e && e.parameter ? e.parameter.row : 0
  );

  if (action && action !== 'openShiftNote') {
    return HtmlService.createHtmlOutput(
      'This link is not a Shift Notes View link. Rebuild the note links.'
    );
  }

  if (
    requestedSpreadsheet &&
    requestedSpreadsheet !== PROJECT_SPREADSHEET_ID
  ) {
    return HtmlService.createHtmlOutput(
      'This shift-note link belongs to a different spreadsheet.'
    );
  }

  if (!sourceRow || sourceRow < 2) {
    return HtmlService.createHtmlOutput('The shift note row is missing.');
  }

  const ss = SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
  const view = GCAL4_selectShiftNotesViewRow_(ss, sourceRow);
  const destination =
    ss.getUrl() +
    '#gid=' + view.getSheetId() +
    '&range=C3';

  const safeDestination = JSON.stringify(destination);
  const html =
    '<!doctype html><html><head><base target="_top">' +
    '<meta http-equiv="refresh" content="0;url=' +
    HANDOVER_escapeHtml_(destination) + '"></head>' +
    '<body style="display:none">' +
    '<script>window.top.location.replace(' + safeDestination + ');</script>' +
    '</body></html>';

  return HtmlService
    .createHtmlOutput(html)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

