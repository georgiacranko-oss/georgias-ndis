function CHECK_INVOICE_SYSTEM() {
  const ss = SpreadsheetApp.openById(INV_SPREADSHEET_ID);
  const diagnostics = ss.getSheetByName('Diagnostics') || ss.insertSheet('Diagnostics');
  diagnostics.clear();

  const rows = [['Check', 'Result', 'Details']];
  const plan = PROJECT_getSheetByAliases_(ss, PROJECT_PLAN_SHEET_ALIASES);
  const claims = ss.getSheetByName(INV_CLAIMS_SHEET);

  rows.push(['Plan sheet exists', plan ? 'PASS' : 'FAIL', plan ? plan.getName() : 'Missing Plan Expenditure / plan sheet']);
  rows.push(['Financial Claims exists', claims ? 'PASS' : 'FAIL', claims ? claims.getName() : 'Missing Financial Claims']);

  if (plan) {
    rows.push(['To Claim summary cell', 'INFO', plan.getRange(INV_TO_CLAIM_SUMMARY_CELL).getDisplayValue()]);
    rows.push(['To Pay summary cell', 'INFO', plan.getRange(INV_TO_PAY_SUMMARY_CELL).getDisplayValue()]);
    rows.push(['Paid checkbox range', 'PASS', INV_TO_PAY_CHECKBOX_RANGE]);
  }

  if (claims && claims.getLastRow() >= 2) {
    const receivedColumn = INV_ensureReceivedDateColumn_(claims);
    const values = claims.getRange(2, 1, claims.getLastRow() - 1, Math.max(26, receivedColumn)).getValues();
    const currentStart = new Date(2026, 7, 12);
    let currentToClaim = 0;
    let currentToPay = 0;
    let oldToPay = 0;
    let missingAmount = 0;
    let missingDate = 0;

    values.forEach(function(row) {
      const dateText = row[19];
      const amountText = row[21];
      const workflow = row[25];
      const date = INV_matchDate_(dateText);
      const receivedDate = INV_matchDate_(row[receivedColumn - 1]);
      const isCurrent = receivedDate && receivedDate >= currentStart;

      const inToClaimPeriod = date && Utilities.formatDate(date, ss.getSpreadsheetTimeZone() || INV_TIME_ZONE, 'yyyy-MM-dd') >= INV_TO_CLAIM_START_DATE;
      if (inToClaimPeriod && ((workflow === 'To Be Claimed' && Number(row[6]) > 0) ||
          (row[7] === 'Needs Review' && row[24] !== true && workflow !== 'Paid'))) currentToClaim++;
      if (workflow === 'To Be Paid' && isCurrent) currentToPay++;
      if (workflow === 'To Be Paid' && receivedDate && !isCurrent) oldToPay++;
      if ((workflow === 'To Be Claimed' || workflow === 'To Be Paid') && !amountText) missingAmount++;
      if ((workflow === 'To Be Claimed' || workflow === 'To Be Paid') && !dateText) missingDate++;
    });

    rows.push(['To Claim rows', 'INFO', String(currentToClaim)]);
    rows.push(['Current To Pay rows', 'INFO', String(currentToPay)]);
    rows.push(['Old To Pay rows hidden from current queue', 'INFO', String(oldToPay)]);
    rows.push(['Missing queue amounts', missingAmount === 0 ? 'PASS' : 'FAIL', String(missingAmount)]);
    rows.push(['Missing queue dates', missingDate === 0 ? 'PASS' : 'FAIL', String(missingDate)]);
  }

  diagnostics.getRange(1, 1, rows.length, rows[0].length).setValues(rows);
  diagnostics.autoResizeColumns(1, 3);

  const message = 'Invoice system check complete. See the Diagnostics sheet.';
  NDIA_safeNotify_(message);
  return message;
}

