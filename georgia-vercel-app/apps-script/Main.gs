function INV_refreshInvoiceSheets_(ss, lockHeld) {
  const lock = lockHeld ? null : LockService.getScriptLock();
  if (lock && !lock.tryLock(1000)) throw new Error('The workbook is busy. Invoice refresh did not run. Try again after it finishes.');
  try {
    INV_repairFinancialClaimsInfrastructure_(ss);
    SpreadsheetApp.flush();
    const matched = INV_matchRawClaimsToInvoices_(ss);
    SpreadsheetApp.flush();
    INV_setupCurrentInvoiceQueues_(ss);
    return matched;
  } finally {
    if (lock) lock.releaseLock();
  }
}

