function GCAL4_shiftOutingLabel_(value, detailValue) {

  const specificDetail = String(detailValue || '')
    .trim()
    .replace(/[.\s]+$/, '')
    .replace(/^./, function(character) {
      return character.toUpperCase();
    });

  const choices =
    String(
      value || ''
    )
      .split(',')
      .map(
        function(choice) {

          return choice
            .trim()
            .toLowerCase();

        }
      )
      .filter(String);

  const labels = [];

  choices.forEach(
    function(choice) {

      let label = '';

      if (
        choice ===
          'bought groceries' ||
        choice ===
          'ran errands'
      ) {

        label = 'Errands';
      }

      if (
        choice ===
          'saw family and friends' ||
        choice ===
          'social activity' ||
        choice ===
          'did a social activity' ||
        choice ===
          'went to a social activity'
      ) {

        label =
          'Socialised';
      }

      if (
        choice ===
          'community activity' ||
        choice ===
          'community event' ||
        choice ===
          'went to a community event' ||
        choice ===
          'went to a community activity'
      ) {

        label = specificDetail || 'Community';
      }

      if (
        choice ===
        'walked myra'
      ) {

        label = 'Walk';
      }

      if (
        choice ===
          'professional activity' ||
        choice ===
          'work or professional activity'
      ) {

        label = 'Work';
      }

      if (
        label &&
        labels.indexOf(
          label
        ) === -1
      ) {

        labels.push(
          label
        );
      }

    }
  );

  return labels.join(', ');
}

function GCAL4_shiftAppointmentLabel_(
  value,
  detailValue,
  supportedTasksValue
) {

  let raw =
    String(
      value || ''
    ).trim();

  const appointmentWasSubmitted =
    /\bappointment\b/i.test(
      String(supportedTasksValue || '')
    );

  const inferredFromDetail = !raw && appointmentWasSubmitted;

  if (inferredFromDetail) {
    raw = String(detailValue || '')
      .trim()
      .replace(/^the\s+/i, '')
      .split(/\s+(?:came|visited|arrived)\b/i)[0]
      .trim()
      .replace(/^./, function(character) {
        return character.toUpperCase();
      });
  }

  if (!raw) return '';

  const choices =
    raw
      .split(',')
      .map(
        function(choice) {

          return choice.trim();

        }
      )
      .filter(String);

  if (
    choices.length > 1
  ) {

    return 'Multiple';
  }

  const lower =
    raw.toLowerCase();

  if (
    lower.indexOf(
      'multiple'
    ) !== -1
  ) {

    return 'Multiple';
  }

  if (
    lower.indexOf(
      'occupational therap'
    ) !== -1 ||
    lower === 'ot'
  ) {

    return 'OT';
  }

  if (
    lower.indexOf(
      'psycholog'
    ) !== -1 ||
    lower === 'psych'
  ) {

    return 'Psych';
  }

  if (
    lower.indexOf(
      'neurophysio'
    ) !== -1
  ) {

    return 'Neurophysio';
  }

  if (
    lower.indexOf(
      'physiotherap'
    ) !== -1 ||
    lower === 'physio'
  ) {

    return 'Physio';
  }

  if (
    lower.indexOf(
      'speech'
    ) !== -1
  ) {

    return 'Speech';
  }

  let custom =
    raw
      .replace(
        /^other\s*:?\s*/i,
        ''
      )
      .trim();

  if (
    !custom ||
    custom.toLowerCase() ===
      'other'
  ) {

    custom =
      String(
        detailValue || ''
      ).trim();
  }

  custom =
    custom
      .split(/[:;]/)[0]
      .trim();

  custom =
    custom
      .replace(
        /\s+appointment.*$/i,
        ''
      )
      .trim();

  if (/\bcrisis support team\b/i.test(custom)) {
    return 'Crisis team';
  }

  return custom;
}

function GCAL4_shiftWellbeingStatus_(value) {

  const text =
    String(
      value || ''
    )
      .trim()
      .toLowerCase();

  if (
    text ===
      'a challenge' ||
    text ===
      'much worse' ||
    text ===
      'much worse than usual'
  ) {

    return 'much';
  }

  if (
    text ===
      'worse' ||
    text ===
      'a bit worse than usual' ||
    text ===
      'worse than usual'
  ) {

    return 'worse';
  }

  return '';
}

function GCAL4_shiftWellbeingLabel_(values) {

  const factors = [

    {
      key: 'mood',
      better:
        'Better mood',
      worse:
        'Mediocre mood',
      much:
        'Really bad mood'
    },

    {
      key: 'swallowing',
      better:
        'Better swallowing',
      worse:
        'Swallowing difficulty',
      much:
        'Choking risk'
    },

    {
      key: 'anxiety',
      better:
        'Less anxious',
      worse:
        'More anxious',
      much:
        'Extremely overwhelmed'
    },

    {
      key: 'energy',
      better:
        'Better energy',
      worse:
        'Tired',
      much:
        'Exhausted'
    },

    {
      key: 'cognition',
      better:
        'Clearer thinking',
      worse:
        'Brain fog',
      much:
        'Unable to think'
    }

  ];

  const results =
    factors
      .map(
        function(factor) {

          const text =
            String(
              values[
                factor.key
              ] || ''
            )
              .trim()
              .toLowerCase();

          if (
            text ===
              'much better' ||
            text ===
              'much better than usual' ||
            text ===
              'better' ||
            text ===
              'better than usual'
          ) {

            return {

              text:
                factor.better,

              status:
                'better',

              colour:
                '#2E7D32'
            };
          }

          const status =
            GCAL4_shiftWellbeingStatus_(
              text
            );

          if (!status) {
            return null;
          }

          return {

            text:
              factor[
                status
              ],

            status:
              status,

            colour:
              status ===
                'much'
                ? '#D32F2F'
                : '#F57C00'
          };

        }
      )
      .filter(
        function(item) {
          return item;
        }
      );

  const worseResults =
    results.filter(
      function(item) {

        return (
          item.status ===
            'worse' ||
          item.status ===
            'much'
        );

      }
    );

  if (
    worseResults.length > 1
  ) {

    const hasMuchWorse =
      worseResults.some(
        function(item) {

          return (
            item.status ===
            'much'
          );

        }
      );

    return {

      text:
        hasMuchWorse
          ? 'Rough day'
          : 'Mediocre day',

      colour:
        hasMuchWorse
          ? '#D32F2F'
          : '#F57C00'
    };
  }

  if (
    worseResults.length === 1
  ) {

    return {

      text:
        worseResults[0]
          .text,

      colour:
        worseResults[0]
          .colour
    };
  }

  const betterResults =
    results.filter(
      function(item) {

        return (
          item.status ===
          'better'
        );

      }
    );

  if (
    betterResults.length > 1
  ) {

    return {

      text:
        'Good day',

      colour:
        '#2E7D32'
    };
  }

  if (
    betterResults.length === 1
  ) {

    return {

      text:
        betterResults[0]
          .text,

      colour:
        '#2E7D32'
    };
  }

  return null;
}

function GCAL4_shiftPainLabel_(values) {

  const painText =
    String(
      values.pain || ''
    )
      .trim()
      .toLowerCase();

  const shouldShow =

    painText ===
      'worse' ||

    painText ===
      'much worse' ||

    painText ===
      'much worse than usual' ||

    painText ===
      'a bit worse than usual' ||

    painText ===
      'worse than usual' ||

    painText ===
      'a challenge';

  if (!shouldShow) {
    return '';
  }

  const location =
    GCAL4_shiftPainLocation_(
      values.painLocation
    );

  if (!location) {
    return 'Pain';
  }

  if (/^head(?:\s+pain)?$/i.test(location)) {
    return 'Headache';
  }

  return /\bpain\b/i.test(location)
    ? location
    : location + ' pain';
}

function GCAL4_shiftPainLocation_(value) {

  let text =
    String(
      value || ''
    ).trim();

  text =
    text.replace(
      /^pain\s*:\s*/i,
      ''
    );

  text =
    text
      .split(
        /\.\s*mood\s*:/i
      )[0]
      .trim();

  return text;
}

function GCAL4_shiftTimeRangeLabel_(startValue, hoursValue) {
  const startText = String(startValue || '').trim();
  const startMinutes = GCAL4_parseRegularShiftTimeMinutes_(
    startValue,
    startText
  );

  const hoursMatch = String(hoursValue || '').match(/\d+(?:\.\d+)?/);
  const hours = hoursMatch ? Number(hoursMatch[0]) : NaN;

  if (startMinutes === null || isNaN(hours) || hours <= 0) {
    return startText
      ? GCAL4_compactAppointmentTimeText_(startText)
      : GCAL4_shiftHoursLabel_(hoursValue);
  }

  const durationMinutes = Math.round(hours * 60);

  const endMinutes = startMinutes + durationMinutes;

  return GCAL4_compactAppointmentTimeText_(
    GCAL4_minutesToRegularTimeText_(startMinutes)
  ) + ' - ' + GCAL4_compactAppointmentTimeText_(
    GCAL4_minutesToRegularTimeText_(endMinutes)
  );
}

function GCAL4_shiftHoursLabel_(value) {

  const text =
    String(
      value || ''
    ).trim();

  if (!text) return '';

  if (
    /^\d+(\.\d+)?$/.test(
      text
    )
  ) {

    return text + ' h';
  }

  if (
    /\b(h|hr|hrs|hour|hours)\b/i
      .test(text)
  ) {

    return text;
  }

  return text;
}

function GCAL4_shiftMonthIndex_(value) {

  const months = [

    'january',
    'february',
    'march',
    'april',
    'may',
    'june',
    'july',
    'august',
    'september',
    'october',
    'november',
    'december'

  ];

  return months.indexOf(

    String(
      value || ''
    )
      .trim()
      .toLowerCase()

  );
}

function GCAL4_parseShiftDisplayDate_(value) {

  if (
    value instanceof Date &&
    !isNaN(
      value.getTime()
    )
  ) {

    return new Date(
      value.getFullYear(),
      value.getMonth(),
      value.getDate()
    );
  }

  const text =
    String(
      value || ''
    ).trim();

  if (!text) return null;

  let match =
    text.match(
      /^(\d{1,2})\/(\d{1,2})\/(\d{4})/
    );

  if (match) {

    const day =
      Number(
        match[1]
      );

    const month =
      Number(
        match[2]
      ) - 1;

    const year =
      Number(
        match[3]
      );

    const date =
      new Date(
        year,
        month,
        day
      );

    return isNaN(
      date.getTime()
    )
      ? null
      : date;
  }

  match =
    text.match(
      /^(\d{4})-(\d{1,2})-(\d{1,2})/
    );

  if (match) {

    const year =
      Number(
        match[1]
      );

    const month =
      Number(
        match[2]
      ) - 1;

    const day =
      Number(
        match[3]
      );

    const date =
      new Date(
        year,
        month,
        day
      );

    return isNaN(
      date.getTime()
    )
      ? null
      : date;
  }

  const parsed =
    new Date(text);

  if (
    isNaN(
      parsed.getTime()
    )
  ) {

    return null;
  }

  return new Date(
    parsed.getFullYear(),
    parsed.getMonth(),
    parsed.getDate()
  );
}

function GCAL4_shiftDateKey_(value) {
  if (value === null || value === undefined || value === '') return '';

  const pad = function(n) { return String(n).padStart(2, '0'); };
  const key = function(y, m, d) {
    return String(y).padStart(4, '0') + '-' + pad(m) + '-' + pad(d);
  };

  if (value instanceof Date && !isNaN(value.getTime())) {
    const ss = GCAL4_getSpreadsheet_();
    return Utilities.formatDate(
      value,
      ss.getSpreadsheetTimeZone() || 'Australia/Melbourne',
      'yyyy-MM-dd'
    );
  }

  if (typeof value === 'number' && isFinite(value)) {
    const wholeDays = Math.floor(value);
    const millis = Date.UTC(1899, 11, 30) + wholeDays * 86400000;
    const d = new Date(millis);
    return key(d.getUTCFullYear(), d.getUTCMonth() + 1, d.getUTCDate());
  }

  const text = String(value).trim().replace(/,/g, '').replace(/\s+/g, ' ');
  if (!text) return '';

  let match = text.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (match) return key(Number(match[1]), Number(match[2]), Number(match[3]));

  match = text.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
  if (match) {
    let year = Number(match[3]);
    if (year < 100) year += 2000;
    return key(year, Number(match[2]), Number(match[1]));
  }

  const months = {
    jan: 1, january: 1, feb: 2, february: 2, mar: 3, march: 3,
    apr: 4, april: 4, may: 5, jun: 6, june: 6, jul: 7, july: 7,
    aug: 8, august: 8, sep: 9, sept: 9, september: 9,
    oct: 10, october: 10, nov: 11, november: 11, dec: 12, december: 12
  };
  match = text.match(/^(\d{1,2})\s+([A-Za-z]{3,9})\s+(\d{4})/);
  if (match) {
    const month = months[match[2].toLowerCase()];
    if (month) return key(Number(match[3]), month, Number(match[1]));
  }

  return '';
}

function GCAL4_shiftNoteUrlForSourceRow_(ss, sourceRow) {
  const cleanSourceRow = Number(sourceRow);
  if (!cleanSourceRow || cleanSourceRow < 2) {
    throw new Error('The Shift Notes row number is invalid.');
  }

  const webAppUrl = String(PROJECT_SHIFT_NOTE_WEB_APP_URL || '').trim();
  if (!webAppUrl) {
    throw new Error(
      'PROJECT_SHIFT_NOTE_WEB_APP_URL is blank.'
    );
  }

  return webAppUrl + '?row=' + encodeURIComponent(cleanSourceRow);
}

function GCAL4_selectShiftNotesViewRow_(ss, sourceRow) {
  const view = ss.getSheetByName('Shift Notes View');

  if (!view) {
    throw new Error('Shift Notes View was not found.');
  }

  if (!sourceRow || Number(sourceRow) < 2) {
    throw new Error('The Shift Notes row number is invalid.');
  }

  const lastHelperRow = Math.max(view.getLastRow(), 3);

  const sourceRows = view
    .getRange(3, 54, lastHelperRow - 2, 1)
    .getDisplayValues()
    .flat();

  const index = sourceRows.findIndex(function(value) {
    return Number(value) === Number(sourceRow);
  });

  if (index === -1) {
    throw new Error(
      'Could not match Shift Notes row ' +
      sourceRow +
      ' in Shift Notes View.'
    );
  }

  const helperRow = index + 3;

  const shiftLabel = view
    .getRange(helperRow, 57) // BE
    .getDisplayValue();

  if (!shiftLabel) {
    throw new Error(
      'Shift Notes View label is blank for source row ' +
      sourceRow +
      '.'
    );
  }

  view.getRange('C3').setValue(shiftLabel);
  SpreadsheetApp.flush();

  return view;
}

