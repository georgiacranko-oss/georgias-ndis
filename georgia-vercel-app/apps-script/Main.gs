  for (
    let index = 0;
    index < headers.length;
    index++
  ) {

    const header =
      String(
        headers[index] || ''
      )
        .trim()
        .toLowerCase();

    if (header === wanted) {
      return index + 1;
    }
  }

  return 0;
}

