function PROJECT_repairFinancialClaimsFormatting_(ss) {
  const sheet = ss.getSheetByName('Financial Claims');
  if (!sheet) return;

  const lastRow = Math.max(sheet.getLastRow(), 2);
  const count = lastRow - 1;
  if (count < 1) return;

  PROJECT_copyFinancialClaimFormatting_(sheet, 2, count);
}

function PROJECT_copyFinancialClaimFormatting_(sheet, startRow, rowCount) {
  if (!sheet || !rowCount || startRow < 2) return;

  const width = Math.min(31, sheet.getMaxColumns());
  sheet.getRange(startRow, 1, rowCount, width)
    .setFontFamily('Montserrat').setFontSize(10).setFontWeight('normal')
    .setWrap(true).setVerticalAlignment('middle').setNumberFormat('@');
  [1, 15, 20].forEach(col => sheet.getRange(startRow, col, rowCount, 1).setNumberFormat('d mmm yyyy'));
  [7, 22].forEach(col => sheet.getRange(startRow, col, rowCount, 1).setNumberFormat('$#,##0.00'));
  sheet.getRange(startRow, 25, rowCount, 1).setNumberFormat('General');
}

function PROJECT_findBrokenFormulaCells_(ss) {
  const result = [];
  const plan = PROJECT_getPlanExpenditureSheet_(ss);
  const names = PROJECT_FORMULA_REPAIR_SHEETS.slice();
  if (plan && names.indexOf(plan.getName()) === -1) names.push(plan.getName());

  names.forEach(function(name) {
    const sheet = ss.getSheetByName(name);
    if (!sheet || sheet.getLastRow() < 1 || sheet.getLastColumn() < 1) return;

    const formulas = sheet
      .getRange(1, 1, sheet.getLastRow(), sheet.getLastColumn())
      .getFormulas();

    for (let r = 0; r < formulas.length; r++) {
      for (let c = 0; c < formulas[r].length; c++) {
        if (formulas[r][c] && formulas[r][c].indexOf('#REF!') !== -1) {
          result.push(name + '!' + sheet.getRange(r + 1, c + 1).getA1Notation());
        }
      }
    }
  });

  return result;
}

