function GCAL4_onCalendarShiftEdit(e) {
  if (!e || !e.range) return;

  const sheet = e.range.getSheet();
  const sheetName = sheet.getName();
  if (PROJECT_OVERVIEW_SHEET_ALIASES.indexOf(sheetName) !== -1) {
    OV_ON_EDIT(e);
    return;
  }

  if (sheetName === GCAL4_CONFIG.calendarSheet) {
    const changedSync =
      GCAL4_rangeTouchesCell_(e.range, GCAL4_CONFIG.syncCell);

    if (changedSync &&
        String(sheet.getRange(GCAL4_CONFIG.syncCell).getValue()) === 'true') {
      sheet.getRange(GCAL4_CONFIG.syncCell).setValue(false);
      if (typeof CS4_UPDATE !== 'function') {
        throw new Error('CS4_UPDATE was not found. Replace Main with the complete current code.');
      }
      const result = CS4_UPDATE();
      (e.source || sheet.getParent()).toast(
        result,
        'Calendar sync',
        5
      );
      return;
    }

    const changedMonth =
      GCAL4_rangeTouchesCell_(e.range, GCAL4_CONFIG.monthCell);

    const changedYear =
      GCAL4_rangeTouchesCell_(e.range, GCAL4_CONFIG.yearCell);

    if (!changedMonth && !changedYear) {
      return;
    }

    GCAL4_refreshCalendar_(true);
    return;
  }

  if (
    GCAL4_CONFIG.responseSheets.indexOf(sheetName) !== -1 &&
    e.range.getRow() > 1
  ) {
    GCAL4_refreshCalendar_();
    OV_REFRESH();
    return;
  }

  if (
    sheetName === 'Schedule Changes' &&
    e.range.getRow() >= 18
  ) {
    if (typeof CS4_MARK_SCHEDULE_EDIT === 'function') {
      CS4_MARK_SCHEDULE_EDIT(e);
    }
    GCAL4_refreshCalendar_();
    return;
  }

  if (
    sheetName === GCAL4_CONFIG.regularShiftsSheet &&
    e.range.getRow() > 1
  ) {
    GCAL4_refreshCalendar_();
  }
}

function GCAL4_getSpreadsheet_() {
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active && active.getId && active.getId() === PROJECT_SPREADSHEET_ID) {
    return active;
  }
  return SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
}

function GCAL4_calendarSlotDay_(year, month, weekIndex, dayIndex) {
  const firstWeekday = new Date(Date.UTC(year, month, 1, 12, 0, 0)).getUTCDay();
  const daysBackToMonday = (firstWeekday + 6) % 7;
  const slotIndex = weekIndex * 7 + dayIndex;
  const day = 1 + slotIndex - daysBackToMonday;
  const daysInMonth = new Date(Date.UTC(year, month + 1, 0, 12, 0, 0)).getUTCDate();
  return day >= 1 && day <= daysInMonth ? day : 0;
}

function GCAL4_writeDayGrid_(calendar) {
  if (!calendar) return;

  const month = GCAL4_shiftMonthIndex_(
    calendar.getRange(GCAL4_CONFIG.monthCell).getDisplayValue()
  );
  const year = Number(calendar.getRange(GCAL4_CONFIG.yearCell).getValue());

  if (month < 0 || !year) return;

  const gridKey = year + '-' + month;
  const props = PropertiesService.getDocumentProperties();
  if (props.getProperty('GCAL4_LAST_GRID_KEY') === gridKey) return;

  GCAL4_CONFIG.dateRows.forEach(function(dateRow, weekIndex) {
    GCAL4_CONFIG.dayColumns.forEach(function(dayCol, dayIndex) {
      const day = GCAL4_calendarSlotDay_(year, month, weekIndex, dayIndex);
      const cell = calendar.getRange(dateRow, dayCol);
      if (day) {
        cell.setValue(day);
      } else {
        cell.clearContent();
      }
    });
  });

  props.setProperty('GCAL4_LAST_GRID_KEY', gridKey);
}

function GCAL4_unmergeForTarget_(range) {
  if (!range) return;
  range.getMergedRanges().forEach(function(merged) {
    merged.breakApart();
  });
}

function GCAL4_mergeSafely_(range) {
  GCAL4_unmergeForTarget_(range);
  range.merge();
  return range;
}

function GCAL4_uniqueCalendarItems_(items) {
  const seen = {};
  return (items || []).filter(function(item) {
    if (!item) return false;

    const key = [
      String(item.worker || '').trim().toLowerCase(),
      String(item.startTimeText || '').trim().toLowerCase(),
      String(item.hours || '').trim(),
      item.isAppointment === true ? 'appointment' : 'shift',
      String(item.appointmentLabel || item.appointment || '').trim().toLowerCase(),
      String(item.outing || '').trim().toLowerCase(),
      String(item.note || '').trim().toLowerCase()
    ].join('|');

    if (seen[key]) return false;
    seen[key] = true;
    return true;
  });
}

function GCAL4_latestSubmitted_(items) {
  const latest = {};
  (items || []).forEach(function(item) {
    const key = CS4_name_(item.worker) + '|' + CS4_time_(item.startTimeText);
    if (!latest[key] || Number(item.responseRow) > Number(latest[key].responseRow)) latest[key] = item;
  });
  return Object.keys(latest).map(key => latest[key]);
}

function GCAL4_submittedStart_(entry, planned) {
  if (entry.startTimeText) return entry.startTimeText;
  const matches = planned.filter(x => CS4_name_(x.worker) === CS4_name_(entry.worker));
  return matches.length === 1 ? matches[0].startTimeText : '';
}

function REFRESH_CALENDAR_VIEWS() {
  const p=PropertiesService.getScriptProperties(),stamp=p.getProperty('S6_VIEW_PENDING');
  if(!stamp)return 'Calendar views are current.';
  if(!GCAL4_refreshCalendar_(true))return 'Calendar view refresh is queued.';
  if(p.getProperty('S6_VIEW_PENDING')===stamp)p.deleteProperty('S6_VIEW_PENDING');
  return 'Calendar views refreshed.';
}

function GCAL4_refreshCalendar_(force) {
  const lock = LockService.getDocumentLock();

  if (!lock.tryLock(1000)) {
    return false;
  }

  try {
    const props = PropertiesService.getDocumentProperties();
    const now = Date.now();
    const last = Number(props.getProperty('GCAL4_LAST_REFRESH_MS') || 0);
    if (!force && last && now - last < 5000) {
      return false;
    }

    const ss = GCAL4_getSpreadsheet_();
    const calendar = ss.getSheetByName(GCAL4_CONFIG.calendarSheet);
    if (!calendar) throw new Error('Calendar sheet was not found.');

    if (calendar.getMaxRows() < 65) {
      calendar.insertRowsAfter(
        calendar.getMaxRows(),
        65 - calendar.getMaxRows()
      );
    }

    GCAL4_writeDayGrid_(calendar);
    SpreadsheetApp.flush();

    GCAL4_renderStackedShiftCards_();
    GCAL4_applyDateRightBorders_(calendar);
    SpreadsheetApp.flush();

    props.setProperty('GCAL4_LAST_REFRESH_MS', String(Date.now()));
    return true;
  } finally {
    lock.releaseLock();
  }
}

function GCAL4_applyDateRightBorders_(calendar) {
  GCAL4_CONFIG.dateRows.forEach(function(row) {
    GCAL4_CONFIG.dayColumns.forEach(function(column) {
      calendar.getRange(row, column).setBorder(
        true, true, true, true, null, null,
        '#123F52', SpreadsheetApp.BorderStyle.SOLID_MEDIUM
      );
    });
  });
}

function GCAL4_RENDER_ONLY() {
  const ss = GCAL4_getSpreadsheet_();
  GCAL4_refreshCalendar_(true);
  SpreadsheetApp.flush();
  return 'Calendar rendered from current sheet data.';
}

function GCAL4_REFRESH() {
  if (typeof CS4_UPDATE !== 'function') {
    throw new Error('CS4_UPDATE was not found. Replace Main with the complete current code.');
  }
  return CS4_UPDATE();
}

function REFRESH_ALL_NDIA_SHEETS() {
  const ss = SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
  const failures = [];
  function run(label, work) {
    if (PROJECT_runSafely_(label, work) === null) failures.push(label);
  }
  run('Shift Notes paragraphs', function() { RUN_PARAGRAPHS(); });
  run('Financial Claims and invoice queues', function() {
    INV_refreshInvoiceSheets_(ss);
  });
  run('Calendar and Support and Funding', function() {
    CALENDAR_AND_SUPPORT_REFRESH();
  });
  SpreadsheetApp.flush();
  const message = failures.length
    ? 'Refresh completed with errors in: ' + failures.join(', ') + '. See the execution log.'
    : 'Notes, Calendar, Support and Funding and invoice queues refreshed.';
  Logger.log(message);
  ss.toast(message, 'NDIA refresh', 8);
  if (failures.length) throw new Error(message);
  return message;
}

function GCAL4_rangeTouchesCell_(editedRange, a1) {
  const target = editedRange
    .getSheet()
    .getRange(a1);

  return (
    editedRange.getRow() <= target.getRow() &&
    editedRange.getLastRow() >= target.getRow() &&
    editedRange.getColumn() <= target.getColumn() &&
    editedRange.getLastColumn() >= target.getColumn()
  );
}

function GCAL4_getShiftNotesSheet_(ss) {
  for (
    let i = 0;
    i < GCAL4_CONFIG.responseSheets.length;
    i++
  ) {
    const sheet = ss.getSheetByName(
      GCAL4_CONFIG.responseSheets[i]
    );

    if (sheet) return sheet;
  }

  return null;
}

function GCAL4_renderStackedShiftCards_() {
  const ss = GCAL4_getSpreadsheet_();

  const calendar = ss.getSheetByName(
    GCAL4_CONFIG.calendarSheet
  );

  const responses = GCAL4_getShiftNotesSheet_(ss);

  if (!calendar || !responses) return;

  const regularShifts =
    ss.getSheetByName(GCAL4_CONFIG.regularShiftsSheet);

  const plannedRoster =
    GCAL4_getRegularRoster_(regularShifts);

  const awayByWorker =
    GCAL4_getAwayRanges_(ss, regularShifts);

  const scheduleExceptions =
    GCAL4_getScheduleExceptions_(ss, regularShifts);

  calendar.getImages().forEach(function(image) {
    const title =
      image.getAltTextTitle();

    if (
      [
        'GCI_OPEN_NOTE',
        'GCAL3_OPEN_NOTE',
        'GCAL4_OPEN_NOTE'
      ].indexOf(title) !== -1
    ) {
      image.remove();
    }
  });

  const headerRow = GCAL4_findShiftHeaderRow_(responses);

  const headers = responses
    .getRange(
      headerRow,
      1,
      1,
      responses.getLastColumn()
    )
    .getDisplayValues()[0];

  const nameCol =
    GCAL4_shiftDetailHeader_(
      headers,
      'Your name'
    ) ||
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['name']
    );

  const dateCol =
    GCAL4_shiftDetailHeader_(
      headers,
      'Date support was provided'
    ) ||
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['date', 'support']
    );

  const hoursCol =
    GCAL4_shiftDetailHeader_(
      headers,
      'How many hours of support did you provide?'
    ) ||
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['hours', 'support']
    ) ||
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['how long']
    );

  const startTimeCol =
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['start', 'time']
    );

  const outingCol =
    GCAL4_shiftDetailHeader_(
      headers,
      'What outings did you support Georgia with?'
    );

  const appointmentCol =
    GCAL4_shiftDetailHeader_(
      headers,
      'Which appointment was supported?'
    ) ||
    GCAL4_shiftDetailHeader_(
      headers,
      'Please specify any appointments Georgia attended.'
    ) ||
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['appointments', 'attended']
    );

  const detailCol =
    GCAL4_shiftDetailHeader_(
      headers,
      'Please elaborate on any outing or appointment.'
    );

  const supportedTasksCol =
    GCAL4_shiftDetailHeader_(
      headers,
      'What did you support Georgia to do?'
    );

  const noteCol =
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['generated paragraph']
    ) ||
    GCAL4_shiftDetailHeader_(
      headers,
      'Auto support paragraph'
    ) ||
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['support paragraph']
    );

  const moodCol =
    GCAL4_shiftDetailComparedColumn_(
      headers,
      ['general mood', 'emotional regulation']
    );

  const swallowingCol =
    GCAL4_shiftDetailComparedColumn_(
      headers,
      ['swallowing']
    );

  const anxietyCol =
    GCAL4_shiftDetailComparedColumn_(
      headers,
      ['anxiety']
    );

  const energyCol =
    GCAL4_shiftDetailComparedColumn_(
      headers,
      ['energy']
    );

  const cognitionCol =
    GCAL4_shiftDetailComparedColumn_(
      headers,
      ['cognition', 'thinking']
    );

  const painCol =
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['[pain]']
    );

  const painLocationCol =
    GCAL4_shiftDetailContainsColumn_(
      headers,
      ['if pain was worse']
    );

  if (!nameCol || !dateCol || !hoursCol) {
    throw new Error(
      'Calendar could not find the worker, date or hours columns in Shift Notes.'
    );
  }

  const lastRow = responses.getLastRow();

  const values =
    lastRow >= headerRow
      ? responses
          .getRange(
            headerRow,
            1,
            lastRow - headerRow + 1,
            responses.getLastColumn()
          )
          .getDisplayValues()
      : [];

  const byDate = {};

  values.forEach(function(row, index) {
    const actualRow = headerRow + index;

    if (actualRow === headerRow) return;

    const worker =
      String(
        row[nameCol - 1] || ''
      ).trim();

    const date =
      GCAL4_parseShiftDisplayDate_(
        row[dateCol - 1]
      );

    if (!worker || !date) return;

    const key =
      GCAL4_shiftDateKey_(date);

    if (!byDate[key]) {
      byDate[key] = [];
    }

    byDate[key].push({

      worker: worker,

      hours:
        String(
          row[hoursCol - 1] || ''
        ).trim(),

      startTimeText:
        startTimeCol
          ? String(row[startTimeCol - 1] || '').trim()
          : '',

      outing:
        outingCol
          ? GCAL4_shiftOutingLabel_(
              row[outingCol - 1],
              detailCol
                ? row[detailCol - 1]
                : ''
            )
          : '',

      appointment:
        appointmentCol
          ? GCAL4_shiftAppointmentLabel_(
              row[appointmentCol - 1],
              detailCol
                ? row[detailCol - 1]
                : '',
              supportedTasksCol
                ? row[supportedTasksCol - 1]
                : ''
            )
          : '',

      pain:
        GCAL4_shiftPainLabel_({
          pain:
            painCol
              ? row[painCol - 1]
              : '',

          painLocation:
            painLocationCol
              ? row[painLocationCol - 1]
              : ''
        }),

      wellbeing:
        GCAL4_shiftWellbeingLabel_({

          mood:
            moodCol
              ? row[moodCol - 1]
              : '',

          swallowing:
            swallowingCol
              ? row[swallowingCol - 1]
              : '',

          anxiety:
            anxietyCol
              ? row[anxietyCol - 1]
              : '',

          energy:
            energyCol
              ? row[energyCol - 1]
              : '',

          cognition:
            cognitionCol
              ? row[cognitionCol - 1]
              : ''
        }),

      responseRow:
        actualRow
    });
  });

  const month =
    GCAL4_shiftMonthIndex_(
      calendar
        .getRange(
          GCAL4_CONFIG.monthCell
        )
        .getDisplayValue()
    );

  const year =
    Number(
      calendar
        .getRange(
          GCAL4_CONFIG.yearCell
        )
        .getValue()
    );

  if (month < 0 || !year) return;

  const cardBorderColour =
    '#FFFFFF';

  const cardBorderStyle =
    SpreadsheetApp.BorderStyle.SOLID;

  GCAL4_CONFIG.dateRows.forEach(
    function(dateRow, weekIndex) {

      GCAL4_CONFIG.dayColumns.forEach(
        function(dayCol, dayIndex) {

          const workerCol =
            dayCol + 1;

          const day = GCAL4_calendarSlotDay_(
            year,
            month,
            weekIndex,
            dayIndex
          );

          if (
            !day ||
            day < 1 ||
            day > 31
          ) {
            GCAL4_resetDayCanvasToLiveBase_(
              calendar,
              dateRow,
              workerCol
            );

            return;
          }

          const dateKey =
            GCAL4_shiftDateKey_(
              new Date(
                year,
                month,
                day
              )
            );

          const entries =
            GCAL4_latestSubmitted_(byDate[dateKey] || []);

          const weekday =
            GCAL4_CONFIG.dayColumns.indexOf(dayCol) + 1;

          const rawPlannedShifts =
            plannedRoster[weekday] || [];

          const oneOffExceptionsForDay =
            GCAL4_getScheduleExceptionsForDate_(
              scheduleExceptions,
              dateKey
            );

          const changedPlannedItems =
            GCAL4_scheduleChangePlannedItems_(
              oneOffExceptionsForDay
            );

          const plannedShifts =
            GCAL4_uniqueCalendarItems_(
              rawPlannedShifts.filter(function(planned) {
                if (planned.isAppointment && oneOffExceptionsForDay.some(function(exception) {
                  return exception && exception.isPlannedAppointment &&
                    !exception.regularStartUnchanged &&
                    GCAL4_appointmentMatchKey_(
                      GCAL4_scheduleAppointmentLabel_(exception)
                    ) === GCAL4_appointmentMatchKey_(
                      planned.appointmentLabel || planned.worker
                    );
                })) return false;

                if(scheduleExceptions.some(function(exception) {
                  return !exception.regularStartUnchanged &&
                    exception.originalDay===dateKey&&
                    CS4_name_(exception.originalPerson||exception.worker)===CS4_name_(planned.worker);
                }))return false;
                return !GCAL4_plannedShiftHasOneOffException_(
                  oneOffExceptionsForDay,
                  planned.worker
                );
              }).concat(changedPlannedItems)
            );

          // Keep activities visible when the overlapping support worker is away.
          GCAL4_placeAppointmentsInsideShifts_(
            plannedShifts.filter(function(planned) {
              return planned.isAppointment || !GCAL4_getAwayRange_(
                awayByWorker, planned.worker, dateKey
              );
            })
          );
          GCAL4_hidePlannedEventsAlreadySubmitted_(plannedShifts, entries);

          plannedShifts.sort(function(a, b) {
            if (a.isAppointment !== b.isAppointment) {
              return a.isAppointment ? 1 : -1;
            }

            const aMinutes = a.startMinutes === null ||
              a.startMinutes === undefined
              ? 9999
              : a.startMinutes;
            const bMinutes = b.startMinutes === null ||
              b.startMinutes === undefined
              ? 9999
              : b.startMinutes;

            return aMinutes - bMinutes;
          });

          const georgiaAway =
            GCAL4_getAwayRange_(
              awayByWorker,
              'Georgia',
              dateKey
            );

          const savedAwayMessagesForDay = GCAL4_relevantAwayMessagesForShifts_(plannedShifts, awayByWorker, dateKey);

          if (entries.length === 0) {
            GCAL4_resetDayCanvasToLiveBase_(
              calendar,
              dateRow,
              workerCol
            );

            const exceptionLabelText =
              GCAL4_scheduleExceptionLabelText_(
                oneOffExceptionsForDay,
                plannedShifts
              );

            if (exceptionLabelText) {
              GCAL4_drawAwayLabel_(
                calendar,
                dateRow,
                workerCol,
                '',
                { note: exceptionLabelText }
              );
            }

            const savedAwayMessages = GCAL4_relevantAwayMessagesForShifts_(plannedShifts, awayByWorker, dateKey);

            if (savedAwayMessages.length && !exceptionLabelText && !georgiaAway) {
              GCAL4_drawAwayLabel_(
                calendar,
                dateRow,
                workerCol,
                '',
                { note: Array.from(new Set(savedAwayMessages)).join(' · ') }
              );
            }

            const supportPlannedForDay =
              plannedShifts.filter(function(planned) {
                return !planned.isAppointment;
              });

            if (georgiaAway && supportPlannedForDay.length > 0) {
              GCAL4_drawAwayLabel_(
                calendar,
                dateRow,
                workerCol,
                'Georgia',
                georgiaAway
              );

              return;
            }

            const availablePlannedItems =
              plannedShifts.filter(function(planned) {
                return !GCAL4_getAwayRange_(
                  awayByWorker,
                  planned.worker,
                  dateKey
                );
              });

            const availablePlannedShifts =
              availablePlannedItems.filter(function(planned) {
                return !planned.isAppointment;
              });

            const availableAppointmentLines =
              availablePlannedItems.filter(function(planned) {
                return planned.isAppointment &&
                  planned.showAppointmentLine !== false;
              });

            const regularAppointmentsInsideShifts =
              availablePlannedItems.filter(function(planned) {
                return planned.isAppointment &&
                  planned.showAppointmentLine === false &&
                  !planned.suppressSubmittedDuplicate;
              });

            const hasOutsideAppointmentLine =
              availableAppointmentLines.length > 0;

            availablePlannedShifts
              .slice(0, 2)
              .forEach(function(planned, position) {
                const shiftCount = Math.min(
                  availablePlannedShifts.length,
                  2
                );

                const plannedForDay = Object.assign({}, planned);

                plannedForDay.hasOutsideAppointmentLine =
                  hasOutsideAppointmentLine;
                plannedForDay.outsideAppointmentCount = Math.min(
                  availableAppointmentLines.length,
                  2
                );

                plannedForDay.inCardAppointments =
                  GCAL4_regularAppointmentsForShift_(
                    planned,
                    regularAppointmentsInsideShifts
                  );

                GCAL4_drawPlannedCard_(
                  calendar,
                  dateRow,
                  workerCol,
                  plannedForDay,
                  position,
                  shiftCount
                );
              });

            if (availableAppointmentLines.length > 0) {
              GCAL4_drawPlannedCard_(
                calendar,
                dateRow,
                workerCol,
                GCAL4_combineAppointmentLines_(availableAppointmentLines),
                0,
                Math.max(availablePlannedShifts.length, 1)
              );
            }

            return;
          }

          GCAL4_resetDayCanvasToLiveBase_(
            calendar,
            dateRow,
            workerCol
          );

          if (savedAwayMessagesForDay.length && !GCAL4_scheduleExceptionLabelText_(oneOffExceptionsForDay, plannedShifts) && !georgiaAway) {
            GCAL4_drawAwayLabel_(
              calendar,
              dateRow,
              workerCol,
              '',
              { note: Array.from(new Set(savedAwayMessagesForDay)).join(' · ') }
            );
          }

          const completedExceptionLabelText =
            GCAL4_scheduleExceptionLabelText_(
              oneOffExceptionsForDay,
              plannedShifts
            );

          const availableCompletedPlannedItems =
            plannedShifts.filter(function(planned) {
              return !GCAL4_getAwayRange_(
                awayByWorker,
                planned.worker,
                dateKey
              );
            });

          const availableCompletedAppointmentLines =
            availableCompletedPlannedItems.filter(function(planned) {
              return planned.isAppointment &&
                planned.showAppointmentLine !== false;
            });

          const regularCompletedAppointmentsInsideShifts =
            availableCompletedPlannedItems.filter(function(planned) {
              return planned.isAppointment &&
                planned.showAppointmentLine === false &&
                !planned.suppressSubmittedDuplicate;
            });

          const hasCompletedOutsideAppointmentLine =
            availableCompletedAppointmentLines.length > 0;

          const supportPlannedShifts =
            plannedShifts.filter(function(planned) {
              return !planned.isAppointment;
            });

          const scheduledDouble =
            supportPlannedShifts.length > 1;

          const activeWorkerKeys = {};
          supportPlannedShifts.forEach(function(planned) {
            if (GCAL4_getAwayRange_(awayByWorker, planned.worker, dateKey)) return;
            const key = String(planned.worker || '').trim().toLowerCase();
            if (key) activeWorkerKeys[key] = true;
          });
          entries.forEach(function(entry) {
            const key = String(entry.worker || '').trim().toLowerCase();
            if (key) activeWorkerKeys[key] = true;
          });

          const completedDoubleShift =
            entries.length > 1 ||
            (
              Object.keys(activeWorkerKeys).length > 1 &&
              !georgiaAway &&
              !completedExceptionLabelText
            );

          const usedPositions = {};

          const completedSlots =
            entries
              .slice(0, 2)
              .map(function(entry, index) {
                let position = index;

                if (
                  completedDoubleShift &&
                  scheduledDouble
                ) {
                  const workerKey =
                    String(entry.worker || '')
                      .trim()
                      .toLowerCase();

                  const rosterPosition =
                    plannedShifts
                      .slice(0, 2)
                      .findIndex(function(planned) {
                        return (
                          String(planned.worker || '')
                            .trim()
                            .toLowerCase() === workerKey
                        );
                      });

                  if (
                    rosterPosition >= 0 &&
                    !usedPositions[rosterPosition]
                  ) {
                    position = rosterPosition;
                  } else {
                    const awayPosition =
                      supportPlannedShifts
                        .slice(0, 2)
                        .findIndex(function(planned) {
                          return !!GCAL4_getAwayRange_(
                            awayByWorker,
                            planned.worker,
                            dateKey
                          );
                        });

                    if (
                      awayPosition >= 0 &&
                      !usedPositions[awayPosition]
                    ) {
                      position = awayPosition;
                    } else {
                      position = usedPositions[0] ? 1 : 0;
                    }
                  }
                }

                usedPositions[position] = true;

                return {
                  entry: entry,
                  position: position
                };
              })
              .sort(function(a, b) {
                return a.position - b.position;
              });

          const completedWorkerKeys = {};

          entries.forEach(function(entry) {
            completedWorkerKeys[
              String(entry.worker || '')
                .trim()
                .toLowerCase()
            ] = true;
          });

          if (
            completedDoubleShift &&
            scheduledDouble &&
            !georgiaAway
          ) {
            supportPlannedShifts
              .slice(0, 2)
              .forEach(function(planned, position) {
                const workerKey = String(planned.worker || '')
                  .trim()
                  .toLowerCase();
                if (
                  completedWorkerKeys[workerKey] ||
                  GCAL4_getAwayRange_(
                    awayByWorker,
                    planned.worker,
                    dateKey
                  )
                ) {
                  return;
                }

                const cardPosition = position;

                GCAL4_drawPlannedCard_(
                  calendar,
                  dateRow,
                  workerCol,
                  planned,
                  cardPosition,
                  2
                );
              });
          }

          completedSlots
            .forEach(
              function(
                slot
              ) {

                const entry = slot.entry;

                const position = completedDoubleShift
                  ? slot.position
                  : 0;

                const doubleShift =
                  completedDoubleShift;

                const startRow =
                  doubleShift
                    ? dateRow +
                      position * 4
                    : dateRow + 1;

                const cardHeight =
                  doubleShift
                    ? 3
                    : availableCompletedAppointmentLines.length > 1
                      ? 5
                      : availableCompletedAppointmentLines.length === 1
                        ? 6
                        : 7;

                const detailRows =
                  cardHeight - 1;

                const workerKey =
                  entry.worker
                    .toLowerCase();

                const headerFill =
                  '#FFFFFF';

                const bodyFill =
                  '#FFFFFF';

                const nameRange =
                  calendar.getRange(
                    startRow,
                    workerCol,
                    1,
                    1
                  );

                const hoursCell =
                  calendar.getRange(
                    startRow,
                    workerCol + 1,
                    1,
                    2
                  );

                const card =
                  calendar.getRange(
                    startRow,
                    workerCol,
                    cardHeight,
                    3
                  );

                const matchingPlannedShift =
                  supportPlannedShifts.find(function(planned) {
                    return String(planned.worker || '')
                      .trim()
                      .toLowerCase() ===
                      String(entry.worker || '')
                        .trim()
                        .toLowerCase();
                  }) || null;

                const completedAppointment =
                  GCAL4_completedAppointmentLabel_(
                    entry.appointment,
                    matchingPlannedShift,
                    regularCompletedAppointmentsInsideShifts,
                    dateKey
                  );

                const completedAppointmentCategory =
                  GCAL4_appointmentCategory_(completedAppointment.text);
                const completedAppointmentDocumented = !!String(
                  entry.appointment || ''
                ).trim();
                const completedAppointmentIsActivity =
                  completedAppointment.isActivity === true;
                const completedAppointmentHasBorder =
                  completedAppointmentIsActivity
                    ? completedAppointment.isSupportedActivity === true
                    : !!completedAppointment.text;

                const ordinaryLabels = [

                  {
                    text: completedAppointment.text,
                    colour:
                      completedAppointment.text
                        ? completedAppointmentCategory === 'NON NDIS'
                          ? '#8A959A'
                          : completedAppointmentIsActivity
                          ? completedAppointmentHasBorder
                            ? '#9A5FA8'
                            : '#666666'
                          : '#123F52'
                        : '#146082',
                    textColour: '#123F52',
                    fineBorder:
                      !completedAppointmentHasBorder,
                    showBorder:
                      completedAppointmentHasBorder,
                    borderStyle:
                      completedAppointmentHasBorder
                        ? SpreadsheetApp.BorderStyle.SOLID_MEDIUM
                        : SpreadsheetApp.BorderStyle.SOLID
                  },

                  {
                    text:
                      entry.outing,
                    colour:
                      '#9A5FA8'
                  },

                  {
                    text:
                      entry.wellbeing
                        ? entry
                            .wellbeing
                            .text
                        : '',

                    colour:
                      entry.wellbeing
                        ? entry
                            .wellbeing
                            .colour
                        : null
                  }

                ]
                  .filter(function(label) {
                    return label.text;
                  })
                  .filter(function(label, index, allLabels) {
                    const key = String(label.text || '')
                      .trim()
                      .toLowerCase();
                    return allLabels.findIndex(function(candidate) {
                      return String(candidate.text || '')
                        .trim()
                        .toLowerCase() === key;
                    }) === index;
                  });

                let labels;

                if (entry.pain) {

                  labels =
                    ordinaryLabels
                      .slice(
                        0,
                        Math.max(
                          detailRows - 1,
                          0
                        )
                      )
                      .concat([
                        {
                          text:
                            entry.pain,

                          colour:
                            '#FF0000'
                        }
                      ]);

                } else {

                  labels =
                    ordinaryLabels
                      .slice(
                        0,
                        detailRows
                      );
                }

                card
                  .setBackground(
                    bodyFill
                  )
                  .setFontFamily(
                    'Montserrat'
                  )
                  .setFontColor(
                    '#123F52'
                  )
                  .setFontSize(12)
                  .setFontWeight(
                    'bold'
                  )
                  .setVerticalAlignment(
                    'middle'
                  );

                calendar
                  .getRange(
                    startRow,
                    workerCol + 2,
                    cardHeight,
                    1
                  )
                  .setBorder(
                    null,
                    null,
                    null,
                    true,
                    null,
                    null,
                    cardBorderColour,
                    cardBorderStyle
                  );

                for (
                  let detailIndex = 0;
                  detailIndex < detailRows;
                  detailIndex++
                ) {

                  const isBottomDetailRow =
                    detailIndex === detailRows - 1;

                  const detailRow =
                    startRow +
                    1 +
                    detailIndex;

                  const labelRange =
                    calendar.getRange(
                      detailRow,
                      workerCol,
                      1,
                      3
                    );

                  GCAL4_mergeSafely_(labelRange);

                  const label =
                    labels[
                      detailIndex
                    ];

                  labelRange
                    .clearContent()
                    .setFontFamily(
                      'Montserrat'
                    )
                    .setFontSize(12)
                    .setFontWeight(
                      'normal'
                    )
                    .setFontColor(
                      label && label.textColour
                        ? label.textColour
                        : label && label.fineBorder
                          ? label.colour
                          : '#123F52'
                    )
                    .setHorizontalAlignment(
                      'left'
                    )
                    .setVerticalAlignment(
                      'middle'
                    )
                    .setWrap(false);

                  if (label) {
                    calendar
                      .getRange(
                        detailRow,
                        workerCol
                      )
                      .setValue(
                        label.text
                      );
                  }

                  if (
                    label &&
                    label.showBorder !== false
                  ) {
                    const indicatorRange = isBottomDetailRow
                      ? calendar.getRange(detailRow, workerCol, 1, 3)
                      : labelRange;

                    indicatorRange.setBorder(
                      null,
                      null,
                      true,
                      null,
                      null,
                      null,
                      label.colour,
                      label.borderStyle ||
                        (label.fineBorder
                          ? SpreadsheetApp.BorderStyle.SOLID
                          : SpreadsheetApp.BorderStyle.SOLID_MEDIUM)
                    );
                  }
                }

                const url =
                  GCAL4_shiftNoteUrlForSourceRow_(
                    ss,
                    entry.responseRow
                  );

                nameRange
                  .setFormula(
                    '=HYPERLINK("' +
                    url.replace(
                      /"/g,
                      '""'
                    ) +
                    '","' +
                    entry.worker.replace(
                      /"/g,
                      '""'
                    ) +
                    '")'
                  )
                  .setFontFamily(
                    'Montserrat'
                  )
                  .setFontSize(14)
                  .setFontWeight(
                    'bold'
                  )
                  .setFontColor(
                    '#123F52'
                  )
                  .setFontLine(
                    'none'
                  )
                  .setHorizontalAlignment(
                    'left'
                  )
                  .setVerticalAlignment(
                    'middle'
                  );

                GCAL4_mergeSafely_(hoursCell)
                  .setValue(
                    GCAL4_shiftTimeRangeLabel_(
                      GCAL4_submittedStart_(entry, supportPlannedShifts),
                      entry.hours
                    )
                  )
                  .setFontFamily(
                    'Montserrat'
                  )
                  .setFontSize(8)
                  .setFontWeight(
                    'bold'
                  )
                  .setFontColor(
                    '#123F52'
                  )
                  .setHorizontalAlignment(
                    'center'
                  )
                  .setVerticalAlignment(
                    'bottom'
                  )
                  .setBorder(
                    true,
                    true,
                    true,
                    true,
                    false,
                    false,
                    cardBorderColour,
                    cardBorderStyle
                  );

                const iconRow =
                  startRow;

                const iconCol =
                  workerCol + 3;

                const iconCell = calendar.getRange(
                  iconRow,
                  iconCol
                );

                const shiftViewUrl =
                  GCAL4_shiftNoteUrlForSourceRow_(
                    ss,
                    entry.responseRow
                  );

                const iconFormula =
                  '=HYPERLINK("' +
                  shiftViewUrl.replace(/"/g, '""') +
                  '",IMAGE("' +
                  String(GCAL4_CONFIG.noteIconUrl).replace(/"/g, '""') +
                  '",4,18,18))';

                iconCell
                  .clearContent()
                  .setFormula(iconFormula)
                  .setBackground(bodyFill)
                  .setHorizontalAlignment('right')
                  .setVerticalAlignment('bottom');

                calendar
                  .getRange(startRow, workerCol, 1, 4)
                  .setBorder(
                    null,
                    null,
                    true,
                    null,
                    null,
                    null,
                    '#123F52',
                    SpreadsheetApp.BorderStyle.DOTTED
                  );

              }
            );

          if (completedExceptionLabelText) {
            GCAL4_drawAwayLabel_(
              calendar,
              dateRow,
              workerCol,
              '',
              { note: completedExceptionLabelText }
            );
          }

          if (availableCompletedAppointmentLines.length > 0) {
            const submittedAppointments = GCAL4_combineAppointmentLines_(
              availableCompletedAppointmentLines
            );
            submittedAppointments.submittedShiftExists = true;

            GCAL4_drawPlannedCard_(
              calendar,
              dateRow,
              workerCol,
              submittedAppointments,
              0,
              Math.max(
                supportPlannedShifts.length,
                1
              )
            );
          }


        }
      );

    }
  );

}

function GCAL4_resetDayCanvasToLiveBase_(
  calendar,
  dateRow,
  workerCol
) {
  // Clear all nine day rows, including old status labels on the last row.
  const body = calendar.getRange(dateRow, workerCol, 9, 4);

  body.getMergedRanges().forEach(function(merged) {
    merged.breakApart();
  });

  body.clearContent();
  body
    .setBackground('#FFFFFF')
    .setFontFamily('Montserrat')
    .setFontStyle('normal')
    .setFontLine('none');
  body.setBorder(null, null, null, null, false, false);
  calendar.getRange(dateRow + 7, workerCol, 1, 3)
    .setBorder(null, null, false, null, null, null);
}

function GCAL4_getRegularRoster_(regular) {
  const roster = {};

  if (!regular || regular.getLastRow() < 2) {
    return roster;
  }

  const rowCount = regular.getLastRow() - 1;

  const rawRows = regular
    .getRange(2, 1, rowCount, 6)
    .getValues();
  const displayRows = regular
    .getRange(2, 1, rowCount, 6)
    .getDisplayValues();

  rawRows.forEach(function(row, index) {
    const displayRow = displayRows[index] || [];

    const weekday = Number(row[0] || displayRow[0]);
    const worker = String(row[2] || displayRow[2] || '').trim();
    const hours = row[3];

    const startTimeText = GCAL4_regularShiftDisplayTime_(
      row[5],
      displayRow[5]
    );

    const active =
      row[4] === true ||
      String(row[4] || displayRow[4] || '')
        .trim()
        .toLowerCase() === 'true';

    const workerKey = worker.toLowerCase();

    const isAppointment =
      workerKey === 'rebecca' ||
      workerKey === 'rebecca somervaille' ||
      workerKey.indexOf('rebecca') !== -1 ||
      workerKey.indexOf('psych') !== -1;

    const startMinutes =
      GCAL4_parseRegularShiftTimeMinutes_(row[5], startTimeText);

    const numericHours = Number(hours);
    const durationMinutes =
      !isNaN(numericHours) && numericHours > 0
        ? Math.round(numericHours * 60)
        : isAppointment
          ? 60
          : null;

    const endMinutes =
      startMinutes !== null && durationMinutes !== null
        ? startMinutes + durationMinutes
        : null;

    if (
      weekday >= 1 &&
      weekday <= 7 &&
      worker &&
      active
    ) {
      if (!roster[weekday]) {
        roster[weekday] = [];
      }

      roster[weekday].push({
        worker: worker,
        appointmentLabel: isAppointment
          ? GCAL4_tagAppointmentLabel_(worker)
          : '',
        hours: hours,
        startTimeText: startTimeText,
        startMinutes: startMinutes,
        endMinutes: endMinutes,
        isAppointment: isAppointment,
        showAppointmentLine: isAppointment
      });
    }
  });

  Object.keys(roster).forEach(function(weekday) {
    const items = roster[weekday];

    const ordinaryShifts = items.filter(function(item) {
      return !item.isAppointment;
    });

    items.forEach(function(item) {
      if (!item.isAppointment) return;

      item.showAppointmentLine = !ordinaryShifts.some(function(shift) {
        return GCAL4_timeRangesOverlap_(
          item.startMinutes,
          item.endMinutes,
          shift.startMinutes,
          shift.endMinutes
        );
      });
    });

    items.sort(function(a, b) {
      if (a.isAppointment && !b.isAppointment) return 1;
      if (!a.isAppointment && b.isAppointment) return -1;

      const aMinutes = a.startMinutes;
      const bMinutes = b.startMinutes;
      if (aMinutes !== null && bMinutes !== null) {
        return aMinutes - bMinutes;
      }

      const aHours = Number(a.hours);
      const bHours = Number(b.hours);

      if (isNaN(aHours) || isNaN(bHours)) {
        return 0;
      }

      return aHours - bHours;
    });
  });

  return roster;
}

function GCAL4_regularShiftDisplayTime_(rawValue, displayValue) {
  const displayText = String(displayValue || '')
    .trim()
    .replace(/\s+/g, ' ');

  if (displayText) {
    return displayText;
  }

  if (typeof rawValue === 'number' && rawValue >= 0 && rawValue < 1) {
    return GCAL4_minutesToRegularTimeText_(Math.round(rawValue * 24 * 60));
  }

  if (rawValue instanceof Date) {
    return GCAL4_minutesToRegularTimeText_(
      rawValue.getHours() * 60 + rawValue.getMinutes()
    );
  }

  return '';
}

function GCAL4_minutesToRegularTimeText_(minutes) {
  if (minutes === null || isNaN(minutes)) return '';

  minutes = ((Math.round(minutes) % 1440) + 1440) % 1440;

  const hour24 = Math.floor(minutes / 60);
  const minute = minutes % 60;
  const suffix = hour24 >= 12 ? 'pm' : 'am';
  let hour12 = hour24 % 12;
  if (hour12 === 0) hour12 = 12;

  return hour12 + ':' + String(minute).padStart(2, '0') + ' ' + suffix;
}

function GCAL4_parseRegularShiftTimeMinutes_(rawValue, textValue) {
  const text = String(textValue || '')
    .trim()
    .toLowerCase();

  if (text) {
    const match = text.match(/^(\d{1,2})(?::(\d{2}))?\s*(am|pm)?$/i);

    if (match) {
      let hour = Number(match[1]);
      const minute = match[2] ? Number(match[2]) : 0;
      const suffix = match[3] || '';

      if (suffix === 'pm' && hour < 12) hour += 12;
      if (suffix === 'am' && hour === 12) hour = 0;

      if (hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59) {
        return hour * 60 + minute;
      }
    }
  }

  if (typeof rawValue === 'number' && rawValue >= 0 && rawValue < 1) {
    return Math.round(rawValue * 24 * 60);
  }

  if (rawValue instanceof Date) {
    return rawValue.getHours() * 60 + rawValue.getMinutes();
  }

  return null;
}

function GCAL4_scheduleChangeStartUnchanged_(exception, regularRoster) {
  if (!exception || !regularRoster) return false;

  const type = String(exception.type || '').trim();
  if (!/^(?:changed|regular)$/i.test(type)) return false;

  const currentDay = GCAL4_shiftDateKey_(
    exception.startKey || exception.day || exception.start
  );
  const originalDay = GCAL4_shiftDateKey_(
    exception.originalDay || currentDay
  );
  if (!currentDay || !originalDay || currentDay !== originalDay) return false;

  const startMinutes = GCAL4_parseRegularShiftTimeMinutes_(
    null,
    GCAL4_compactAppointmentTimeText_(
      exception.timeText || exception.time || ''
    )
  );
  if (startMinutes === null) return false;

  const weekday = new Date(originalDay + 'T12:00:00Z').getUTCDay() || 7;
  const person = CS4_name_(
    exception.originalPerson || exception.worker || exception.person
  );

  return (regularRoster[weekday] || []).some(function(shift) {
    return !shift.isAppointment &&
      CS4_name_(shift.worker) === person &&
      shift.startMinutes === startMinutes;
  });
}

function GCAL4_timeRangesOverlap_(aStart, aEnd, bStart, bEnd) {
  if (
    aStart === null ||
    aEnd === null ||
    bStart === null ||
    bEnd === null
  ) {
    return false;
  }

  return aStart <= bEnd && aEnd >= bStart;
}

function GCAL4_getScheduleExceptions_(ssOrRegularShifts, optionalRegularShifts) {
  const exceptions = [];
  const seen = {};

  let ss = null;
  let regularShifts = optionalRegularShifts || null;

  if (
    ssOrRegularShifts &&
    typeof ssOrRegularShifts.getSheetByName === 'function'
  ) {
    ss = ssOrRegularShifts;
  } else {
    regularShifts = ssOrRegularShifts;
  }

  const regularRoster = regularShifts
    ? GCAL4_getRegularRoster_(regularShifts)
    : {};

  let rows = [];
  if (ss) {
    const table = CS4_table_(ss);
    rows = CS4_readChanges_(table, false).map(function(item) {
      const exception = {
        startKey: item.day,
        endKey: item.until || item.day,
        worker: item.person,
        workerKey: String(item.person || '').toLowerCase(),
        type: item.cancelled ? 'Cancelled' : item.type,
        timeText: item.allDay ? '' : item.time,
        hours: item.hours,
        duringSupportShift: item.support || '',
        note: item.note || '',
        extraDetails: item.note || '',
        originalDay: item.originalDay || '',
        originalPerson: item.originalPerson || item.person,
        addedBy: '',
        isPlannedAppointment: GCAL4_isAppointmentExceptionType_(item.type),
        show: item.show !== false
      };
      exception.regularStartUnchanged =
        GCAL4_scheduleChangeStartUnchanged_(exception, regularRoster);
      return exception;
    });
  } else if (regularShifts) {
    rows = GCAL4_readLegacyScheduleChangesTable_(regularShifts).rows;
  }

  rows.forEach(function(row) {
    const startKey = GCAL4_shiftDateKey_(row.startKey || row.start);
    const endKey = GCAL4_shiftDateKey_(row.endKey || row.end) || startKey;
    const worker = String(row.worker || '').trim();
    const type = String(row.type || '').trim();
    if (!worker || !startKey || !type || row.show === false) return;
    const key = [startKey, endKey, worker.toLowerCase(), type.toLowerCase(),
      String(row.timeText || '').toLowerCase(), String(row.note || '').toLowerCase()].join('|');
    if (seen[key]) return;
    seen[key] = true;
    exceptions.push({
      startKey: startKey <= endKey ? startKey : endKey,
      endKey: startKey <= endKey ? endKey : startKey,
      worker: worker,
      workerKey: worker.toLowerCase(),
      type: type,
      timeText: GCAL4_compactAppointmentTimeText_(row.timeText || ''),
      hours: row.hours,
      duringSupportShift: row.duringSupportShift || '',
      note: String(row.note || '').trim(),
      extraDetails: String(row.extraDetails || '').trim(),
      originalDay: row.originalDay || '',
      originalPerson: row.originalPerson || worker,
      addedBy: row.addedBy || '',
      isPlannedAppointment: row.isPlannedAppointment === true || GCAL4_isAppointmentExceptionType_(type),
      regularStartUnchanged: row.regularStartUnchanged === true ||
        GCAL4_scheduleChangeStartUnchanged_({
          startKey: startKey,
          timeText: row.timeText || '',
          type: type,
          worker: worker,
          originalDay: row.originalDay || '',
          originalPerson: row.originalPerson || worker
        }, regularRoster),
      show: true
    });
  });

  return exceptions;
}

function GCAL4_readLegacyScheduleChangesTable_(sheet) {
  if (!sheet || sheet.getLastRow() < 2) {
    return { rows: [], columns: GCAL4_legacyScheduleChangeColumns_() };
  }

  const columns = GCAL4_legacyScheduleChangeColumns_();
  const range = sheet.getRange(2, 8, sheet.getLastRow() - 1, 12);
  const displayed = range.getDisplayValues();
  const raw = range.getValues();

  const rows = displayed.map(function(row, index) {
    const result = row.slice();
    result[columns.start] = raw[index][columns.start];
    result[columns.end] = raw[index][columns.end];
    return result;
  });

  return { rows: rows, columns: columns };
}

function GCAL4_legacyScheduleChangeColumns_() {
  return {
    start: 0,
    end: 1,
    worker: 2,
    type: 3,
    time: 4,
    hours: 5,
    during: 6,
    show: 7,
    note: 8,
    details: 9,
    addedBy: 10
  };
}

function GCAL4_isAppointmentExceptionType_(type) {
  return /appointment|activity|\bappt\b/i.test(String(type || ''));
}

function GCAL4_scheduleAppointmentLabel_(exception) {
  if (!exception) return '';

  const worker = String(exception.worker || '').trim();
  const note = String(exception.note || '').trim();

  const label = /^other$/i.test(worker) && note
    ? note
    : worker;

  return GCAL4_tagAppointmentLabel_(label);
}

function GCAL4_appointmentCategory_(label) {
  const text = String(label || '').trim().toLowerCase();
  if (!text) return '';
  if (/\bnon[ -]?ndis\b/i.test(text)) return 'NON NDIS';

  if (
    /rebecca|psycholog|neurophysio|physiotherap|\bphysio\b|speech|occupational therap|\bot\b|allied health|\bndis\b/i.test(text)
  ) {
    return 'NDIS';
  }

  if (
    /psychiatr|crisis|safety check|\bgp\b|doctor|dentist|hospital|medical|clinic/i.test(text)
  ) {
    return 'NON NDIS';
  }

  return '';
}

function GCAL4_isActivityLabel_(label) {
  return /safety check|work training|hot springs|community|social|outing|workshop|class|event|walk|shopping|grocer|errand/i.test(
    String(label || '')
  );
}

function GCAL4_isDuringSupportShift_(value) {
  const text = String(value || '').trim().toLowerCase();
  return text === 'yes' || text === 'y' || text.indexOf('yes') === 0 ||
    text.indexOf('support') !== -1;
}

function GCAL4_tagAppointmentLabel_(label) {
  const text = String(label || '').trim();
  return GCAL4_untagAppointmentLabel_(text);
}

function GCAL4_untagAppointmentLabel_(label) {
  const text = String(label || '')
    .replace(/^(?:NDIS|NON NDIS)\s*·\s*/i, '')
    .trim();

  return /(?:mental health|crisis) team/i.test(text)
    ? 'Crisis Team'
    : text;
}

function GCAL4_getScheduleExceptionsForDate_(exceptions, dateKey) {
  if (!exceptions || !exceptions.length || !dateKey) return [];

  return exceptions.filter(function(exception) {
    return dateKey >= exception.startKey &&
      dateKey <= exception.endKey;
  });
}

function GCAL4_scheduleChangePlannedItems_(exceptionsForDay) {
  if (!exceptionsForDay || !exceptionsForDay.length) return [];

  return exceptionsForDay
    .filter(function(exception) {
      if (!exception) return false;

      if (exception.isPlannedAppointment) {
        return true;
      }

      return GCAL4_exceptionCreatesShift_(exception);
    })
    .map(function(exception) {
      const startTimeText = GCAL4_compactAppointmentTimeText_(
        exception.timeText || ''
      );
      const startMinutes = GCAL4_parseRegularShiftTimeMinutes_(
        null,
        startTimeText
      );
      const numericHours = Number(exception.hours);
      const isAppointment = exception.isPlannedAppointment === true;
      const appointmentLabel = isAppointment
        ? GCAL4_scheduleAppointmentLabel_(exception)
        : exception.worker;
      const isActivity = isAppointment &&
        (/^activity$/i.test(exception.type) || GCAL4_isActivityLabel_(appointmentLabel));
      const durationMinutes =
        !isNaN(numericHours) && numericHours > 0
          ? Math.round(numericHours * 60)
          : isAppointment
            ? 60
            : null;

      return {
        worker: exception.worker,
        appointmentLabel: appointmentLabel,
        hours: exception.hours,
        startTimeText: startTimeText,
        startMinutes: startMinutes,
        endMinutes:
          startMinutes !== null && durationMinutes !== null
            ? startMinutes + durationMinutes
            : null,
        isAppointment: isAppointment,
        isActivity: isActivity,
        isSupportedActivity: isActivity &&
          GCAL4_isDuringSupportShift_(exception.duringSupportShift),
        showAppointmentLine: isAppointment,
        duringSupportShift: exception.duringSupportShift,
        addedBy: exception.addedBy,
        fromScheduleChange: true
      };
    });
}

function GCAL4_placeAppointmentsInsideShifts_(items) {
  if (!items || !items.length) return;

  const shifts = items.filter(function(item) {
    return item && !item.isAppointment;
  });

  items.forEach(function(appointment) {
    if (!appointment || !appointment.isAppointment) return;

    const duringText = String(appointment.duringSupportShift || '')
      .trim()
      .toLowerCase();
    const unsupported = /unsupported|not supported|outside support|outside of support|\bno\b/.test(duringText);

    if (unsupported) {
      appointment.insideShiftWorkerKey = '';
      appointment.showAppointmentLine = true;
      return;
    }

    let matchingShift = shifts.find(function(shift) {
      return GCAL4_timeRangesOverlap_(
        appointment.startMinutes,
        appointment.endMinutes,
        shift.startMinutes,
        shift.endMinutes
      );
    }) || null;

    const markedDuringSupport =
      duringText === 'yes' ||
      duringText === 'y' ||
      duringText.indexOf('yes') === 0 ||
      duringText.indexOf('support') !== -1;

    if (!matchingShift && markedDuringSupport && shifts.length === 1) {
      matchingShift = shifts[0];
    }

    appointment.insideShiftWorkerKey = matchingShift
      ? String(matchingShift.worker || '').trim().toLowerCase()
      : '';
    appointment.showAppointmentLine = !matchingShift;
  });
}

function GCAL4_hidePlannedEventsAlreadySubmitted_(plannedItems, submittedEntries) {
  if (!plannedItems || !submittedEntries || !submittedEntries.length) return;

  submittedEntries.forEach(function(entry) {
    const submittedLabels = [entry.appointment, entry.outing]
      .map(GCAL4_appointmentMatchKey_)
      .filter(Boolean);

    if (!submittedLabels.length) return;

    plannedItems.forEach(function(planned) {
      if (!planned || !planned.isAppointment) return;

      const plannedKey = GCAL4_appointmentMatchKey_(
        planned.appointmentLabel || planned.worker
      );

      const matchedSubmittedItem = submittedLabels.some(function(submittedKey) {
        return submittedKey === plannedKey ||
          submittedKey.indexOf(plannedKey) !== -1 ||
          plannedKey.indexOf(submittedKey) !== -1;
      });

      if (!plannedKey || !matchedSubmittedItem) return;

      const duringText = String(planned.duringSupportShift || '').trim().toLowerCase();
      const unsupported = duringText === 'no' || /unsupported|not supported|outside support|outside of support/.test(duringText);
      if (unsupported) {
        const clearIfMatches = function(value) {
          const key = GCAL4_appointmentMatchKey_(value);
          return key && (key === plannedKey ||
            key.indexOf(plannedKey) !== -1 ||
            plannedKey.indexOf(key) !== -1);
        };
        if (clearIfMatches(entry.appointment)) entry.appointment = '';
        if (clearIfMatches(entry.outing)) entry.outing = '';
        planned.showAppointmentLine = true;
        planned.suppressSubmittedDuplicate = false;
        planned.insideShiftWorkerKey = '';
        return;
      }

      entry.appointment = planned.appointmentLabel || entry.appointment;
      planned.showAppointmentLine = false;
      planned.suppressSubmittedDuplicate = true;
      planned.insideShiftWorkerKey = String(entry.worker || '')
        .trim()
        .toLowerCase();
    });
  });
}

function GCAL4_appointmentMatchKey_(value) {
  const key = GCAL4_untagAppointmentLabel_(value)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  return /(?:mental health|crisis) team/.test(key)
    ? 'mental health team'
    : key;
}

function GCAL4_isNonShiftExceptionType_(type) {
  const text = String(type || '')
    .trim()
    .toLowerCase()
    .replace(/[’]/g, "'");

  return /away|missed|did(?:\s+not|n'?t)\s+happen|cancel|not needed/.test(text);
}

function GCAL4_exceptionCreatesShift_(exception) {
  if (!exception || exception.isPlannedAppointment) return false;
  if (exception.regularStartUnchanged) return false;
  if (GCAL4_isNonShiftExceptionType_(exception.type)) return false;

  return !!String(exception.timeText || '').trim() ||
    Number(exception.hours) > 0;
}

function GCAL4_exceptionReplacesRegularShift_(exception) {
  if (!exception || exception.isPlannedAppointment) return false;
  if (exception.regularStartUnchanged) return false;
  if (GCAL4_isNonShiftExceptionType_(exception.type)) return true;
  if (!GCAL4_exceptionCreatesShift_(exception)) return false;

  const type = String(exception.type || '').trim().toLowerCase();
  return !/add|additional|extra|cover/.test(type);
}

function GCAL4_inCardPlannedAppointmentLabel_(appointments) {
  if (!appointments || !appointments.length) return '';

  return appointments
    .slice()
    .sort(function(a, b) {
      const aMinutes = a.startMinutes === null ||
        a.startMinutes === undefined ? 9999 : a.startMinutes;
      const bMinutes = b.startMinutes === null ||
        b.startMinutes === undefined ? 9999 : b.startMinutes;
      return aMinutes - bMinutes;
    })
    .map(function(appointment) {
      const who = String(
        appointment.appointmentLabel ||
        GCAL4_scheduleAppointmentLabel_(appointment) ||
        appointment.worker ||
        ''
      ).trim();
      const timeText = GCAL4_compactAppointmentTimeText_(
        appointment.timeText || ''
      );

      if (who && timeText) return who + ' ' + timeText;
      if (who) return who;
      return timeText;
    })
    .filter(Boolean)
    .join(' · ');
}

function GCAL4_regularAppointmentsForShift_(shift, appointments) {
  if (!shift || !appointments || !appointments.length) return [];

  return appointments
    .filter(function(appointment) {
      const assignedWorkerKey = String(
        appointment.insideShiftWorkerKey || ''
      ).trim().toLowerCase();
      const shiftWorkerKey = String(shift.worker || '')
        .trim()
        .toLowerCase();

      if (assignedWorkerKey) {
        return assignedWorkerKey === shiftWorkerKey;
      }

      return GCAL4_timeRangesOverlap_(
        appointment.startMinutes,
        appointment.endMinutes,
        shift.startMinutes,
        shift.endMinutes
      );
    })
    .map(function(appointment) {
      return {
        worker: appointment.worker,
        appointmentLabel:
          appointment.appointmentLabel || appointment.worker,
        timeText: appointment.startTimeText || '',
        startMinutes: appointment.startMinutes,
        addedBy: appointment.addedBy || '',
        isActivity: appointment.isActivity === true,
        isSupportedActivity: appointment.isSupportedActivity === true,
        suppressSubmittedDuplicate:
          appointment.suppressSubmittedDuplicate === true
      };
    });
}

function GCAL4_completedAppointmentLabel_(
  submittedLabel,
  shift,
  plannedAppointments,
  dateKey
) {
  const submitted = String(submittedLabel || '').trim();
  const planned = GCAL4_regularAppointmentsForShift_(
    shift,
    plannedAppointments
  ).filter(function(appointment) {
    return appointment.suppressSubmittedDuplicate !== true;
  }).slice().sort(function(a, b) {
    const aMinutes = a.startMinutes === null ||
      a.startMinutes === undefined ? 9999 : a.startMinutes;
    const bMinutes = b.startMinutes === null ||
      b.startMinutes === undefined ? 9999 : b.startMinutes;
    return aMinutes - bMinutes;
  });

  if (submitted) {
    if (planned.length === 1) {
      const timeText = GCAL4_compactAppointmentTimeText_(
        planned[0].timeText || ''
      );
      const submittedAlreadyHasTime =
        /\b\d{1,2}(?::\d{2})?\s*(?:am|pm)\b/i.test(submitted);
      const submittedLabel = GCAL4_tagAppointmentLabel_(submitted);
      const submittedWithTime = timeText && !submittedAlreadyHasTime
        ? submittedLabel + ' ' + timeText
        : submittedLabel;

      return {
        text: submittedWithTime,
        confirmed: true,
        isActivity: GCAL4_isActivityLabel_(submittedWithTime),
        isSupportedActivity: GCAL4_isActivityLabel_(submittedWithTime)
      };
    }

    if (planned.length > 1) {
      return {
        text: submitted + ' · time not recorded',
        confirmed: true,
        isActivity: GCAL4_isActivityLabel_(submitted),
        isSupportedActivity: GCAL4_isActivityLabel_(submitted)
      };
    }

    return {
      text: GCAL4_tagAppointmentLabel_(submitted),
      confirmed: true,
      isActivity: GCAL4_isActivityLabel_(submitted),
      isSupportedActivity: GCAL4_isActivityLabel_(submitted)
    };
  }

  if (!planned.length) {
    return {
      text: '',
      confirmed: false,
      isActivity: false,
      isSupportedActivity: false
    };
  }

  const todayKey = GCAL4_shiftDateKey_(new Date());
  const confirmedByCalendar =
    !!dateKey &&
    dateKey < todayKey &&
    planned.some(function(appointment) {
      return /google calendar/i.test(
        String(appointment.addedBy || '')
      );
    });

  return {
    text: GCAL4_inCardPlannedAppointmentLabel_(planned),
    confirmed: confirmedByCalendar,
    isActivity: planned.some(function(item) {
      return item.isActivity === true;
    }),
    isSupportedActivity: planned.some(function(item) {
      return item.isSupportedActivity === true;
    })
  };
}

function GCAL4_plannedShiftHasOneOffException_(exceptionsForDay, workerName) {
  const workerKey = String(workerName || '')
    .trim()
    .toLowerCase();

  if (!workerKey || !exceptionsForDay || !exceptionsForDay.length) {
    return false;
  }

  return exceptionsForDay.some(function(exception) {
    if (!exception || !exception.workerKey) return false;

    if (exception.isPlannedAppointment) return false;

    if (/\baway\b/i.test(String(exception.type || ''))) return false;

    if (!GCAL4_exceptionReplacesRegularShift_(exception)) return false;

    return exception.workerKey === workerKey;
  });
}

function GCAL4_scheduleExceptionLabelText_(exceptionsForDay, plannedShifts) {
  if (!exceptionsForDay || !exceptionsForDay.length) return '';

  return exceptionsForDay
    .filter(function(exception) {
      if (exception.isPlannedAppointment) return false;
      if (exception.regularStartUnchanged) return false;
      // An absence period only labels days with a shift for that worker.
      if (/\baway\b/i.test(String(exception.type || ''))) {
        const workerKey = CS4_name_(exception.worker);
        if (!(plannedShifts || []).some(function(shift) {
          return shift && !shift.isAppointment &&
            CS4_name_(shift.worker) === workerKey;
        })) return false;
      }


      const renderedAsShift = GCAL4_exceptionCreatesShift_(exception);

      return !renderedAsShift;
    })
    .map(function(exception) {
      if (GCAL4_isNonShiftExceptionType_(exception.type)) {
        const type = String(exception.type || '').toLowerCase();
        const status = /away/.test(type) ? 'away' : /cancel/.test(type) ? 'cancelled' : /not needed/.test(type) ? 'not needed' : 'missed';
        return exception.worker + ' ' + status;
      }
      if (exception.note) return exception.note;

      if (exception.type) {
        return exception.worker + ' ' + exception.type;
      }

      return exception.worker;
    })
    .filter(Boolean)
    .filter(function(value, index, all) { return all.indexOf(value) === index; })
    .join(' · ');
}

function GCAL4_getAwayRanges_(ssOrRegularShifts, optionalRegularShifts) {
  const awayByWorker = {};

  let ss = null;
  let regularShifts = optionalRegularShifts || null;

  if (
    ssOrRegularShifts &&
    typeof ssOrRegularShifts.getSheetByName === 'function'
  ) {
    ss = ssOrRegularShifts;
  } else {
    regularShifts = ssOrRegularShifts;
  }

  const scheduleChanges = ss ? ss.getSheetByName('Schedule Changes') : null;
  if (!scheduleChanges && (!regularShifts || regularShifts.getLastRow() < 2)) return awayByWorker;

  function addAway_(who, startValue, endValue, note, exceptionType) {
    const startKey = GCAL4_shiftDateKey_(startValue);
    const endKey = GCAL4_shiftDateKey_(endValue) || startKey;
    const whoText = String(who || '').trim();

    if (!whoText || !startKey) return;

    const whoKey = CS4_name_(whoText);

    if (!awayByWorker[whoKey]) {
      awayByWorker[whoKey] = [];
    }

    const rangeStart = startKey <= endKey ? startKey : endKey;
    const rangeEnd = startKey <= endKey ? endKey : startKey;
    const noteText = String(note || '').trim();
    const typeText = exceptionType || 'Away';
    if (awayByWorker[whoKey].some(function(existing) {
      return existing.startKey === rangeStart &&
        existing.endKey === rangeEnd &&
        existing.note === noteText &&
        existing.exceptionType === typeText;
    })) return;

    awayByWorker[whoKey].push({
      worker: whoText,
      startKey: rangeStart,
      endKey: rangeEnd,
      companion: noteText,
      note: noteText,
      exceptionType: typeText
    });
  }

  let usingScheduleChanges=false;
  if (scheduleChanges) {
    const saved=CS4_readChanges_(CS4_table_(ss),false);
    saved.forEach(function(item){if(/away/i.test(String(item.type||''))&&item.show!==false){usingScheduleChanges=true;addAway_(item.person,item.day,item.until,item.note,item.type);}});
  }

  if (!usingScheduleChanges && regularShifts && regularShifts.getLastRow() >= 2) {
    regularShifts
      .getRange(2, 7, regularShifts.getLastRow() - 1, 4)
      .getDisplayValues()
      .forEach(function(row) {
      const who = row[0];
      const startValue = row[1];
      const endValue = row[2];
      const note = row[3];

      if (!String(who || '').trim()) return;

      addAway_(who, startValue, endValue, note, 'Away');
      });
  }

  return awayByWorker;
}

function GCAL4_getAwayRange_(
  awayByWorker,
  worker,
  dateKey
) {
  const workerKey = CS4_name_(worker);

  if (!workerKey || !dateKey) {
    return null;
  }

  const ranges =
    awayByWorker[workerKey] || [];

  for (let i = 0; i < ranges.length; i++) {
    const range = ranges[i];

    if (
      dateKey >= range.startKey &&
      dateKey <= range.endKey
    ) {
      return range;
    }
  }

  return null;
}

function GCAL4_awayLabelText_(worker, awayRange) {
  function nameOnly(value) {
    return String(value || '').trim()
      .replace(/(?:[.,:;\s]+)?shift\s*notes?\b[\s\S]*$/i, '')
      .replace(/\s+(?:is\s+)?away\b[\s\S]*$/i, '')
      .replace(/[.,\s]+$/, '').trim();
  }
  const name = nameOnly(worker);
  if (name) return name + ' away';
  // Composite labels use a blank worker. Clean each away entry as well.
  // Non-away exceptions share this display function and keep their own text.
  return String(awayRange && awayRange.note || '').trim().split(/\s*·\s*|\n/)
    .map(function(text) {
      if (!/\baway\b/i.test(text)) return text;
      const person = nameOnly(text);
      return person ? person + ' away' : '';
    }).filter(Boolean).join(' · ');
}

function GCAL4_relevantAwayMessagesForShifts_(plannedShifts, awayByWorker, dateKey) {
  const relevantWorkers = {};
  (plannedShifts || []).forEach(function(planned) {
    if (!planned || planned.isAppointment || !planned.worker) return;
    relevantWorkers[CS4_name_(planned.worker)] = true;
  });

  return Object.keys(awayByWorker || {})
    .map(function(key) {
      return (awayByWorker[key] || [])
        .filter(function(range) {
          const worker = range.worker || key;
          return relevantWorkers[CS4_name_(worker)] &&
            range.startKey <= dateKey && range.endKey >= dateKey;
        })
        .map(function(range) {
          return GCAL4_awayLabelText_(range.worker || key, range);
        });
    })
    .reduce(function(all, values) {
      return all.concat(values);
    }, [])
    .filter(Boolean)
    .filter(function(value, index, all) {
      return all.indexOf(value) === index;
    });
}



function GCAL4_drawAwayLabel_(
  calendar,
  dateRow,
  workerCol,
  worker,
  awayRange
) {
  const label = calendar.getRange(
    dateRow,
    workerCol,
    1,
    3
  );

  label
    .getMergedRanges()
    .forEach(function(merged) {
      merged.breakApart();
    });

  const labelText = GCAL4_awayLabelText_(worker, awayRange);
  const currentText = String(label.getCell(1, 1).getDisplayValue() || '').trim();
  const merged = label.getMergedRanges();
  if (currentText === labelText && merged.some(function(range) {
    return range.getRow() === dateRow &&
      range.getColumn() === workerCol &&
      range.getNumRows() === 1 &&
      range.getNumColumns() === 3;
  })) return;

  GCAL4_unmergeForTarget_(label);
  label
    .clearContent();

  GCAL4_mergeSafely_(label)
    .setValue(labelText)
    .setBackground('#FFFFFF')
    .setFontFamily('Montserrat')
    .setFontSize(9)
    .setFontWeight('bold')
    .setFontStyle('normal')
    .setFontColor('#5C6F78')
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle')
    .setWrap(false);
}

function GCAL4_compactAppointmentTimeText_(timeText) {
  const text = String(timeText || '')
    .trim()
    .toLowerCase()
    .replace(/\s+/g, ' ');

  if (!text) return '';

  const match = text.match(/^(\d{1,2})(?:[:.](\d{2}))?(?::(\d{2}))?\s*([ap]\.?m\.?)?$/i);
  if (match) {
    let hour = Number(match[1]);
    const minute = Number(match[2] || 0);
    const second = Number(match[3] || 0);
    const meridiem = String(match[4] || '').replace(/\./g, '');
    if (minute < 60 && second < 60 &&
        (meridiem ? hour >= 1 && hour <= 12 : hour >= 0 && hour <= 23)) {
      if (meridiem) hour = hour % 12 + (meridiem === 'pm' ? 12 : 0);
      return String(hour % 12 || 12) +
        (minute ? ':' + ('0' + minute).slice(-2) : '') +
        (hour < 12 ? 'am' : 'pm');
    }
  }

  return text
    .replace(/\s*a\.?m\.?$/i, 'am')
    .replace(/\s*p\.?m\.?$/i, 'pm');
}

function GCAL4_combineAppointmentLines_(appointments) {
  const visible = (appointments || []).slice(0, 2);
  const combined = Object.assign({}, visible[0] || {
    isAppointment: true,
    worker: 'Appointment'
  });

  combined.isAppointment = true;
  combined.appointmentCount = visible.length;
  combined.appointmentLineItems = visible.map(function(appointment) {
    const timeText = GCAL4_compactAppointmentTimeText_(
      appointment.startTimeText
    );
    const label = String(
      appointment.appointmentLabel || appointment.worker || 'Appointment'
    ).trim();
    return {
      text: timeText ? label + ' · ' + timeText : label,
      appointmentLabel: label,
      isActivity: appointment.isActivity === true,
      isSupportedActivity: appointment.isSupportedActivity === true
    };
  }).filter(function(item) {
    return !!item.text;
  });
  combined.appointmentLines = combined.appointmentLineItems.map(function(item) {
    return item.text;
  });
  combined.appointmentText = combined.appointmentLines.join('\n');

  return combined;
}

function GCAL4_drawPlannedCard_(
  calendar,
  dateRow,
  workerCol,
  planned,
  position,
  shiftCount
) {
  const doubleShift = shiftCount > 1;

  const startRow = doubleShift
    ? dateRow + position * 4
    : dateRow + 1;
  const outsideAppointmentCount = Math.min(
    2,
    Number(planned && planned.outsideAppointmentCount) || 0
  );
  const cardHeight = doubleShift
    ? 3
    : outsideAppointmentCount > 1
      ? 5
      : outsideAppointmentCount === 1
        ? 6
        : 7;

  const card =
    calendar.getRange(
      startRow,
      workerCol,
      cardHeight,
      3
    );

  const plannedFill = '#FFFFFF';
  const plannedInk = '#A2C4C9';
  const plannedBorder = '#FFFFFF';
  const plannedBorderStyle =
    SpreadsheetApp.BorderStyle.SOLID;

  const plannedWorkerKey =
    String(planned.worker || '')
      .trim()
      .toLowerCase();

  const plannedIsAppointment =
    planned.isAppointment === true ||
    plannedWorkerKey === 'rebecca' ||
    plannedWorkerKey === 'rebecca somervaille' ||
    plannedWorkerKey.indexOf('rebecca') !== -1 ||
    plannedWorkerKey.indexOf('psych') !== -1;

  if (plannedIsAppointment) {
    const appointmentIsSubmitted =
      planned && planned.submittedShiftExists === true;

    const appointmentTimeText =
      GCAL4_compactAppointmentTimeText_(planned.startTimeText);

    const appointmentLabel = String(
      planned.appointmentLabel || planned.worker || ''
    ).trim();

    const appointmentText = String(planned.appointmentText || '').trim() ||
      (appointmentTimeText
        ? appointmentLabel + ' · ' + appointmentTimeText
        : appointmentLabel);
    const appointmentLines = Array.isArray(planned.appointmentLines) &&
      planned.appointmentLines.length
      ? planned.appointmentLines.slice(0, 2)
      : [appointmentText];
    const appointmentLineItems = Array.isArray(planned.appointmentLineItems) &&
      planned.appointmentLineItems.length
      ? planned.appointmentLineItems.slice(0, 2)
      : appointmentLines.map(function(text) {
        return {
          text: text,
          appointmentLabel: planned.appointmentLabel || planned.worker || text,
          isActivity: planned.isActivity === true,
          isSupportedActivity: planned.isSupportedActivity === true
        };
      });
    const firstAppointmentRow = dateRow + 8 - appointmentLines.length;

    const plannedAppointmentFill = '#FFFFFF';
    const appointmentBorderStyle = SpreadsheetApp.BorderStyle.SOLID_MEDIUM;

    appointmentLineItems.forEach(function(lineItem, index) {
      const lineText = lineItem.text;
      const appointmentRow = firstAppointmentRow + index;
      const appointmentLine = calendar.getRange(
        appointmentRow,
        workerCol,
        1,
        3
      );
      const showAppointmentBottomBorder = lineItem.isActivity
        ? lineItem.isSupportedActivity
        : true;
      const appointmentCategory = GCAL4_appointmentCategory_(
        lineItem.appointmentLabel || lineItem.worker || lineText
      );
      const isNonNdisAppointment = appointmentCategory === 'NON NDIS';
      const isNdisAppointment = appointmentCategory === 'NDIS';
      const lineBorderColour = appointmentIsSubmitted &&
        isNdisAppointment && lineItem.isActivity
        ? '#C2185B'
        : isNdisAppointment
          ? '#123F52'
          : isNonNdisAppointment
            ? '#8A959A'
            : lineItem.isActivity
              ? '#9A5FA8'
              : '#123F52';
      const appointmentInk = appointmentIsSubmitted
        ? '#123F52'
        : '#A1C4C9';

      GCAL4_unmergeForTarget_(appointmentLine);
      appointmentLine
        .clearContent();

      GCAL4_mergeSafely_(appointmentLine)
        .setValue(lineText)
        .setBackground(plannedAppointmentFill)
        .setFontFamily('Montserrat')
        .setFontSize(appointmentIsSubmitted ? 12 : 10)
        .setFontWeight('normal')
        .setFontStyle('normal')
        .setFontLine('none')
        .setFontColor(appointmentInk)
        .setHorizontalAlignment('left')
        .setVerticalAlignment('middle')
        .setWrap(false)
        .setBorder(
          null,
          null,
          appointmentIsSubmitted && (isNdisAppointment || showAppointmentBottomBorder),
          null,
          null,
          null,
          lineBorderColour,
          appointmentBorderStyle
        );

    });

    return;
  }

  const nameRange =
    calendar.getRange(
      startRow,
      workerCol,
      1,
      1
    );

  const hoursCell =
    calendar.getRange(
      startRow,
      workerCol + 1,
      1,
      2
    );

  card
    .getMergedRanges()
    .forEach(function(merged) {
      merged.breakApart();
    });

  card
    .clearContent()
    .setBackground(plannedFill)
    .setFontFamily('Montserrat')
    .setFontSize(12)
    .setFontWeight('normal')
    .setFontStyle('normal')
    .setFontLine('none')
    .setFontColor(plannedInk)
    .setHorizontalAlignment('left')
    .setVerticalAlignment('middle')
    .setWrap(false);

  nameRange
    .setValue(planned.worker)
    .setBackground(plannedFill)
    .setFontFamily('Montserrat')
    .setFontSize(12)
    .setFontWeight('bold')
    .setFontStyle('normal')
    .setFontLine('none')
    .setFontColor(plannedInk)
    .setHorizontalAlignment('left')
    .setVerticalAlignment('middle');

  GCAL4_mergeSafely_(hoursCell)
    .setValue(
      GCAL4_shiftTimeRangeLabel_(
        planned.startTimeText,
        planned.hours
      )
    )
    .setBackground(plannedFill)
    .setFontFamily('Montserrat')
    .setFontSize(8)
    .setFontWeight('bold')
    .setFontStyle('normal')
    .setFontLine('none')
    .setFontColor(plannedInk)
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle');

  calendar
    .getRange(startRow, workerCol, 1, 4)
    .setBorder(
      null,
      null,
      true,
      null,
      null,
      null,
      '#7899A1',
      SpreadsheetApp.BorderStyle.DOTTED
    );

  // Keep scheduled events on separate rows inside the support card.
  // Sort event objects before formatting so titles containing punctuation stay intact.
  const inCardAppointmentLines = (planned.inCardAppointments || [])
    .slice()
    .sort(function(a, b) {
      const aMinutes = a.startMinutes === null ||
        a.startMinutes === undefined ? 9999 : a.startMinutes;
      const bMinutes = b.startMinutes === null ||
        b.startMinutes === undefined ? 9999 : b.startMinutes;
      return aMinutes - bMinutes;
    })
    .map(function(appointment) {
      return GCAL4_inCardPlannedAppointmentLabel_([appointment]);
    })
    .filter(Boolean);

  if (inCardAppointmentLines.length) {
    // Leave the worker heading and any outside appointments in their own rows.
    const lastAppointmentRow = Math.min(
      startRow + cardHeight - 1,
      dateRow + 7 - outsideAppointmentCount
    );
    const availableRows = Math.max(0, lastAppointmentRow - startRow);
    const rowsNeeded = Math.min(inCardAppointmentLines.length, availableRows);
    const firstAppointmentRow = Math.max(
      startRow + 1,
      Math.min(
        startRow + Math.floor(cardHeight / 2),
        lastAppointmentRow - rowsNeeded + 1
      )
    );

    // If the fixed card is full, retain excess events as wrapped lines in the
    // final available row rather than dropping them or overwriting another card.
    for (let index = 0; index < rowsNeeded; index++) {
      const rowLines = index === rowsNeeded - 1
        ? inCardAppointmentLines.slice(index)
        : [inCardAppointmentLines[index]];
      const appointmentRow = firstAppointmentRow + index;
      const appointmentLine = calendar.getRange(
        appointmentRow,
        workerCol,
        1,
        3
      );

      GCAL4_unmergeForTarget_(appointmentLine);
      appointmentLine.clearContent();

      GCAL4_mergeSafely_(appointmentLine)
        .setValue(rowLines.join('\n'))
        .setBackground('#FFFFFF')
        .setFontFamily('Montserrat')
        .setFontSize(10)
        .setFontWeight('normal')
        .setFontStyle('normal')
        .setFontLine('none')
        .setFontColor('#A1C4C9')
        .setHorizontalAlignment('left')
        .setVerticalAlignment('middle')
        .setWrap(true)
        .setBorder(null, null, false, null, null, null);

      // Merged cells do not reliably auto-size when text wraps. Allow at least
      // two lines per event so the title and time remain visible at this width.
      const textLines = rowLines.reduce(function(total, text) {
        return total + Math.max(2, Math.ceil(text.length / 20));
      }, 0);
      calendar.setRowHeight(
        appointmentRow,
        Math.max(calendar.getRowHeight(appointmentRow), textLines * 18 + 4)
      );
    }
  }
}

function GCAL4_findShiftHeaderRow_(sheet) {

  const rowsToCheck =
    Math.min(
      10,
      Math.max(
        sheet.getLastRow(),
        1
      )
    );

  const values =
    sheet
      .getRange(
        1,
        1,
        rowsToCheck,
        sheet.getLastColumn()
      )
      .getDisplayValues();

  for (
    let i = 0;
    i < values.length;
    i++
  ) {

    if (
      values[i].some(
        function(value) {

          return (
            String(
              value || ''
            )
              .trim()
              .toLowerCase()
            ===
            'your name'
          );

        }
      )
    ) {

      return i + 1;
    }

  }

  return 1;
}

function GCAL4_shiftDetailHeader_(
  headers,
