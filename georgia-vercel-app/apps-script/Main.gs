      const result=differs?X7_raw_(fresh.id):fresh;
      if(result.status==='cancelled'||result.description!==resource.description||result.summary!==resource.summary||result.eventLabelId!==resource.eventLabelId||
         X7_boundary_(result.start)!==X7_boundary_(resource.start)||X7_boundary_(result.end)!==X7_boundary_(resource.end))throw new Error('Exact export verification failed at row '+item.row);
