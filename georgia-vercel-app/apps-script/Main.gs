    if(record.id!==raw.id||record.phase!=='active'||record.sourceHash!==S6_sourceHash_(item)||record.eventHash!==S6_eventHash_(raw)||record.error)report.syncWork.recordUpdates++;
    if(S6_eventHash_(raw)===S6_eventHash_(resource)){report.calendarPreview.matching++;return;}
