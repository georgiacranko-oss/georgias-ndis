function PROJECT_setupRetryTriggers_() {
  return ScriptApp.getProjectTriggers().filter(function(trigger) {
    return trigger.getEventType() === ScriptApp.EventType.CLOCK &&
      ['SETUP_ALL_NDIA_AUTOMATION', 'SETUP_NDIS_INVOICE_AUTOMATION'].includes(trigger.getHandlerFunction());
  });
}

function PROJECT_runSetup_(handler, work) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) {
    const pending = PROJECT_setupRetryTriggers_();
    const retryHandler = handler === 'SETUP_ALL_NDIA_AUTOMATION' ||
      pending.some(t => t.getHandlerFunction() === 'SETUP_ALL_NDIA_AUTOMATION')
      ? 'SETUP_ALL_NDIA_AUTOMATION' : 'SETUP_NDIS_INVOICE_AUTOMATION';
    pending.forEach(trigger => ScriptApp.deleteTrigger(trigger));
    ScriptApp.newTrigger(retryHandler).timeBased().after(60000).create();
    const message = 'Setup is queued because another process is using the workbook. It will retry automatically in about one minute. You do not need to run it again.';
    Logger.log(message);
    SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID).toast(message, 'Setup queued', 10);
    return message;
  }
  try {
    const message = work();
    PROJECT_setupRetryTriggers_().forEach(function(trigger) {
      if (handler === 'SETUP_ALL_NDIA_AUTOMATION' || trigger.getHandlerFunction() === handler) {
        ScriptApp.deleteTrigger(trigger);
      }
    });
    Logger.log(message);
    return message;
  } finally {
    lock.releaseLock();
  }
}

function PROJECT_installCalendarUpdateTrigger_() {
  let found = false;
  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (trigger.getHandlerFunction() !== 'CALENDAR_onUpdate') return;
    const valid = trigger.getEventType() === ScriptApp.EventType.ON_EVENT_UPDATED &&
      trigger.getTriggerSourceId() === CS4.calendarId;
    if (valid && !found) { found = true; return; }
    ScriptApp.deleteTrigger(trigger);
  });
  if (!found) ScriptApp.newTrigger('CALENDAR_onUpdate')
    .forUserCalendar(CS4.calendarId).onEventUpdated().create();
  PropertiesService.getScriptProperties().setProperty('S6_SHEET_AT', String(Date.now()));
}

function PROJECT_installTriggers_(ss) {
  ss = ss || SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID);
  INV_installPaidEditTrigger_(ss);
  const definitions = [
    {handler: 'PROJECT_onFormSubmit', type: ScriptApp.EventType.ON_FORM_SUBMIT, sheet: true},
    {handler: 'SC5_onChange', type: ScriptApp.EventType.ON_CHANGE, sheet: true},
    {handler: 'DAILY_NDIS_INVOICE_CHECK', type: ScriptApp.EventType.CLOCK, daily: true},
    {handler: 'CS4_POLL', type: ScriptApp.EventType.CLOCK, daily: true}
  ];
  const handlers = definitions.map(function(item) { return item.handler; });
  const retired = ['GCAL4_onCalendarShiftSubmit', 'GCAL4_onCalendarShiftEdit',
    'NDISPara_onFormSubmit', 'NDISPara_onShiftNotesEdit', 'onEmailAutoParagraphSubmit',
    'supportOverviewResizeOnEdit', 'OV_ON_EDIT', 'CALENDAR_AND_SUPPORT_REFRESH'];
  const found = {};
  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    const handler = trigger.getHandlerFunction();
    const type = trigger.getEventType();
    const local = type === ScriptApp.EventType.CLOCK || trigger.getTriggerSourceId() === ss.getId();
    if (!local) return;
    if (retired.indexOf(handler) !== -1 || /^(?:CALSYNC(?:\d+)?_|CS[123]_)/.test(handler)) {
      ScriptApp.deleteTrigger(trigger);
      return;
    }
    const index = handlers.indexOf(handler);
    if (index === -1) return;
    // Replace any old frequent poll with the daily check.
    if (handler === 'CS4_POLL') {
      ScriptApp.deleteTrigger(trigger);
      return;
    }
    const definition = definitions[index];
    if (type !== definition.type || found[handler]) {
      ScriptApp.deleteTrigger(trigger);
      return;
    }
    found[handler] = true;
  });
  definitions.forEach(function(definition) {
    if (found[definition.handler]) return;
    const builder = ScriptApp.newTrigger(definition.handler);
    if (definition.sheet) {
      const sheetBuilder = builder.forSpreadsheet(ss);
      if (definition.type === ScriptApp.EventType.ON_FORM_SUBMIT) sheetBuilder.onFormSubmit().create();
      else sheetBuilder.onChange().create();
    } else if (definition.daily) {
      builder.timeBased().atHour(PROJECT_DAILY_INVOICE_HOUR).nearMinute(definition.handler==='CS4_POLL'?15:0)
        .everyDays(1).inTimezone(PROJECT_TIME_ZONE).create();
    }
  });
}

