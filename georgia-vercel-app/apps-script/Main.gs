  const existing=S6_call_(()=>Calendar.Events.get(CS4.calendarId,id,{eventLabelVersion:1}));
  if(S6_hasDescriptionNotes_(existing.description))NOTES_backupText_('Google Calendar',id,existing.description);
  S6_preserveDescription_(resource,item,existing,record);
  if(S6_hasDescriptionNotes_(resource.description))NOTES_backupText_('Google Calendar',id,resource.description);
  const privateProps=existing.extendedProperties&&existing.extendedProperties.private||{};
  resource.extendedProperties.private=Object.assign({},privateProps,resource.extendedProperties.private);
  S6_applyNoteLabel_(resource,item,S6_resource_.labels);
