function INV_runInvoiceBatch_(hours, fresh, restart) {
  hours=hours===168?168:24;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(1000)) {
    const p=PropertiesService.getScriptProperties(),request=fresh?'INV_IMPORT_FRESH_REQUEST':'INV_IMPORT_REQUEST_'+hours;
    if(!p.getProperty(request))p.setProperty(request,String(Date.now()));
    INV_scheduleImportContinuation_(60000);
    return {candidates:0,imported:0,repaired:0,duplicates:0,errors:0,pending:true,queued:true};
  }
  try {
    if(fresh&&restart)INV_restartFreshImport_();
    const state = INV_loadImportState_(hours,fresh);
    if(state.paused)return {candidates:0,imported:0,repaired:0,duplicates:0,errors:0,pending:true,paused:true};
    state.stalls = (state.stalls || 0) + 1; INV_saveImportState_(state, false);
    PropertiesService.getScriptProperties().deleteProperty(fresh?'INV_IMPORT_FRESH_REQUEST':'INV_IMPORT_REQUEST_'+hours);
    if (state.stalls > 3) {
      state.paused = true; INV_saveImportState_(state, false);
      if (INV_hasPendingImports_()) INV_scheduleImportContinuation_(60000);
      else INV_importContinuationTriggers_().forEach(t => ScriptApp.deleteTrigger(t));
      throw new Error('Invoice import stopped after repeated runs without progress. The saved position is kept. Use the invoice button to retry.');
    }
    // A watchdog preserves automatic recovery even if Google ends this execution.
    INV_scheduleImportContinuation_(7 * 60000);
    const result = IMPORT_ALL_GMAIL_INVOICES_2026(hours,fresh);
    const ss = SpreadsheetApp.openById(INV_SPREADSHEET_ID);
    const claimSheet=ss.getSheetByName(INV_CLAIMS_SHEET);
    if(claimSheet.getLastRow()>1&&claimSheet.getRange(2,6,claimSheet.getLastRow()-1,1).getDisplayValues().some(r=>/^Invoice PDF [a-zA-Z0-9_-]{16}$/.test(String(r[0]||''))))INV_scheduleFilenameRepair_();
    INV_syncSheetAliases_(ss);
    INV_matchRawClaimsToInvoices_(ss);
    SpreadsheetApp.flush();
    INV_setupCurrentInvoiceQueues_(ss);
    SpreadsheetApp.flush();
    if (result.paused) {
      if(INV_hasPendingImports_())INV_scheduleImportContinuation_(60000);
      else INV_importContinuationTriggers_().forEach(t=>ScriptApp.deleteTrigger(t));
    } else if (result.pending) INV_scheduleImportContinuation_(60000);
    else {
      const props = PropertiesService.getScriptProperties();
      props.deleteProperty(state.stateKey);
      if (INV_hasPendingImports_()) INV_scheduleImportContinuation_(60000);
      else INV_importContinuationTriggers_().forEach(t => ScriptApp.deleteTrigger(t));
    }
    const message = 'Invoice batch. Imported ' + result.imported + '. Repaired ' + result.repaired +
      '. Existing ' + result.duplicates + '. Errors ' + result.errors +
      (result.paused ? '. Import paused after repeated errors. The failed attachment position is kept.' : result.pending ? '. More invoices will be checked automatically in about one minute.' : '. Invoice check complete.');
    Logger.log(message); ss.toast(message, 'Invoice import', 10);
    return result;
  } finally { lock.releaseLock(); }
}

