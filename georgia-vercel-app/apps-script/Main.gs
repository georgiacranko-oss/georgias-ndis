    });
    results.forEach(message=>Logger.log(message));return results.join('\n');
  }finally{lock.releaseLock();}
}

function CALDUP_queue_() {
  ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='CLEAN_CALENDAR_DUPLICATES').forEach(t=>ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('CLEAN_CALENDAR_DUPLICATES').timeBased().after(60000).create();
}
function CALDUP_pair_(keep,copy,labels) {
  const a=S6_event_(keep,labels),b=S6_event_(copy,labels);
  if(!a||!b||keep.status==='cancelled'||copy.status==='cancelled'||!CS4_sameSlot_(a,b)||S6_kind_(a.type)!==S6_kind_(b.type))return false;
  // Require a recognised project event. Unlabelled personal events are not candidates.
  if(!a.owned&&!labels.byId[keep.eventLabelId])return false;
  if(!b.owned&&!labels.byId[copy.eventLabelId])return false;
  if((copy.attendees||[]).length||(copy.attachments||[]).length||copy.location||copy.conferenceData)return false;
  return true;
}
function CALDUP_merge_(keep,copy,labels) {
  if(!CALDUP_pair_(keep,copy,labels))return null;
  const combined=S6_duplicateDescription_(keep.description,copy.description);
  if(S6_hasDescriptionNotes_(keep.description))NOTES_backupText_('Google Calendar',keep.id,keep.description);
  if(S6_hasDescriptionNotes_(copy.description))NOTES_backupText_('Google Calendar',copy.id,copy.description);
  if(combined!==String(keep.description||'')) {
    NOTES_backupText_('Google Calendar',keep.id,combined);
    const privateProps=Object.assign({},keep.extendedProperties&&keep.extendedProperties.private||{});
    privateProps.s6Hash=S6_eventHash_(Object.assign({},keep,{description:combined}));
    S6_call_(()=>Calendar.Events.patch({description:combined,extendedProperties:{private:privateProps}},CS4.calendarId,keep.id,{eventLabelVersion:1}));
  }
  // Confirm persisted notes before authorising deletion of the other occurrence.
  const verified=S6_call_(()=>Calendar.Events.get(CS4.calendarId,keep.id,{eventLabelVersion:1}));
  if(!CALDUP_pair_(verified,copy,labels)||S6_normal_(verified.description)!==S6_normal_(combined))throw new Error('Merged notes could not be verified. Duplicate kept.');
  return verified;
}
function CLEAN_CALENDAR_DUPLICATES() {
  if(PropertiesService.getScriptProperties().getProperty('CALENDAR_PAUSED')==='1')return 'Calendar automation is paused. Duplicate cleanup did not run.';
  if(PropertiesService.getScriptProperties().getProperty('S6_NOTE_REPAIR')||PropertiesService.getScriptProperties().getProperty('S6_NOTE_RESTORE_PENDING')){CALDUP_queue_();return 'Duplicate cleanup waits until note recovery finishes.';}
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1000)){CALDUP_queue_();return 'Duplicate cleanup is queued.';}
  try {
    const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID),labels=CS4_labels_(),registry=S6_registry_(ss),table=CS4_table_(ss);
    const report=ss.getSheetByName('Calendar Duplicate Check')||ss.insertSheet('Calendar Duplicate Check');
    report.getRange(1,1,1,6).setValues([['Checked at','Kept event ID','Duplicate event ID','Title','Shift date','Result']]);
    const log=(keep,copy,result)=>{const row=Math.max(2,report.getLastRow()+1);INV_ensureRowCapacity_(report,row);report.getRange(row,1,1,6).setValues([[new Date(),keep.id,copy.id,keep.summary||'',copy.start.date||copy.start.dateTime,result]]);};
    const groups={},records=Object.values(registry.records),changes=CS4_readChanges_(table);
    S6_events_(labels).forEach(e=>{if(e.owned||labels.byId[e.event.eventLabelId]){const key=CS4_signature_(e);(groups[key]||(groups[key]=[])).push(e);}});
    const started=Date.now();let removed=0,blocked=0,pending=false;
    for(const key of Object.keys(groups)) {
      const group=groups[key];if(group.length<2)continue;
      group.sort((a,b)=>Number(records.some(r=>r.id===b.id))-Number(records.some(r=>r.id===a.id))||Number(!!b.event.recurringEventId)-Number(!!a.event.recurringEventId)||a.id.localeCompare(b.id));
      let keeper=group[0].event;
      for(const duplicate of group.slice(1)) {
        if(removed>=12||Date.now()-started>150000){pending=true;break;}
        try {
          const freshKeep=S6_call_(()=>Calendar.Events.get(CS4.calendarId,keeper.id,{eventLabelVersion:1}));
          const freshCopy=S6_call_(()=>Calendar.Events.get(CS4.calendarId,duplicate.id,{eventLabelVersion:1}));
          const verified=CALDUP_merge_(freshKeep,freshCopy,labels);
          if(!verified){blocked++;log(freshKeep,freshCopy,'Kept. Different event or protected event details.');continue;}
          // Redirect saved identities before deletion so a later sync cannot restore the copy.
          records.filter(r=>r.id===duplicate.id||r.id===keeper.id).forEach(r=>{r.id=keeper.id;r.lastDescription=S6_duplicateDescription_(r.lastDescription,verified.description);r.eventHash=S6_eventHash_(verified);S6_save_(registry,r);});
          changes.filter(c=>c.id===duplicate.id).forEach(c=>CS4_set_(table,c.row,['Calendar Event ID'],keeper.id));
          SpreadsheetApp.flush();
          const finalCopy=S6_call_(()=>Calendar.Events.get(CS4.calendarId,duplicate.id,{eventLabelVersion:1}));
          if(!CALDUP_pair_(verified,finalCopy,labels)||S6_normal_(finalCopy.description)!==S6_normal_(freshCopy.description))throw new Error('Duplicate changed during cleanup. It was kept.');
          S6_call_(()=>Calendar.Events.remove(CS4.calendarId,duplicate.id));removed++;keeper=verified;log(keeper,finalCopy,'Removed. Notes preserved.');
        }catch(error){blocked++;log(keeper,duplicate.event,String(error));}
      }
      if(pending)break;
    }
    ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='CLEAN_CALENDAR_DUPLICATES').forEach(t=>ScriptApp.deleteTrigger(t));
    if(pending)CALDUP_queue_();
    const message='Duplicate events removed: '+removed+'. Kept for checking: '+blocked+'.'+(pending?' Cleanup continues automatically.':'')+' See Calendar Duplicate Check.';
    Logger.log(message);ss.toast(message,'Calendar duplicates',10);return message;
  }finally{lock.releaseLock();}
}

function CALWARN_triggers_() {
  return ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='CLEAR_CALENDAR_NOTE_WARNINGS');
}
function CALWARN_queue_(delay) {
  PropertiesService.getScriptProperties().setProperty('CALWARN_REQUESTED','1');
  CALWARN_triggers_().forEach(t=>ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('CLEAR_CALENDAR_NOTE_WARNINGS').timeBased().after(delay||60000).create();
}
function CALWARN_report_(ss, rows, reset) {
  const sheet=ss.getSheetByName('Calendar Warning Check')||ss.insertSheet('Calendar Warning Check');
  if(reset)sheet.clearContents();
  sheet.getRange(1,1,1,7).setValues([['Checked at','Event ID','Previous title','New title','Previous label','New label','Result']]);
  if(rows.length) {
    const row=Math.max(2,sheet.getLastRow()+1);INV_ensureRowCapacity_(sheet,row+rows.length-1);
    sheet.getRange(row,1,rows.length,7).setValues(rows).setWrap(true);
  }
}
function CLEAR_CALENDAR_NOTE_WARNINGS() {
  if(PropertiesService.getScriptProperties().getProperty('CALENDAR_PAUSED')==='1')return 'Calendar automation is paused.';
  if(PropertiesService.getScriptProperties().getProperty('S6_NOTE_REPAIR')||PropertiesService.getScriptProperties().getProperty('S6_NOTE_RESTORE_PENDING')){CALWARN_queue_(60000);return 'Warning cleanup waits until note recovery finishes.';}
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1000)){CALWARN_queue_();return 'Calendar warning cleanup is queued and will retry automatically.';}
  const props=PropertiesService.getScriptProperties(),key='CALWARN_PROGRESS_V1';
  try {
    const saved=props.getProperty(key),state=saved?JSON.parse(saved):{ids:[],index:0,next:'',listed:false,changed:0,checked:0,errors:0,attempts:0};
    state.attempts++;props.setProperty(key,JSON.stringify(state));
    if(state.attempts>3){CALWARN_triggers_().forEach(t=>ScriptApp.deleteTrigger(t));throw new Error('Warning cleanup stopped after repeated runs without progress. See Calendar Warning Check.');}
    CALWARN_queue_(7*60000);
    const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID),labels=CS4_labels_();
    CALWARN_report_(ss,[],!saved);
    const started=Date.now();let writes=0,done=false;
    while(Date.now()-started<180000&&writes<30) {
      if(state.index>=state.ids.length) {
        if(state.listed&&!state.next){done=true;break;}
        const request={singleEvents:true,showDeleted:false,maxResults:50,eventLabelVersion:1,
          timeMin:CS4_instant_(CS4.start,'00:00').toISOString(),timeMax:CS4_instant_(CS4.end,'00:00').toISOString()};
        if(state.next)request.pageToken=state.next;
        const page=S6_call_(()=>Calendar.Events.list(CS4.calendarId,request));
        const listed=page.items||[],candidates=listed.filter(e=>!!S6_clearMissingWarning_(e,labels));
        state.checked+=listed.length-candidates.length;
        state.ids=candidates.map(e=>e.id);state.index=0;state.next=page.nextPageToken||'';state.listed=true;
        props.setProperty(key,JSON.stringify(state));
        if(!state.ids.length&&!state.next){done=true;break;}
        if(!state.ids.length)continue;
      }
      const id=state.ids[state.index];
      try {
        const current=S6_call_(()=>Calendar.Events.get(CS4.calendarId,id,{eventLabelVersion:1}));
        const patch=S6_clearMissingWarning_(current,labels);
        if(patch) {
          // Change only the title, label and private sync hash. Description is never sent.
          S6_call_(()=>Calendar.Events.patch(patch,CS4.calendarId,id,{eventLabelVersion:1}));
          state.changed++;writes++;
          CALWARN_report_(ss,[[new Date(),id,current.summary||'',patch.summary,current.eventLabelId||'',patch.eventLabelId||'','Changed']],false);
        }
      }catch(error){state.errors++;CALWARN_report_(ss,[[new Date(),id,'','','','',String(error)]],false);}
      state.index++;state.checked++;state.attempts=0;props.setProperty(key,JSON.stringify(state));
    }
    if(done){props.deleteProperty(key);props.deleteProperty('CALWARN_REQUESTED');CALWARN_triggers_().forEach(t=>ScriptApp.deleteTrigger(t));}
    else CALWARN_queue_(60000);
    const message='Calendar note labels updated: '+state.changed+'. Events checked: '+state.checked+'. Errors: '+state.errors+'.'+
      (done?'':' Cleanup continues automatically.')+' See Calendar Warning Check.';
    Logger.log(message);ss.toast(message,'Calendar warnings',10);return message;
  }finally{lock.releaseLock();}
}

