function INV_supportFormulaForRow_(row) {
  return '=IF($A' + row + '="","",SWITCH(LOWER(TRIM($E' + row + ')),"movement 101","Physiotherapy","move beyond chatswood","Physiotherapy","angela mcmahon","Neurological physiotherapy","collab therapy","Occupational therapy",IF($C' + row + '="","",$C' + row + ')))';
}

function INV_goalFormulaForRow_(row) {
  return '=IF(OR($A' + row + '="",$D' + row + '=""),"",$D' + row + ')';
}

function INV_abnFormulaForRow_(row, invoiceUrl) {
  const pairs = Object.keys(INV_PROVIDER_ABNS).map(function(name) {
    return JSON.stringify(name) + ',' + JSON.stringify(INV_PROVIDER_ABNS[name]);
  }).join(',');
  const general = 'SWITCH(LOWER(TRIM($E' + row + ')),' + pairs + ',"")';
  const match = String(invoiceUrl || '').match(new RegExp('/d/([^/?]+)'));
  const fileId = match ? match[1] : '';
  const abn = INV_VERIFIED_INVOICE_ABNS[fileId];
  const value = abn
    ? 'IF(AND(LOWER(TRIM($E' + row + '))="movement 101",IFERROR(REGEXEXTRACT($K' + row + ',"/d/([^/?]+)"),"")=' + JSON.stringify(fileId) + '),' + JSON.stringify(abn) + ',' + general + ')'
    : general;
  return '=IF($A' + row + '="","",' + value + ')';
}

function INV_repairAllDerivedFormulaColumns_(claims) {
  const count = claims.getLastRow() - 1;
  if (count > 0) INV_writeDerivedClaimFormulas_(claims, 2, count, false);
}

function INV_applyDerivedClaimFormulas_(claims, startRow, rowCount) {
  return INV_writeDerivedClaimFormulas_(claims, startRow, rowCount, true);
}

function INV_writeDerivedClaimFormulas_(claims, startRow, rowCount, newRows) {
  if (!rowCount) return;
  const dates = claims.getRange(startRow, 1, rowCount, 1).getValues();
  const urls = claims.getRange(startRow, 11, rowCount, 1).getDisplayValues();
  const columns = [
    [12, r => '=IF(A' + r + '="","",IF(J' + r + '="Core used for CB","Core",IF(B' + r + '="Flexible Core","Core",B' + r + ')))'],
    [13, INV_effectiveStatusFormulaForRow_],
    [14, INV_effectiveClaimIdFormulaForRow_],
    [15, INV_effectiveClaimDateFormulaForRow_],
    [16, INV_supportFormulaForRow_],
    [17, INV_goalFormulaForRow_],
    [18, r => '=IF($A' + r + '="","",$E' + r + ')'],
    [19, (r, i) => INV_abnFormulaForRow_(r, urls[i][0])],
    [20, r => '=IF($A' + r + '="","",$A' + r + ')'],
    [21, r => '=IF($F' + r + '="","",IF($K' + r + '="",$F' + r + ',HYPERLINK($K' + r + ',$F' + r + ')))'],
    [22, r => '=IF($A' + r + '="","",$G' + r + ')'],
    [26, INV_workflowFormulaForRow_]
  ];
  if (newRows) {
    columns.push([9, r => '=IF($W' + r + '="","",$W' + r + ')']);
    columns.push([10, r => '=IF($X' + r + '="","",$X' + r + ')']);
  }
  columns.forEach(function(definition) {
    const formulas = dates.map((date, i) => [newRows || date[0] ? definition[1](startRow + i, i) : '']);
    claims.getRange(startRow, definition[0], rowCount, 1).setFormulas(formulas);
  });
  claims.getRange(startRow, 20, rowCount, 1).setNumberFormat('d mmm yyyy');
  claims.getRange(startRow, 22, rowCount, 1).setNumberFormat('$#,##0.00');
  // Only newly imported rows receive unchecked Paid boxes. Repairs preserve payment state.
  if (newRows) claims.getRange(startRow, 25, rowCount, 1).insertCheckboxes().setValue(false);
}

function INV_effectiveStatusFormulaForRow_(row) {
  const raw = INV_rawSheetRef_();
  return '=IF(A' + row + '="","",LET(' +
    'w,TO_TEXT(W' + row + '),' +
    'm,IFERROR(UNIQUE(FILTER(' + raw + '!$A$2:$A,' +
      raw + '!$D$2:$D>=INT(A' + row + '),' +
      raw + '!$D$2:$D<INT(A' + row + ')+1,' +
      raw + '!$F$2:$F=G' + row + ')),""),' +
    'id,IF(w<>"",w,IF(AND(COUNTA(m)=1,COUNTIFS($A$2:$A,A' + row + ',$G$2:$G,G' + row + ')=1),TO_TEXT(INDEX(m,1)),"")),' +
    's,IF(id="","",IFERROR(INDEX(FILTER(' + raw + '!$G$2:$G,' +
      'TO_TEXT(' + raw + '!$A$2:$A)=id),1),"")),' +
    'IF(s="",H' + row + ',IFS(' +
      'REGEXMATCH(LOWER(TO_TEXT(s)),"cancel"),"Cancelled",' +
      'REGEXMATCH(LOWER(TO_TEXT(s)),"reject"),"Rejected",' +
      'REGEXMATCH(LOWER(TO_TEXT(s)),"pending|paid"),"Claimed",' +
      'TRUE,H' + row + '))))';
}

function INV_effectiveClaimIdFormulaForRow_(row) {
  const raw = INV_rawSheetRef_();
  return '=IF(A' + row + '="","",LET(' +
    'w,TO_TEXT(W' + row + '),' +
    'm,IFERROR(UNIQUE(FILTER(' + raw + '!$A$2:$A,' +
      raw + '!$D$2:$D>=INT(A' + row + '),' +
      raw + '!$D$2:$D<INT(A' + row + ')+1,' +
      raw + '!$F$2:$F=G' + row + ')),""),' +
    'IF(w<>"",w,IF(AND(COUNTA(m)=1,COUNTIFS($A$2:$A,A' + row + ',$G$2:$G,G' + row + ')=1),TO_TEXT(INDEX(m,1)),I' + row + '))))';
}

function INV_effectiveClaimDateFormulaForRow_(row) {
  const raw = INV_rawSheetRef_();
  return '=IF(N' + row + '="","",IFERROR(INDEX(FILTER(' + raw + '!$B$2:$B,TO_TEXT(' + raw + '!$A$2:$A)=TO_TEXT(N' + row + ')),1),""))';
}

function INV_workflowFormulaForRow_(row) {
  const rawSheet = INV_rawSheetRef_();
  return '=IF(A' + row + '="","",LET(' +
    'h,H' + row + ',w,W' + row + ',y,Y' + row + ',' +
    'raw,IF(w="","",IFNA(INDEX(FILTER(' + rawSheet + '!$G$2:$G,TO_TEXT(' + rawSheet + '!$A$2:$A)=TO_TEXT(w)),1),"")),' +
    'IFS(' +
      'y=TRUE,"Paid",' +
      'h="Paid","Paid",' +
      'REGEXMATCH(LOWER(raw),"cancel"),"Cancelled",' +
      'REGEXMATCH(LOWER(raw),"reject"),"Rejected",' +
      'REGEXMATCH(LOWER(TO_TEXT(h)),"cancel"),"Cancelled",' +
      'REGEXMATCH(LOWER(TO_TEXT(h)),"reject"),"Rejected",' +
      'h="Needs Review","Needs Review",' +
      'h="To Be Paid","To Be Paid",' +
      'AND(h="To Be Claimed",LEN(w)>0),"To Be Paid",' +
      'AND(h="Claimed",REGEXMATCH(LOWER(raw),"paid")),"Paid",' +
      'LEN(w)>0,"To Be Paid",' +
      'h="To Be Claimed","To Be Claimed",' +
      'TRUE,h' +
    ')))';
}

function INV_ensureWorkflowFormulasForEditedRows_(claims, editedRange) {
  const firstColumn = editedRange.getColumn();
  const lastColumn = editedRange.getLastColumn();

  const relevant =
    (firstColumn <= 8 && lastColumn >= 8) ||
    (firstColumn <= 23 && lastColumn >= 23) ||
    (firstColumn <= 25 && lastColumn >= 25) ||
    (firstColumn <= 26 && lastColumn >= 26);

  if (!relevant) return;

  const firstRow = Math.max(2, editedRange.getRow());
  const lastRow = editedRange.getLastRow();

  for (let row = firstRow; row <= lastRow; row++) {
    if (!claims.getRange(row, 1).getValue()) continue;
    claims.getRange(row, 26).setFormula(INV_workflowFormulaForRow_(row));
  }
}

function INV_matchRawClaimsToInvoices_(ss) {
  const claims = ss.getSheetByName(INV_CLAIMS_SHEET);
  const raw = PROJECT_getSheetByAliases_(ss, PROJECT_RAW_NDIS_SHEET_ALIASES);

  if (!claims || !raw) return 0;

  const claimLastRow = claims.getLastRow();
  const rawLastRow = raw.getLastRow();

  if (claimLastRow < 2 || rawLastRow < 2) return 0;

  const claimValues = claims
    .getRange(2, 1, claimLastRow - 1, 26)
    .getValues();

  const rawValues = raw
    .getRange(2, 1, rawLastRow - 1, 7)
    .getValues();

  const timeZone = ss.getSpreadsheetTimeZone() || INV_TIME_ZONE;
  const assignedIds = {};
  const rawById = {};
  const candidatesByKey = {};

  claimValues.forEach(function(row) {
    const requestId = INV_idKey_(row[22]); // W
    if (requestId) assignedIds[requestId] = true;
  });

  rawValues.forEach(function(row, index) {
    const requestId = INV_idKey_(row[0]);       // A
    const supportDate = INV_matchDate_(row[3]); // D
    const amount = INV_matchAmount_(row[5]);    // F
    const status = String(row[6] || '').trim(); // G

    if (!requestId) return;

    rawById[requestId] = {
      requestId: requestId,
      status: status,
      rawRow: index + 2
    };

    if (assignedIds[requestId]) return;
    if (!supportDate || amount === null) return;

    const key = INV_matchKey_(supportDate, amount, timeZone);
    if (!candidatesByKey[key]) candidatesByKey[key] = {};

    candidatesByKey[key][requestId] = true;
  });

  const invoiceCounts = {};
  claimValues.forEach(function(row) {
    if (INV_idKey_(row[22]) || String(row[25] || row[7] || '').trim() !== 'To Be Claimed') return;
    const date = INV_matchDate_(row[0]), amount = INV_matchAmount_(row[6]);
    if (!date || amount === null) return;
    const key = INV_matchKey_(date, amount, timeZone);
    invoiceCounts[key] = (invoiceCounts[key] || 0) + 1;
  });
  let matched = 0;

  claimValues.forEach(function(row, index) {
    const workflowStatus = String(row[25] || '').trim(); // Z
    const legacyStatus = String(row[7] || '').trim();    // H
    const requestId = INV_idKey_(row[22]);               // W
    const invoiceDate = INV_matchDate_(row[0]);
    const amount = INV_matchAmount_(row[6]);
    const sheetRow = index + 2;

    const status = workflowStatus || legacyStatus;
    if (status !== 'To Be Claimed') return;

    if (requestId) {
      const rawItem = rawById[requestId];
      const rawStatus = String(rawItem ? rawItem.status : '').toLowerCase();

      if (/cancel/.test(rawStatus)) {
        claims.getRange(sheetRow, 8).setValue('Cancelled');
      } else if (/reject/.test(rawStatus)) {
        claims.getRange(sheetRow, 8).setValue('Rejected');
      } else {
        claims.getRange(sheetRow, 8).setValue('To Be Paid');
      }

      claims.getRange(sheetRow, 26).setFormula(
        INV_workflowFormulaForRow_(sheetRow)
      );

      matched++;
      return;
    }

    if (!invoiceDate || amount === null) return;

    const key = INV_matchKey_(invoiceDate, amount, timeZone);
    if (invoiceCounts[key] !== 1) {
      console.log('Invoice row ' + sheetRow + ': several invoices share this date and amount. Enter the correct Request ID manually.');
      return;
    }
    const candidates = Object.keys(candidatesByKey[key] || {})
      .map(function(id) { return rawById[id]; })
      .filter(function(item) { return item && !assignedIds[item.requestId]; });

    if (candidates.length !== 1) return;

    const item = candidates[0];
    const rawStatus = String(item.status || '').toLowerCase();

    claims.getRange(sheetRow, 23).setValue(item.requestId); // W Request ID

    if (/cancel/.test(rawStatus)) {
      claims.getRange(sheetRow, 8).setValue('Cancelled');
    } else if (/reject/.test(rawStatus)) {
      claims.getRange(sheetRow, 8).setValue('Rejected');
    } else {
      claims.getRange(sheetRow, 8).setValue('To Be Paid');
    }

    claims.getRange(sheetRow, 26).setFormula(
      INV_workflowFormulaForRow_(sheetRow)
    );

    assignedIds[item.requestId] = true;
    matched++;
  });

  if (matched) SpreadsheetApp.flush();
  return matched;
}

function INV_matchDate_(value) {
  if (value instanceof Date && !isNaN(value.getTime())) return value;
  if (value === null || value === undefined || value === '') return null;

  const text = String(value).trim();
  if (!text) return null;

  let match = text.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})$/);
  if (match) {
    return INV_parseAustralianDate_(text);
  }

  const parsed = new Date(text);
  return isNaN(parsed.getTime()) ? null : parsed;
}

function INV_matchAmount_(value) {
  if (typeof value === 'number') {
    return isFinite(value) ? value : null;
  }

  const cleaned = String(value || '')
    .replace(/\$/g, '')
    .replace(/,/g, '')
    .replace(/\s+/g, '')
    .trim();

  if (!cleaned) return null;

  const amount = Number(cleaned);
  return isFinite(amount) ? amount : null;
}

function INV_matchKey_(date, amount, timeZone) {
  return Utilities.formatDate(date, timeZone, 'yyyy-MM-dd') + '|' +
    Number(amount).toFixed(2);
}

function INV_idKey_(value) {
  if (value === null || value === undefined || value === '') return '';

  if (typeof value === 'number' && isFinite(value)) {
    return String(Math.trunc(value));
  }

  return String(value).trim().replace(/\.0$/, '');
}

const EMAIL_NOTE_QUESTION = 'Email for a copy of the generated note.';

function onEmailAutoParagraphSubmit(e) {
  const sheet = e && e.range ? e.range.getSheet() : null;
  if (!sheet || sheet.getName() !== 'Shift Notes') return;

  const row = e.range.getRow();
  const headers = sheet
    .getRange(1, 1, 1, Math.max(sheet.getLastColumn(), 1))
    .getDisplayValues()[0];

  const emailColumn = EMAIL_findHeaderColumn_(headers, [
    EMAIL_NOTE_QUESTION
  ]);

  const paragraphColumn = EMAIL_findHeaderColumn_(headers, [
    'Generated Paragraph',
    'Auto support paragraph',
    'Generated note',
    'Auto paragraph'
  ]);

  const dateColumn = EMAIL_findHeaderColumn_(headers, [
    'Date support was provided'
  ]);

  if (!emailColumn || !paragraphColumn) return;

  const email = String(
    sheet.getRange(row, emailColumn).getDisplayValue() || ''
  ).trim();

  if (!email) return;

  let paragraph = String(
    sheet.getRange(row, paragraphColumn).getDisplayValue() || ''
  ).trim();

  if (!paragraph && typeof NDISPara_generateRow_ === 'function') {
    NDISPara_generateRow_(sheet, row);
    SpreadsheetApp.flush();
    paragraph = String(
      sheet.getRange(row, paragraphColumn).getDisplayValue() || ''
    ).trim();
  }

  if (!paragraph) {
    throw new Error('The generated paragraph was not ready for emailing.');
  }

  const dateText = dateColumn
    ? String(sheet.getRange(row, dateColumn).getDisplayValue() || '').trim()
    : '';

  return EMAIL_sendOnce_('copy',sheet,row,{
    to: email,
    subject: dateText
      ? 'Georgia support note, ' + dateText
      : 'Georgia support note',
    body: paragraph
  });
}

function HANDOVER_hasConsent_(value) {
  return value===true||/^(?:yes|yah|true|send|yes please)[.!]?$/i.test(String(value||'').trim());
}
function EMAIL_sendOnce_(kind,sheet,row,payload) {
  payload = SUPPORT_APP_addHandoverComment_(kind,sheet,row,payload);
  const lock=LockService.getUserLock();
  if(!lock.tryLock(1000))throw new Error('Another email is being processed. No duplicate email was sent.');
  try {
    const p=PropertiesService.getScriptProperties();
    const stamp=String(sheet.getRange(row,1).getValue()||'');
    const key='NDIA_EMAIL_'+CS4_digest_([kind,sheet.getParent().getId(),sheet.getSheetId(),row,stamp].join('|'));
    const previous=p.getProperty(key);
    if(previous){Logger.log('Email already sent or awaiting delivery verification. Duplicate skipped.');return false;}
    // Persist before sending. An ambiguous failure must not automatically send twice.
    p.setProperty(key,JSON.stringify({state:'sending',at:Date.now()}));
    try {MailApp.sendEmail(payload);p.setProperty(key,JSON.stringify({state:'sent',at:Date.now()}));return true;}
    catch(error){p.setProperty(key,JSON.stringify({state:'check_delivery',at:Date.now()}));throw error;}
  }finally{lock.releaseLock();}
}

function EMAIL_findHeaderColumn_(headers, titles) {
  const normal = headers.map(function(value) {
    return PROJECT_normalise_(value);
  });

  for (let i = 0; i < titles.length; i++) {
    const wanted = PROJECT_normalise_(titles[i]);
    const index = normal.indexOf(wanted);
    if (index !== -1) return index + 1;
  }

  return 0;
}

function resizeOverviewRows(ss) {
  const sheet = PROJECT_getOverviewSheet_(
    ss || SpreadsheetApp.getActiveSpreadsheet() || SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID)
  );

  if (!sheet) return;

  const titleFinder = sheet
    .createTextFinder('Things\\s+Worth\\s+Noting|Worth\\s+Noting')
    .useRegularExpression(true)
    .matchCase(false)
    .findNext();

  const noteRow = titleFinder
    ? titleFinder.getRow() + 2
    : null;

  const noteColumn = titleFinder
    ? titleFinder.getColumn()
    : null;

  sheet.setRowHeight(13, 55);

  if (noteRow) {
    sheet.setRowHeight(noteRow, 45);
  }

  SpreadsheetApp.flush();
  Utilities.sleep(1000);
  SpreadsheetApp.flush();

  const row13Height = Math.max(
    calculateOverviewHeight(sheet, 'G13'),
    calculateOverviewHeight(sheet, 'Q13'),
    calculateOverviewHeight(sheet, 'AA13')
  );

  sheet.setRowHeight(
    13,
    Math.max(55, row13Height)
  );

  if (noteRow) {
    const noteCell =
      sheet.getRange(noteRow, noteColumn);

    const noteHeight =
      calculateOverviewHeightFromCell(
        sheet,
        noteCell
      );

    sheet.setRowHeight(
      noteRow,
      Math.max(45, noteHeight)
    );
  }
}

function calculateOverviewHeight(sheet, a1) {
  return calculateOverviewHeightFromCell(
    sheet,
    sheet.getRange(a1)
  );
}

function calculateOverviewHeightFromCell(
  sheet,
  cell
) {
  const text =
    String(cell.getDisplayValue() || '');

  if (!text.trim()) {
    return 40;
  }

  const merges =
    cell.getMergedRanges();

  const block =
    merges.length
      ? merges[0]
      : cell;

  let widthPx = 0;

  for (
    let col = block.getColumn();
    col <
      block.getColumn() +
      block.getNumColumns();
    col++
  ) {
    widthPx +=
      sheet.getColumnWidth(col);
  }

  const fontSize =
    cell.getFontSize() || 14;

  widthPx =
    Math.max(50, widthPx - 16);

  const charsPerLine =
    Math.max(
      8,
      Math.floor(
        widthPx /
        (fontSize * 0.55)
      )
    );

  let totalLines = 0;

  text.split('\n').forEach(line => {

    if (line.trim() === '') {
      totalLines++;
      return;
    }

    totalLines += countWrappedLines(
      line,
      charsPerLine
    );
  });

  const lineHeight =
    fontSize * 1.27;

  return Math.ceil(
    totalLines * lineHeight + 6
  );
}

function countWrappedLines(
  text,
  maxChars
) {
  const words =
    text.trim().split(/\s+/);

  let lines = 1;
  let current = 0;

  words.forEach(word => {

    const required =
      word.length +
      (current > 0 ? 1 : 0);

    if (
      current + required >
      maxChars
    ) {
      lines++;
      current = word.length;
    } else {
      current += required;
    }
  });

  return lines;
}

