function RESTORE_SAVED_NOTE_PARAGRAPHS() {
  const props=PropertiesService.getScriptProperties();
  if(props.getProperty('CALENDAR_PAUSED')!=='1')throw new Error('Pause the broad calendar sync before note recovery.');
  const lock=LockService.getScriptLock();if(!lock.tryLock(1000))throw new Error('Another workbook job is running.');
  try {
    const ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID),registry=S6_registry_(ss),labels=CS4_labels_();
    const groups=S6_noteRepairGroups_(registry,{records:[]},[]).filter(g=>CS4_supportKind_(g.model.type)&&g.model.day>=CS4.start&&g.model.day<='2026-10-11');
    const events=S6_events_(labels),key='EXACT_NOTE_RECOVERY_V2';
    let state=JSON.parse(props.getProperty(key)||'{"index":0,"restored":0,"verified":0,"unmatched":[]}');
    if(state.index>=groups.length)state={index:0,restored:0,verified:0,unmatched:[]};
    const started=Date.now();let checked=0;
    while(state.index<groups.length&&checked<25&&Date.now()-started<150000) {
      const group=groups[state.index],match=S6_noteRepairMatch_(group,events);
      if(!match) {state.unmatched.push(group.model.day+' '+group.model.person);state.index++;checked++;continue;}
      const current=X7_raw_(match.id),fresh=current&&S6_event_(current,labels);
      if(!fresh||current.status==='cancelled'||fresh.day!==group.model.day||CS4_name_(fresh.person)!==CS4_name_(group.model.person))throw new Error('Recovery identity changed.');
      const description=X7_originalText_(current.description,group.text),summary=group.model.person;
      const needs=current.description!==description||current.summary!==summary||current.eventLabelId!==labels.byType.Regular;
      if(needs) {
        NOTES_backupText_('Exact paragraph recovery',current.id,description);
        const next=Object.assign({},current,{summary:summary,description:description,eventLabelId:labels.byType.Regular});
        const previous=current.extendedProperties&&current.extendedProperties.private||{};
        S6_call_(()=>Calendar.Events.patch({summary:summary,description:description,eventLabelId:labels.byType.Regular,
          extendedProperties:{private:Object.assign({},previous,{s6Hash:S6_eventHash_(next)})}},CS4.calendarId,current.id,{eventLabelVersion:1,sendUpdates:'none'}));
      }
      const result=needs?X7_raw_(current.id):current;
      if(result.description!==description||result.summary!==summary||result.eventLabelId!==labels.byType.Regular||
        X7_boundary_(current.start)!==X7_boundary_(result.start)||X7_boundary_(current.end)!==X7_boundary_(result.end))throw new Error('Exact paragraph or unchanged time verification failed.');
      state.verified++;if(needs)state.restored++;state.index++;checked++;props.setProperty(key,JSON.stringify(state));
    }
    const report={checked:state.index,total:groups.length,restored:state.restored,verified:state.verified,unmatched:state.unmatched,complete:state.index>=groups.length};
    Logger.log(JSON.stringify(report));return report;
  } finally {lock.releaseLock();}
}


