    [/^communicate clearly/i,['communicate and be understood with less effort']],
    [/^maintain physical safety/i,['manage self care more safely']],
    [/^manage domestic tasks/i,['manage domestic tasks and mealtimes with less physical strain']],
    [/^preserve energy/i,['conserve energy for work and creative activities']],
    [/^maintain relationships/i,['maintain relationships and social connection']],
    [/^attend appointments/i,['access appointments and participate in professional and social activities']],
    [/^maintain autonomy/i,['retain control over decisions and have their choices and boundaries respected']]
  ];
  const effects=[],extra=[];choices.forEach(item=>{const match=mapping.find(x=>x[0].test(item));if(match)effects.push(...match[1]);else if(!/^other$/i.test(item))extra.push(item);});
  const wording={
    'communicate and be understood with less effort':['communicate and be understood with less effort','express themselves and be understood without as much effort','use less effort to communicate and get their meaning across'],
    'manage self care more safely':['manage self care more safely','attend to self care with greater safety','carry out self care more safely'],
    'manage domestic tasks and mealtimes with less physical strain':['manage domestic tasks and mealtimes with less physical strain','reduce the physical strain of household tasks and mealtimes','get through domestic tasks and mealtimes with less strain on their body'],
    'conserve energy for work and creative activities':['conserve energy for work and creative activities','save energy for work and creative activities','keep more energy available for work and creative activities'],
    'maintain relationships and social connection':['maintain relationships and social connection','stay connected with others and maintain relationships','keep up relationships and social connections'],
    'access appointments and participate in professional and social activities':['access appointments and participate in professional and social activities','take part in appointments and professional and social activities'],
    'retain control over decisions and have their choices and boundaries respected':['retain control over decisions and have their choices and boundaries respected','make their own decisions while having their choices and boundaries respected']
  };
  const varied=effects.map(effect=>NDISPara_variant_(wording[effect]||[effect],seed,effect));
  const sentences=[NDISPara_groups_(varied,[
    'With this support, Georgia was able to {items}.','My assistance helped Georgia {items}.',
    'Having support meant Georgia could {items}.','This help made it possible for Georgia to {items}.',
    'As a result of the assistance, Georgia could {items}.','The support helped Georgia {items}.'
  ],['It also helped Georgia {items}.','The assistance also enabled Georgia to {items}.'],seed)];
  extra.forEach((item,index)=>sentences.push(NDISPara_freeText_(item,seed,'outcome '+index,source)));
  return sentences.filter(Boolean).join(' ');
}
