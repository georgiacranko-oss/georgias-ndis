function S6_noteRepairMatch_(group,events) {
  const model=group.model;
  const candidates=events.filter(e=>e.day===model.day&&CS4_name_(e.person)===CS4_name_(model.person)&&S6_kind_(e.type)===S6_kind_(model.type));
  if(candidates.length===1)return candidates[0];
  if(!candidates.length)return null;
  // Several historical engines may have made copies of the same starting shift.
  // Prefer the occurrence that already contains notes, then its recurring instance.
  const starts=Array.from(new Set(candidates.map(e=>e.allDay?'all-day':e.start.toISOString())));
  if(starts.length!==1)return null;
  candidates.sort((a,b)=>Number(S6_hasDescriptionNotes_(b.note))-Number(S6_hasDescriptionNotes_(a.note))||
    Number(!!b.event.recurringEventId)-Number(!!a.event.recurringEventId)||a.id.localeCompare(b.id));
  return candidates[0];
}
