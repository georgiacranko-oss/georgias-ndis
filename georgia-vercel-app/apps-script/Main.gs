  const report = Object.keys(names)
    .sort()
    .map(function(key) {
      return {
        name: names[key],
        email: HANDOVER_EMAIL_BY_NAME[key] || 'MISSING'
      };
    });

  console.log(JSON.stringify(report, null, 2));
  return report;
}

