    String(a.description||'')===String(b.description||'')&&String(a.eventLabelId||'')===String(b.eventLabelId||'')&&
    X7_boundary_(a.start)===X7_boundary_(b.start)&&X7_boundary_(a.end)===X7_boundary_(b.end);
}
function X7_boundary_(value) { return value && (value.date || new Date(value.dateTime).toISOString()) || ''; }
function X7_raw_(id) {
