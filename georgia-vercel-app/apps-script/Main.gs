function SC_personKey_(name) {
  const key = String(name || '').trim().toLowerCase().replace(/\s+/g, ' ');
  return key === 'elana' ? 'ela' : key === 'craig' || key === 'mr pea' ? 'mr pea' : key;
}

function SC_regularMatch_(ss, date, person) {
  const key = GCAL4_shiftDateKey_(date);
  if (!ss || !key || !person) return null;
  const parts = key.split('-').map(Number);
  const weekday = new Date(parts[0], parts[1] - 1, parts[2]).getDay() || 7;
  const roster = GCAL4_getRegularRoster_(ss.getSheetByName('Regular Shifts'));
  const matches = (roster[weekday] || []).filter(function(item) {
    return SC_personKey_(item.worker) === SC_personKey_(person);
  });
  return matches.length === 1 ? matches[0] : null;
}





