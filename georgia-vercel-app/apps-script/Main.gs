function REPAIR_ALL_CALENDAR_NOTES() {
  const p=PropertiesService.getScriptProperties(),stateKey='S6_NOTE_REPAIR';
  let state;try{state=JSON.parse(p.getProperty(stateKey)||'null');}catch(error){state=null;}
  if(!state){state={index:0,restored:0,current:0,unmatched:0,errors:0};p.setProperty(stateKey,JSON.stringify(state));}
  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1000))return 'All-note repair is queued. Existing notes are kept.';
  try {
    state=JSON.parse(p.getProperty(stateKey))||state;
    const started=Date.now(),ss=SpreadsheetApp.openById(PROJECT_SPREADSHEET_ID),registry=S6_registry_(ss),labels=CS4_labels_();
    const notes=S6_notes_(ss),changes=CS4_readChanges_(CS4_table_(ss)),groups=S6_noteRepairGroups_(registry,notes,changes),events=S6_events_(labels);
    let report=ss.getSheetByName('Note Recovery Check');
    try {
      if(!report)report=ss.insertSheet('Note Recovery Check');
      if(state.index===0)report.clearContents();
      report.getRange(1,1,1,5).setValues([['Checked at','Date','Person or event','Result','Event ID']]);
    }catch(error){report=null;Logger.log('Recovery report unavailable. Calendar note recovery continues.');}
    let checked=0;
    while(state.index<groups.length&&checked<20&&Date.now()-started<120000) {
      const group=groups[state.index];let outcome='',id='';
      try {
        NOTES_backupText_('Saved calendar notes',group.key,group.text);
        const match=S6_noteRepairMatch_(group,events);
        if(!match){state.unmatched++;outcome='Saved notes kept. No unique existing event match.';}
        else {
          id=match.id;
          const current=S6_call_(()=>Calendar.Events.get(CS4.calendarId,id,{eventLabelVersion:1}));
          const fresh=S6_event_(current,labels);
          if(current.status==='cancelled'||!fresh||fresh.day!==group.model.day||CS4_name_(fresh.person)!==CS4_name_(group.model.person))throw new Error('Event changed during repair. Saved notes are kept.');
          const description=S6_duplicateDescription_(current.description,group.text);
          if(S6_normal_(description)===S6_normal_(current.description)){state.current++;outcome='All saved notes already present.';}
          else {
            NOTES_backupText_('Google Calendar',id,current.description||'');
            NOTES_backupText_('Google Calendar',id,description);
            const warning=S6_clearMissingWarning_(Object.assign({},current,{description:description}),labels)||{};
            const next=Object.assign({},current,warning,{description:description});
            const oldPrivate=current.extendedProperties&&current.extendedProperties.private||{};
            const patch=Object.assign({},warning,{description:description,extendedProperties:{private:Object.assign({},oldPrivate,{s6Hash:S6_eventHash_(next)})}});
            S6_call_(()=>Calendar.Events.patch(patch,CS4.calendarId,id,{eventLabelVersion:1}));
            const verified=S6_call_(()=>Calendar.Events.get(CS4.calendarId,id,{eventLabelVersion:1}));
            if(!S6_normal_(verified.description).includes(S6_normal_(group.text))||
               S6_hasDescriptionNotes_(current.description)&&!S6_normal_(verified.description).includes(S6_normal_(current.description)))throw new Error('Note recovery verification failed. Backup is kept.');
            state.restored++;outcome='All saved notes restored and verified.';
          }
          // Keep each historical record's notes. Sync matching can reuse this survivor.
          group.records.forEach(function(record){
            if(S6_normal_(record.lastDescription)!==S6_normal_(description)) {
              record.lastDescription=description;S6_save_(registry,record);
            }
          });
        }
      }catch(error){state.errors++;outcome=String(error);}
      if(report)try{report.getRange(report.getLastRow()+1,1,1,5).setValues([[new Date(),group.model.day,group.model.person,outcome,id]]);}catch(error){report=null;}
      Logger.log(group.model.day+' '+group.model.person+': '+outcome);
      if(!id){state.unmatchedEntries=state.unmatchedEntries||[];state.unmatchedEntries.push(group.model.day+' '+group.model.person);}
      state.index++;checked++;p.setProperty(stateKey,JSON.stringify(state));
    }
    const done=state.index>=groups.length;
    if(done){p.setProperty('S6_NOTE_REPAIR_RESULT',JSON.stringify(state));p.deleteProperty(stateKey);p.setProperty('S6_VIEW_PENDING',String(Date.now()));p.deleteProperty('CALWARN_PROGRESS_V1');CALWARN_queue_(60000);}
    const message='Note recovery: '+state.restored+' events restored, '+state.current+' already complete, '+state.unmatched+' without a unique event, '+state.errors+' errors. '+
      (done?'Finished.':'Remaining entries continue automatically.')+' See Note Recovery Check.';
    Logger.log(message);return message;
  }finally{lock.releaseLock();}
}

function S6_loadSavedEvents_(items,events,registry,labels,started) {
  const listed={},checked={},deferred={};let lookups=0;
  events.forEach(e=>listed[e.id]=true);
  items.forEach(function(item) {
    const record=registry.records[item.key],id=item.id||(record&&record.id);
    if(!id||listed[id]||checked[id])return;
    if(lookups>=20||Date.now()-started>45000){deferred[item.key]=true;return;}
    lookups++;checked[id]=true;
    let raw;try{raw=S6_call_(()=>Calendar.Events.get(CS4.calendarId,id,{eventLabelVersion:1}));}
    catch(error){if(CS4_notFound_(error))return;throw error;}
    if(raw.status!=='cancelled'){const event=S6_event_(raw,labels);if(event){events.push(event);listed[id]=true;}}
  });
  return deferred;
}

